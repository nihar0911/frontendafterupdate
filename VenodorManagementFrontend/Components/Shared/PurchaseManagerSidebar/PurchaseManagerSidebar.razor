@inject NavigationManager Nav
@inject AuthService Auth

<aside class="pm-sidebar @(IsSidebarCollapsed ? "collapsed" : "")">
    <div class="sidebar-header">
        <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
            <div class="brand-emblem">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <div class="brand-text">
                <span class="brand-name">PROCUREMENT</span>
                <span class="brand-sub">MANAGEMENT</span>
            </div>
        </div>
        <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                @if (IsSidebarCollapsed)
                {
                    <polyline points="13 17 18 12 13 7"></polyline>
                    <polyline points="6 17 11 12 6 7"></polyline>
                }
                else
                {
                    <polyline points="11 17 6 12 11 7"></polyline>
                    <polyline points="18 17 13 12 18 7"></polyline>
                }
            </svg>
        </button>
    </div>

    <nav class="sidebar-nav">
        <!-- MAIN -->
        <div class="nav-section-title">MAIN</div>
        <ul class="nav-list">
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "dashboard" ? "active" : "")" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </span>
                    <span class="nav-label">Dashboard</span>
                </button>
            </li>
        </ul>

        <!-- PROCUREMENT -->
        <div class="nav-section-title">PROCUREMENT</div>
        <ul class="nav-list">
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "requests" ? "active" : "")" @onclick='() => Nav.NavigateTo("/procurement")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                    </span>
                    <span class="nav-label">Purchase Requests</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "quotations" ? "active" : "")" @onclick='() => Nav.NavigateTo("/quotations")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </span>
                    <span class="nav-label">Vendor Quotations</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "orders" ? "active" : "")" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                    </span>
                    <span class="nav-label">Purchase Orders</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "deliveries" ? "active" : "")" @onclick='() => Nav.NavigateTo("/organization/purchase-orders?view=deliveries")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                    </span>
                    <span class="nav-label">Deliveries</span>
                </button>
            </li>
        </ul>

        <!-- FINANCE -->
        <div class="nav-section-title">FINANCE</div>
        <ul class="nav-list">
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "invoices" ? "active" : "")" @onclick='() => Nav.NavigateTo("/organization/invoices")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </span>
                    <span class="nav-label">Invoices &amp; Billing</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "payments" ? "active" : "")" @onclick='() => Nav.NavigateTo("/organization/payments")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                    </span>
                    <span class="nav-label">Payments &amp; Settlements</span>
                </button>
            </li>
        </ul>

        <!-- CONFIGURATION -->
        <div class="nav-section-title">CONFIGURATION</div>
        <ul class="nav-list">
            <li class="nav-item">
                <button class="sidebar-nav-link @(ActivePage == "settings" ? "active" : "")" @onclick='() => Nav.NavigateTo("/purchase-manager/recommendation-settings")'>
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </span>
                    <span class="nav-label">Recommendation Settings</span>
                </button>
            </li>
        </ul>

        <!-- ACCOUNT -->
        <div class="nav-section-account">
            <div class="nav-section-title">ACCOUNT</div>
            <ul class="nav-list">
                <li class="nav-item">
                    <button class="sidebar-nav-link" @onclick="HandleProfile">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <span class="nav-label">My Profile</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="sidebar-nav-link" @onclick="HandleLogout">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                        </span>
                        <span class="nav-label">Logout</span>
                    </button>
                </li>
            </ul>
        </div>
    </nav>
</aside>

@code {
    [Parameter] public string ActivePage { get; set; } = "";
    [Parameter] public bool IsSidebarCollapsed { get; set; } = false;
    [Parameter] public EventCallback<bool> OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnOpenProfile { get; set; }

    private async Task ToggleSidebar()
    {
        IsSidebarCollapsed = !IsSidebarCollapsed;
        if (OnToggleSidebar.HasDelegate)
        {
            await OnToggleSidebar.InvokeAsync(IsSidebarCollapsed);
        }
    }

    private async Task HandleProfile()
    {
        if (OnOpenProfile.HasDelegate)
        {
            await OnOpenProfile.InvokeAsync();
        }
        else
        {
            Nav.NavigateTo("/purchase-manager");
        }
    }

    private void HandleLogout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login", true);
    }
}
