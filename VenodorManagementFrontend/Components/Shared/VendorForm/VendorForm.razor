@rendermode InteractiveServer

<div class="card @(EditingVendor == null ? "border-info" : "border-primary") shadow mb-4 bg-white">
    <div class="card-header @(EditingVendor == null ? "bg-info text-white" : "bg-primary text-white") py-3">
        <h5 class="fw-bold mb-0">
            @(EditingVendor == null ? "+ Add New Vendor" : $"Edit Vendor: {EditingVendor.VendorName}")
        </h5>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label small fw-bold">Vendor Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" @bind="VendorName" placeholder="e.g. ABC Fresh Suppliers" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Email</label>
                <input type="email" class="form-control" @bind="Email" placeholder="vendor@suppliers.com" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Phone</label>
                <input type="text" class="form-control" @bind="Phone" placeholder="e.g. 9876543210" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">GSTIN</label>
                <input type="text" class="form-control" @bind="GSTIN" placeholder="e.g. 30AAAAA0000A1Z5" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Address</label>
                <input type="text" class="form-control" @bind="Address" placeholder="e.g. Panaji, Goa" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Latitude</label>
                <input type="number" step="0.000001" class="form-control" @bind="Latitude" placeholder="15.2832" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Longitude</label>
                <input type="number" step="0.000001" class="form-control" @bind="Longitude" placeholder="73.9862" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Status <span class="text-danger">*</span></label>
                <select class="form-select" @bind="Status" disabled="@IsSubmitting">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ValidationMessage))
        {
            <div class="alert alert-warning py-2 small mb-3">
                @ValidationMessage
            </div>
        }

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary fw-bold px-4" @onclick="HandleCancel" disabled="@IsSubmitting">
                Cancel
            </button>
            <button type="button" class="btn @(EditingVendor == null ? "btn-info text-white fw-bold" : "btn-primary fw-bold") px-4 shadow-sm" @onclick="HandleSubmit" disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>@(EditingVendor == null ? "Creating Vendor..." : "Saving Changes...")</span>
                }
                else
                {
                    <span>@(EditingVendor == null ? "Create Vendor" : "Save Changes")</span>
                }
            </button>
        </div>
    </div>
</div>
