@rendermode InteractiveServer

<div class="card @(EditingOutlet == null ? "border-warning" : "border-info") shadow mb-4 bg-white">
    <div class="card-header @(EditingOutlet == null ? "bg-warning text-dark" : "bg-info text-white") py-3">
        <h5 class="fw-bold mb-0">
            @(EditingOutlet == null ? "+ Add New Outlet" : $"Edit Outlet: {(string.IsNullOrWhiteSpace(EditingOutlet.OutletName) ? "Outlet Branch" : EditingOutlet.OutletName)}")
        </h5>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label small fw-bold">Outlet Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" @bind="OutletName" placeholder="e.g. Vasco Outlet" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Organization <span class="text-danger">*</span></label>
                <select class="form-select" @bind="SelectedOrgId" disabled="@IsSubmitting">
                    @if (Organizations == null || Organizations.Count == 0)
                    {
                        <option value="0">-- No Organizations Available --</option>
                    }
                    else
                    {
                        @foreach (var org in Organizations)
                        {
                            <option value="@org.OrganizationID">@org.OrganizationName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Address</label>
                <input type="text" class="form-control" @bind="Address" placeholder="e.g. Panaji, Goa" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Latitude</label>
                <input type="number" step="0.000001" class="form-control" @bind="Latitude" placeholder="15.2832" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Longitude</label>
                <input type="number" step="0.000001" class="form-control" @bind="Longitude" placeholder="73.9862" disabled="@IsSubmitting" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Purchase order approval</label>
                <select class="form-select" @bind="PurchaseOrderApproverRole" disabled="@IsSubmitting">
                    <option value="Organization Manager">Organization Manager</option>
                    <option value="Outlet Manager">Outlet Manager</option>
                </select>
                <small class="text-muted">Who must approve purchase orders for this outlet before they are placed with the vendor.</small>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ValidationMessage))
        {
            <div class="alert alert-warning py-2 small mb-3">
                @ValidationMessage
            </div>
        }

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary fw-bold px-4" @onclick="HandleCancel" disabled="@IsSubmitting">
                Cancel
            </button>
            <button type="button" class="btn @(EditingOutlet == null ? "btn-warning fw-bold text-dark" : "btn-info text-white fw-bold") px-4 shadow-sm" @onclick="HandleSubmit" disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>@(EditingOutlet == null ? "Creating Outlet..." : "Saving Changes...")</span>
                }
                else
                {
                    <span>@(EditingOutlet == null ? "Create Outlet" : "Save Changes")</span>
                }
            </button>
        </div>
    </div>
</div>
