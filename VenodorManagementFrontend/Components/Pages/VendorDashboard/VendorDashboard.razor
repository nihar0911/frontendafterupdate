@page "/vendor-dashboard"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Vendor Manager Dashboard - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="vd-auth-warning-wrap">
        <div class="vd-auth-warning-card">
            <h4 class="fw-bold mb-2 text-dark">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as a Vendor Manager to view this portal.</p>
            <button class="btn vd-btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsVendorManager && !Auth.IsAdmin)
{
    <div class="vd-auth-warning-wrap">
        <div class="vd-auth-warning-card">
            <h4 class="fw-bold mb-2 text-danger">Access Denied</h4>
            <p class="text-muted mb-3">You do not have Vendor Manager privileges to access this portal.</p>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else if (!Auth.VendorID.HasValue || Auth.VendorID.Value <= 0)
{
    <div class="vd-auth-warning-wrap">
        <div class="vd-auth-warning-card">
            <h4 class="fw-bold mb-2 text-warning">Account Configuration Required</h4>
            <p class="text-muted mb-3">Your vendor manager account is not currently linked to a specific Vendor ID in the database.</p>
            <p class="small text-muted mb-3">Please contact an administrator to map your user profile to a registered vendor.</p>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/login")'>Return to Login</button>
        </div>
    </div>
}
else
{
    <div class="vd-layout">

        <!-- ===================================================================
             1. FIXED FULL-HEIGHT DARK GREEN SIDEBAR (#174F45)
             =================================================================== -->
        <aside class="vd-sidebar">
            <div class="vd-sidebar-top">
                <!-- SIDEBAR BRAND -->
                <div class="vd-sidebar-brand">
                    <div class="vd-brand-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                    </div>
                    <span class="vd-brand-text">VENDOR WORKSPACE</span>
                </div>

                <!-- NAVIGATION ITEMS -->
                <nav class="vd-nav-list">
                    <button type="button" 
                            class="vd-nav-item @(ActiveSidebarNav == "Dashboard" ? "active" : "")"
                            @onclick='() => SetSidebarNav("Dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Dashboard</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item @(ActiveSidebarNav == "MyQuotations" || ActiveSidebarNav == "QuotationDetails" ? "active" : "")"
                            @onclick='() => SetSidebarNav("MyQuotations")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>My Quotations</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item @(ActiveSidebarNav == "MyContracts" ? "active" : "")"
                            @onclick='() => SetSidebarNav("MyContracts")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            <line x1="12" y1="11" x2="12" y2="17"></line>
                            <line x1="9" y1="14" x2="15" y2="14"></line>
                        </svg>
                        <span>My Contracts</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item @(ActiveSidebarNav == "PurchaseOrders" ? "active" : "")"
                            @onclick='() => SetSidebarNav("PurchaseOrders")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                        <span>Purchase Orders</span>
                        @if (PendingPoCount > 0)
                        {
                            <span class="badge bg-danger ms-auto vd-nav-badge">@PendingPoCount</span>
                        }
                    </button>

                    <button type="button" 
                            class="vd-nav-item @(ActiveSidebarNav == "Invoices" ? "active" : "")"
                            @onclick='() => SetSidebarNav("Invoices")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>Invoices</span>
                        @if (EligiblePurchaseOrders.Count > 0)
                        {
                            <span class="badge bg-success ms-auto vd-nav-badge">@EligiblePurchaseOrders.Count</span>
                        }
                    </button>

                    <button type="button" 
                            class="vd-nav-item @(ActiveSidebarNav == "Performance" ? "active" : "")"
                            @onclick='() => SetSidebarNav("Performance")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>Performance &amp; Reviews</span>
                        @if (MyReviews.Count > 0)
                        {
                            <span class="badge bg-success ms-auto vd-nav-badge">@MyReviews.Count</span>
                        }
                    </button>

                    <button type="button" 
                            class="vd-nav-item @(ActiveSidebarNav == "MyProfile" ? "active" : "")"
                            @onclick='() => SetSidebarNav("MyProfile")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>My Profile</span>
                    </button>
                </nav>
            </div>

            <!-- SIDEBAR FOOTER (USER & LOGOUT) -->
            <div class="vd-sidebar-bottom">
                <div class="vd-user-profile-row">
                    <div class="vd-avatar-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                        </svg>
                    </div>
                    <div class="vd-user-info-text">
                        <div class="vd-user-name">@VendorName</div>
                        <div class="vd-user-role">Vendor Manager</div>
                    </div>
                </div>

                <button type="button" class="vd-logout-btn" @onclick="HandleLogout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </div>
        </aside>

        <!-- ===================================================================
             2. MAIN CONTENT AREA
             =================================================================== -->
        <main class="vd-main-canvas">

            <!-- TOP HEADER -->
            <header class="vd-top-header">
                <div class="vd-header-left">
                    <button type="button" class="vd-menu-btn" aria-label="Toggle menu">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <div>
                        @if (ActiveSidebarNav == "MyQuotations")
                        {
                            <h1 class="vd-welcome-title">My Quotations</h1>
                            <p class="vd-welcome-subtitle">View and manage quotations submitted by this vendor.</p>
                        }
                        else if (ActiveSidebarNav == "QuotationDetails" && SelectedQuotation != null)
                        {
                            <h1 class="vd-welcome-title">Quotation Details</h1>
                            <p class="vd-welcome-subtitle">Comprehensive overview of quotation QT-@SelectedQuotation.QuotationID and procurement specifications</p>
                        }
                        else if (ActiveSidebarNav == "MyContracts")
                        {
                            <h1 class="vd-welcome-title">My Contracts</h1>
                            <p class="vd-welcome-subtitle">View and manage procurement contracts associated with @VendorName.</p>
                        }
                        else if (ActiveSidebarNav == "Invoices")
                        {
                            <h1 class="vd-welcome-title">Invoices</h1>
                            <p class="vd-welcome-subtitle">Generate and track invoices for delivered purchase orders.</p>
                        }
                        else if (ActiveSidebarNav == "Performance")
                        {
                            <h1 class="vd-welcome-title">Performance &amp; Reviews</h1>
                            <p class="vd-welcome-subtitle">Customer ratings, feedback reviews, and operational fulfillment performance</p>
                        }
                        else if (ActiveSidebarNav == "MyProfile")
                        {
                            <h1 class="vd-welcome-title">My Profile</h1>
                            <p class="vd-welcome-subtitle">Manage your account information and authentication credentials.</p>
                        }
                        else
                        {
                            <h1 class="vd-welcome-title">@GetGreeting(), @Auth.UserName</h1>
                            <p class="vd-welcome-subtitle">
                                Welcome back, <span class="vd-accent-text">@VendorName</span> | Managing procurement opportunities &amp; quotations
                            </p>
                        }
                    </div>
                </div>

                <div class="vd-header-right">
                    <!-- NOTIFICATIONS POPUP -->
                    <div class="vd-notif-container">
                        <button type="button" class="vd-header-pill vd-notif-pill" @onclick="ToggleNotifications">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                            </svg>
                            <span>Notifications</span>
                            @if (UnreadNotificationCount > 0)
                            {
                                <span class="vd-notif-badge">@UnreadNotificationCount</span>
                            }
                            else if (Notifications.Count > 0)
                            {
                                <span class="vd-notif-badge">@Notifications.Count</span>
                            }
                            else if (Opportunities != null && Opportunities.Count > 0)
                            {
                                <span class="vd-notif-badge">@Opportunities.Count</span>
                            }
                        </button>

                        @if (ShowNotificationDropdown)
                        {
                            <div class="vd-notif-dropdown">
                                <div class="vd-notif-dropdown-head">
                                    <h6 class="mb-0 fw-bold">Vendor Notifications</h6>
                                    @if (UnreadNotificationCount > 0)
                                    {
                                        <span class="badge bg-success">@UnreadNotificationCount new</span>
                                    }
                                </div>
                                @if ((Notifications == null || Notifications.Count == 0) && (Opportunities == null || Opportunities.Count == 0))
                                {
                                    <div class="p-3 text-center text-muted small">No notifications found.</div>
                                }
                                else
                                {
                                    <div class="vd-notif-dropdown-body">
                                        @if (Notifications != null)
                                        {
                                            @foreach (var notif in Notifications.Take(6))
                                            {
                                                <div class="vd-notif-item @(!notif.IsRead ? "unread" : "")" style="cursor: pointer;" @onclick='() => HandleVendorNotificationClick(notif)'>
                                                    <div class="vd-notif-content">
                                                        <span class="vd-notif-title text-dark">@notif.Title</span>
                                                        <p class="vd-notif-msg mb-0">@notif.Message</p>
                                                        <span class="vd-notif-time">@notif.CreatedDate.ToIst("dd MMM, hh:mm tt")</span>
                                                    </div>
                                                    @if (!notif.IsRead)
                                                    {
                                                        <button type="button" class="vd-notif-mark" @onclick:stopPropagation="true" @onclick='() => MarkAsRead(notif.NotificationID)' title="Mark as read">
                                                            &bull;
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        }
                                        @if (Opportunities != null)
                                        {
                                            @foreach (var opp in Opportunities.Take(4))
                                            {
                                                <div class="vd-notif-item" style="cursor: pointer;" @onclick='() => ViewOpportunity(opp.RequestID, opp.ProductID)'>
                                                    <div class="vd-notif-content">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <strong class="text-success small">PR-@opp.RequestID</strong>
                                                            <span class="vd-status-pill @(opp.OpportunityStatus == "Accepted" ? "status-approved" : opp.OpportunityStatus == "Rejected" ? "status-rejected" : "status-pending")" style="font-size: 0.65rem; padding: 2px 6px;">
                                                                @(opp.OpportunityStatus == "Pending" ? "Awaiting Decision" : opp.OpportunityStatus)
                                                            </span>
                                                        </div>
                                                        <p class="vd-notif-msg mb-0">@opp.ProductName (@opp.RequestedQuantity.ToString("N2") @opp.Unit) from @opp.OutletName</p>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- VENDOR CONTEXT PILL -->
                    <div class="vd-header-pill vd-vendor-pill">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#174F45" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                        </svg>
                        <span class="vd-vendor-pill-text">@VendorName</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>

                    <!-- TOP HEADER LOGOUT BUTTON -->
                    <button type="button" class="vd-header-pill vd-logout-header-pill" @onclick="HandleLogout" title="Logout">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Logout</span>
                    </button>
                </div>
            </header>

            @if (IsLoading)
            {
                <div class="vd-loading-state">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted fw-semibold">Loading vendor workspace...</p>
                </div>
            }
            else
            {
                <div class="vd-dashboard-body">

                    @if (ActiveSidebarNav == "QuotationDetails" && SelectedQuotation != null)
                    {
                        <!-- =======================================================
                             DEDICATED QUOTATION DETAILS VIEW (MATCHING MOCKUP)
                             ======================================================= -->
                        <div class="mb-3">
                            <button type="button" class="btn vd-back-btn" @onclick="CloseQuotationDetails">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                    <polyline points="12 19 5 12 12 5"></polyline>
                                </svg>
                                <span>Back to My Quotations</span>
                            </button>
                        </div>

                        <!-- 1. TOP SUMMARY CARD -->
                        <div class="vd-card p-4 mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="vd-metric-icon-lg bg-light-green text-green">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-1 text-dark fs-4">Quotation QT-@SelectedQuotation.QuotationID</h3>
                                        <span class="text-muted small">Submitted for Purchase Request PR-@SelectedQuotation.RequestID</span>
                                    </div>
                                </div>

                                <div>
                                    @if (string.Equals(SelectedQuotation.Status, "Accepted", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="vd-status-pill status-approved fs-6 px-3 py-1.5">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                            <span>Accepted</span>
                                        </span>
                                    }
                                    else if (string.Equals(SelectedQuotation.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="vd-status-pill status-rejected fs-6 px-3 py-1.5">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                            <span>Rejected</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="vd-status-pill status-pending fs-6 px-3 py-1.5">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg>
                                            <span>Submitted (Under Review)</span>
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.04em;">ASSOCIATED REQUEST</span>
                                    <div class="fw-bold text-dark fs-6" style="color: #174F45 !important;">PR-@SelectedQuotation.RequestID</div>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.04em;">VALID UNTIL</span>
                                    <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-1.5">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        <span>@SelectedQuotation.ValidUntil.ToIst("dd MMM yyyy")</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.04em;">TOTAL QUOTED AMOUNT</span>
                                    <div class="fw-bold fs-4" style="color: #047857;">Rs. @GetQuotationTotal(SelectedQuotation).ToString("N2")</div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. TWO-COLUMN DETAILS GRID -->
                        <div class="row g-4 mb-4">
                            <!-- LEFT: REQUEST & OUTLET INFORMATION -->
                            <div class="col-lg-6">
                                <div class="vd-card h-100 p-4">
                                    <div class="d-flex align-items-center gap-2.5 mb-3 pb-2">
                                        <div class="vd-section-icon-box bg-light-green text-green">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                                <line x1="16" y1="13" x2="8" y2="13"></line>
