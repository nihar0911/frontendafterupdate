@page "/vendor/procurement/{RequestId:int}"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Procurement Opportunity PR-@RequestId - Vendor Portal</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="vd-layout justify-content-center align-items-center p-4">
        <div class="procurement-card text-center p-5 shadow-sm" style="max-width: 500px; width: 100%;">
            <h4 class="fw-bold mb-2">Authentication Required</h4>
            <p class="text-muted mb-4">Please log in as a Vendor Manager to view this procurement request.</p>
            <button class="btn-procurement-accept px-4" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsVendorManager)
{
    <div class="vd-layout justify-content-center align-items-center p-4">
        <div class="procurement-card text-center p-5 shadow-sm" style="max-width: 500px; width: 100%;">
            <h4 class="fw-bold text-danger mb-2">Access Denied</h4>
            <p class="text-muted mb-4">You do not have Vendor Manager privileges to view this request.</p>
            <button class="btn btn-outline-secondary fw-bold px-4" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="vd-layout">

        <!-- ===================================================================
             1. FIXED FULL-HEIGHT DARK GREEN SIDEBAR (#174F45)
             =================================================================== -->
        <aside class="vd-sidebar">
            <div class="vd-sidebar-top">
                <!-- SIDEBAR BRAND -->
                <div class="vd-sidebar-brand">
                    <div class="vd-brand-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                    </div>
                    <span class="vd-brand-text">VENDOR WORKSPACE</span>
                </div>

                <!-- NAVIGATION ITEMS -->
                <nav class="vd-nav-list">
                    <button type="button" class="vd-nav-item active" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Dashboard</span>
                    </button>

                    <button type="button" class="vd-nav-item" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>My Quotations</span>
                    </button>

                    <button type="button" class="vd-nav-item" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            <line x1="12" y1="11" x2="12" y2="17"></line>
                            <line x1="9" y1="14" x2="15" y2="14"></line>
                        </svg>
                        <span>My Contracts</span>
                    </button>

                    <button type="button" class="vd-nav-item" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                        <span>Purchase Orders</span>
                    </button>

                    <button type="button" class="vd-nav-item" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>Invoices</span>
                    </button>

                    <button type="button" class="vd-nav-item" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>Performance &amp; Reviews</span>
                    </button>

                    <button type="button" class="vd-nav-item" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>My Profile</span>
                    </button>
                </nav>
            </div>

            <!-- SIDEBAR FOOTER (USER & LOGOUT) -->
            <div class="vd-sidebar-bottom">
                <div class="vd-user-profile-row">
                    <div class="vd-avatar-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                        </svg>
                    </div>
                    <div class="vd-user-info-text">
                        <div class="vd-user-name">@VendorName</div>
                        <div class="vd-user-role">Vendor Manager</div>
                    </div>
                </div>

                <button type="button" class="vd-logout-btn" @onclick="HandleLogout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </div>
        </aside>

        <!-- ===================================================================
             2. MAIN CONTENT CANVAS
             =================================================================== -->
        <main class="vd-main-canvas">

            <!-- TOP HEADER -->
            <header class="vd-top-header">
                <div class="vd-header-left">
                    <button type="button" class="vd-back-btn" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        <span>Back to Dashboard</span>
                    </button>
                </div>

                <div class="vd-header-right">
                    <div class="vd-vendor-pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                        </svg>
                        <span>@VendorName</span>
                    </div>
                </div>
            </header>

            <!-- CONTENT BODY -->
            <div class="vd-content-container">

                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-success mb-3" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h5 class="text-muted fw-bold">Loading request details...</h5>
                    </div>
                }
                else if (HasError)
                {
                    <div class="alert alert-danger p-4 text-center my-4" style="border-radius: 4px;">
                        <h5 class="fw-bold mb-2">Unable to load procurement opportunity</h5>
                        <p class="text-muted small mb-3">@ErrorMessage</p>
                        <button class="btn btn-danger fw-semibold px-4" style="border-radius: 4px;" @onclick="LoadData">Try Again</button>
                    </div>
                }
                else if (Opportunity == null)
                {
                    <div class="alert alert-warning p-4 text-center my-4" style="border-radius: 4px;">
                        <h5 class="fw-bold mb-2">Request Not Found or Ineligible</h5>
                        <p class="text-muted small mb-3">This purchase request was not found or is no longer eligible for your vendor account.</p>
                        <button class="btn btn-primary fw-semibold px-4" style="border-radius: 4px;" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>Return to Dashboard</button>
                    </div>
                }
                else
                {
                    <!-- PAGE HEADING -->
                    <div class="vd-page-heading-row">
                        <div>
                            <h1 class="vd-page-title">Procurement Opportunity — PR-@RequestId</h1>
                            <p class="vd-page-subtitle">Review purchase request specifications and manage quotation response</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ResponseFeedbackMessage))
                    {
                        <div class="alert alert-info p-3 mb-4" style="border-radius: 4px;">
                            @ResponseFeedbackMessage
                        </div>
                    }

                    <div class="row g-4">
                        <!-- LEFT COLUMN: REQUEST DETAILS PANEL -->
                        <div class="@(Opportunity.OpportunityStatus == "Pending" ? "col-12" : "col-lg-7")">
                            <div class="procurement-card">
                                <div class="card-section-header">
                                    <h3 class="card-section-title">Purchase Request PR-@Opportunity.RequestID</h3>
                                    <div>
                                        @if (Opportunity.OpportunityStatus == "Accepted")
                                        {
                                            <span class="status-pill status-pill-accepted">Accepted</span>
                                        }
                                        else if (Opportunity.OpportunityStatus == "Rejected")
                                        {
                                            <span class="status-pill status-pill-rejected">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-pill-pending">Awaiting Decision</span>
                                        }
                                    </div>
                                </div>

                                <!-- REAL REQUEST DETAILS GRID -->
                                <div class="detail-grid">
                                    <div class="detail-item">
                                        <span class="detail-label">Request Number</span>
                                        <span class="detail-value">PR-@Opportunity.RequestID</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Request Date</span>
                                        <span class="detail-value">@Opportunity.RequestDate.ToIst("dd MMM yyyy, hh:mm tt")</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Requested By</span>
                                        <span class="detail-value">@Opportunity.CreatedByUserName</span>
                                        <span class="detail-sub">@Opportunity.CreatedByUserRole</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Organization</span>
                                        <span class="detail-value">@Opportunity.OrganizationName</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Delivery Outlet</span>
                                        <span class="detail-value">@Opportunity.OutletName</span>
                                        @if (!string.IsNullOrWhiteSpace(Opportunity.OutletAddress))
                                        {
                                            <span class="detail-sub">@Opportunity.OutletAddress</span>
                                        }
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Product</span>
                                        <span class="detail-value">@Opportunity.ProductName</span>
                                        @if (!string.IsNullOrWhiteSpace(Opportunity.Category))
                                        {
                                            <span class="detail-sub">Category: @Opportunity.Category</span>
                                        }
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Quantity</span>
                                        <span class="detail-value">@Opportunity.RequestedQuantity.ToString("0.##") @Opportunity.Unit</span>
                                    </div>
                                </div>

                                <!-- REGISTERED SUPPLY TERMS -->
                                <div class="supply-terms-box">
                                    <div class="supply-terms-title">Registered Supply Terms</div>
                                    <div class="supply-terms-grid">
                                        <div class="detail-item">
                                            <span class="detail-label">Unit Price</span>
                                            <span class="detail-value">Rs. @Opportunity.UnitPrice.ToString("N2") / @Opportunity.Unit</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="detail-label">Estimated Delivery</span>
                                            <span class="detail-value">@Opportunity.EstimatedDeliveryDays Days</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- ACTION BUTTONS (FOR PENDING STATUS) -->
                                @if (Opportunity.OpportunityStatus == "Pending")
                                {
                                    <div class="actions-area-panel">
                                        <button type="button" 
                                                class="btn-procurement-accept" 
                                                @onclick='() => HandleRespond("Accept")' 
                                                disabled="@IsResponding">
                                            @if (IsResponding)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                <span>Accepting...</span>
                                            }
                                            else
                                            {
                                                <span>Accept Request</span>
                                            }
                                        </button>

                                        <button type="button" 
                                                class="btn-procurement-reject" 
                                                @onclick="OpenRejectModal" 
                                                disabled="@IsResponding">
                                            <span>Reject Request</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: QUOTATION SUBMISSION AREA (ONLY SHOWN AFTER DECISION) -->
                        @if (Opportunity.OpportunityStatus != "Pending")
                        {
                            <div class="col-lg-5">
                                @if (Opportunity.OpportunityStatus == "Rejected")
                                {
                                    <div class="procurement-card text-center p-4 h-100 d-flex flex-column justify-content-center">
                                        <h5 class="fw-bold text-danger mb-2">Request Declined</h5>
                                        <p class="text-muted small mb-4">
                                            Quotation submission is disabled because this procurement request was rejected.
                                            @if (!string.IsNullOrWhiteSpace(Opportunity.RejectionReason))
                                            {
                                                <span class="d-block mt-2 text-dark"><strong>Reason:</strong> @Opportunity.RejectionReason</span>
                                            }
                                        </p>
                                        <button type="button" class="btn btn-outline-secondary fw-semibold py-2" style="border-radius: 4px;"
                                                @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                                            Return to Dashboard
                                        </button>
                                    </div>
                                }
                            else if (CreatedQuotation != null)
                            {
                                <div class="procurement-card text-center p-4 h-100 d-flex flex-column justify-content-center">
                                    <h4 class="fw-bold text-dark mb-2">Quotation Submitted</h4>
                                    <p class="text-muted mb-4 small">
                                        Quotation <strong>@CreatedQuotation.QuotationID</strong> has been submitted to <strong>@Opportunity.OrganizationName</strong> for review.
                                    </p>
                                    <button class="btn-procurement-accept px-4 py-2" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                                        Return to Dashboard
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="procurement-card">
                                    <div class="card-section-header">
                                        <h5 class="card-section-title">Prepare &amp; Submit Quotation</h5>
                                        <span class="status-pill status-pill-accepted">Unlocked</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(FormError))
                                    {
                                        <div class="alert alert-danger p-3 small mb-3" style="border-radius: 4px;">
                                            @FormError
                                        </div>
                                    }

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Unit Price (Rs. per @Opportunity.Unit)</label>
                                        <input type="number" step="0.01" min="0.01" class="form-control fw-semibold"
                                               style="border-radius: 4px;"
                                               @bind="UnitPriceInput" disabled="@IsSubmitting" />
                                        <small class="text-muted">Pre-filled with your registered unit price (Rs. @Opportunity.UnitPrice.ToString("N2")).</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Requested Quantity</label>
                                        <input type="text" class="form-control bg-light" style="border-radius: 4px;" value="@Opportunity.RequestedQuantity @Opportunity.Unit" readonly />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Estimated Total Amount</label>
                                        <div class="p-2.5 bg-light border fw-bold text-dark fs-5" style="border-radius: 4px;">
                                            Rs. @((UnitPriceInput * Opportunity.RequestedQuantity).ToString("N2"))
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Valid Until Date</label>
                                        <input type="date" class="form-control" style="border-radius: 4px;" @bind="ValidUntilInput" disabled="@IsSubmitting" />
                                    </div>

                                    <button type="button" class="btn-procurement-accept w-100 fw-bold py-2.5 mt-2"
                                            @onclick="SubmitQuotation" disabled="@IsSubmitting">
                                        @if (IsSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                            <span>Submitting Quotation...</span>
                                        }
                                        else
                                        {
                                            <span>Submit Quotation</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    </div>
                }
            </div>
        </main>
    </div>
}

<!-- REJECT CONFIRMATION MODAL -->
@if (ShowRejectModal && Opportunity != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.6);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 4px; border: 1px solid #D2DCD6;">
                <div class="modal-header bg-danger text-white" style="border-radius: 4px 4px 0 0;">
                    <h5 class="modal-title fw-bold">Reject Procurement Opportunity</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRejectModal" disabled="@IsResponding"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-dark mb-3">
                        Are you sure you want to decline <strong>Purchase Request PR-@Opportunity.RequestID</strong> for <strong>@Opportunity.RequestedQuantity @Opportunity.Unit</strong> of <strong>@Opportunity.ProductName</strong>?
                    </p>
                    <p class="text-muted small mb-3">
                        A notification will be sent to the request creator (<strong>@Opportunity.CreatedByUserName</strong>). You will not be able to submit a quotation for this request.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Reason for Rejection <span class="text-muted fw-normal">(Optional)</span></label>
                        <textarea class="form-control" style="border-radius: 4px;" rows="3" @bind="RejectionReasonInput" placeholder="e.g. Stock unavailable, unable to meet delivery timeline, out of delivery zone..." disabled="@IsResponding"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light" style="border-radius: 0 0 4px 4px;">
                    <button type="button" class="btn btn-secondary fw-semibold" style="border-radius: 4px;" @onclick="CloseRejectModal" disabled="@IsResponding">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger fw-semibold px-4" style="border-radius: 4px;" @onclick='() => HandleRespond("Reject")' disabled="@IsResponding">
                        @if (IsResponding)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Rejecting...</span>
                        }
                        else
                        {
                            <span>Confirm Rejection</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
