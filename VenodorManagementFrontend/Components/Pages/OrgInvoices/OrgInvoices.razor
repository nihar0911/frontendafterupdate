@page "/organization/invoices"
@page "/organization/invoices/{InvoiceId:int}"
@namespace VenodorManagementFrontend.Components.Pages.OrgInvoices

<PageTitle>Invoices - @OrganizationName</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="org-po-warning-wrap">
        <div class="org-po-warning-card">
            <h4 class="fw-bold mb-2 text-dark">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in to access Invoices.</p>
            <button class="btn btn-primary" @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager/login" : "/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsOrgManager && !Auth.IsAdmin && !Auth.IsPurchaseManager)
{
    <div class="org-po-warning-wrap">
        <div class="org-po-warning-card">
            <h4 class="fw-bold mb-2 text-danger">Access Denied</h4>
            <p class="text-muted mb-3">You do not have privileges to manage invoices.</p>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else if (Auth.IsPurchaseManager && (!Auth.OutletID.HasValue || Auth.OutletID.Value <= 0))
{
    <div class="org-po-warning-wrap">
        <div class="org-po-warning-card">
            <h4 class="fw-bold mb-2 text-warning">No Outlet Assigned</h4>
            <p class="text-muted mb-3">No outlet is assigned to this Purchase Manager.</p>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/purchase-manager")'>Return to Dashboard</button>
        </div>
    </div>
}
else
{
    <div class="org-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">
        
        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION (ENTERPRISE DARK GREEN)
             ======================================================================= -->
        <aside class="org-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager" : "/org-dashboard")'>
                    <div class="brand-emblem">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">Smart Vendor</span>
                        <span class="brand-sub">Management</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager" : "/org-dashboard")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/outlets")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <path d="M9 22V12h6v10"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Outlets</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="12" y1="18" x2="12" y2="12"></line>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Quotations</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/contracts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                                </svg>
                            </span>
                            <span class="nav-label">Contracts</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link active" @onclick='() => { if (IsViewingDetails) { BackToInvoiceList(); } else { Nav.NavigateTo("/organization/invoices"); } }'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Invoices</span>
                            @if (PendingInvoicesCount > 0)
                            {
                                <span class="badge bg-warning text-dark ms-auto" style="font-size: 0.72rem; border-radius: 10px;">@PendingInvoicesCount</span>
                            }
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/payments")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                    <line x1="1" y1="10" x2="23" y2="10"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Payments</span>
                        </button>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <div class="user-profile-badge">
                    <div class="user-avatar-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div class="user-meta">
                        <span class="user-name">@Auth.UserName</span>
                        <span class="user-role">@(Auth.IsPurchaseManager ? "Purchase Manager" : (Auth.IsAdmin ? "Administrator" : "Organization Manager"))</span>
                    </div>
                </div>

                <button class="logout-btn" @onclick="HandleLogout" title="Sign Out">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </div>
        </aside>

        <!-- =======================================================================
             MAIN CONTENT CANVAS
             ======================================================================= -->
        <main class="org-main-content">
            
            <!-- TOP APP BAR -->
            <header class="org-top-bar">
                <div class="top-bar-left">
                    @if (IsViewingDetails)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 me-3" @onclick="BackToInvoiceList">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            Back to Invoices
                        </button>
                        <div>
                            <h1 class="page-title mb-0">Invoice INV-@SelectedInvoice?.InvoiceID</h1>
                            <p class="page-subtitle mb-0">Review against purchase order &amp; delivery records</p>
                        </div>
                    }
                    else
                    {
                        <h1 class="page-title">Invoices &amp; Billing</h1>
                        <p class="page-subtitle">Verify delivery records and manage vendor invoices for @(Auth.IsPurchaseManager && !string.IsNullOrEmpty(OutletDisplayName) ? OutletDisplayName : OrganizationName)</p>
                    }
                </div>

                <div class="top-bar-right">
                    <div class="org-badge">
                        <span class="dot-indicator"></span>
                        <span>@(Auth.IsPurchaseManager && !string.IsNullOrEmpty(OutletDisplayName) ? OutletDisplayName : OrganizationName)</span>
                    </div>
                </div>
            </header>

            <div class="content-scroll-container">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-success" role="status"></div>
                        <p class="text-muted small mt-2">Loading organization invoices...</p>
                    </div>
                }
                else if (IsViewingDetails && SelectedInvoice != null)
                {
                    <!-- =======================================================
                         INVOICE DETAILS & 3-WAY RECONCILIATION VIEW
                         ======================================================= -->
                    <div class="invoice-details-container">
                        @if (!string.IsNullOrEmpty(ActionError))
                        {
                            <div class="alert alert-danger py-2 mb-3 small">@ActionError</div>
                        }
                        @if (!string.IsNullOrEmpty(ActionSuccess))
                        {
                            <div class="alert alert-success py-2 mb-3 small">@ActionSuccess</div>
                        }

                        <!-- SUMMARY HEADER CARD -->
                        <div class="card border-0 shadow-sm rounded-3 p-4 mb-4 bg-white">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h3 class="fw-bold mb-0 text-dark">INV-@SelectedInvoice.InvoiceID</h3>
                                        @if (string.Equals(SelectedInvoice.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">Approved</span>
                                        }
                                        else if (string.Equals(SelectedInvoice.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">Rejected</span>
                                        }
                                        else if (string.Equals(SelectedInvoice.Status, "Paid", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">Pending Review</span>
                                        }
                                    </div>
                                    <p class="text-muted small mb-0">
                                        Submitted on @SelectedInvoice.InvoiceDate.ToString("dd MMMM yyyy, hh:mm tt") | PO Reference: <strong>PO-@SelectedInvoice.PurchaseOrderID</strong>
                                    </p>
                                </div>

                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-1" @onclick="() => HandleViewPdf(SelectedInvoice)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        View PDF
                                    </button>

                                    <button type="button" class="btn btn-outline-dark d-flex align-items-center gap-1" @onclick="() => HandleDownloadPdf(SelectedInvoice)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="7 10 12 15 17 10"></polyline>
                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                        </svg>
                                        Download PDF
                                    </button>

                                    @if (string.Equals(SelectedInvoice.Status, "Pending", StringComparison.OrdinalIgnoreCase) && (Auth.IsAdmin || Auth.IsPurchaseManager))
                                    {
                                        <button type="button" class="btn btn-outline-danger d-flex align-items-center gap-1" @onclick="OpenRejectModal" disabled="@IsProcessingAction">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                            Reject Invoice
                                        </button>

                                        <button type="button" class="btn btn-success d-flex align-items-center gap-1 px-3" @onclick="HandleApproveInvoice" disabled="@IsProcessingAction">
                                            @if (IsProcessingAction)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>Processing...</span>
                                            }
                                            else
                                            {
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <span>Approve Invoice</span>
                                            }
                                        </button>
                                    }
                                    else if (string.Equals(SelectedInvoice.Status, "Approved", StringComparison.OrdinalIgnoreCase) && (Auth.IsAdmin || Auth.IsPurchaseManager))
                                    {
                                        <button type="button" class="btn btn-success d-flex align-items-center gap-1 px-3" @onclick='() => Nav.NavigateTo($"/organization/payments/{SelectedInvoice.InvoiceID}")'>
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                                <line x1="1" y1="10" x2="23" y2="10"></line>
                                            </svg>
                                            <span>Pay Invoice</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 3-WAY RECONCILIATION BANNER -->
                        <div class="card border-0 shadow-sm rounded-3 p-4 mb-4" style="background-color: #F0FDF4; border-left: 4px solid #16A34A !important;">
                            <div class="d-flex align-items-start gap-3">
                                <div class="p-2 bg-success text-white rounded-circle flex-shrink-0">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">3-Way Procurement Reconciliation Verified</h5>
                                    <p class="text-muted small mb-0">
                                        This invoice has been verified against Purchase Order <strong>PO-@SelectedInvoice.PurchaseOrderID</strong> and verified delivery records from <strong>@SelectedInvoice.OutletName</strong>. 
                                        Invoiced quantities strictly reflect <strong>Net Accepted Goods (Received Quantity minus Spoiled Quantity)</strong>.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <!-- VENDOR & OUTLET INFO -->
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Vendor / Supplier</h6>
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Supplier Name</span>
                                        <span class="fw-medium text-dark">@SelectedInvoice.VendorName</span>
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Delivery Destination</span>
                                        <span class="fw-medium text-dark">@SelectedInvoice.OutletName</span>
                                    </div>
                                    <div>
                                        <span class="text-muted small d-block">Organization</span>
                                        <span class="fw-medium text-dark">@OrganizationName</span>
                                    </div>
                                </div>
                            </div>

                            <!-- ORDER & DELIVERY INFO -->
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Order &amp; Delivery Reference</h6>
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Purchase Order Date</span>
                                        <span class="fw-medium text-dark">@(SelectedPo?.OrderDate.ToString("dd MMM yyyy") ?? "N/A")</span>
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Dispatched Date</span>
                                        <span class="fw-medium text-dark">@(SelectedPo?.DispatchDateTime.HasValue == true ? SelectedPo.DispatchDateTime.Value.ToString("dd MMM yyyy, hh:mm tt") : "N/A")</span>
                                    </div>
                                    <div>
                                        <span class="text-muted small d-block">Delivery Confirmation Date</span>
                                        <span class="fw-medium text-dark">@(SelectedPo?.ActualDeliveryDate.HasValue == true ? SelectedPo.ActualDeliveryDate.Value.ToString("dd MMM yyyy, hh:mm tt") : "Confirmed")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ITEM RECONCILIATION TABLE -->
                        <div class="card border-0 shadow-sm rounded-3 p-4 mb-4 bg-white">
                            <h5 class="fw-bold text-dark mb-3">Item Breakdown &amp; Quantity Reconciliation</h5>
                            
                            <div class="table-responsive">
                                <table class="table align-middle table-hover mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>PRODUCT</th>
                                            <th class="text-end">UNIT PRICE</th>
                                            <th class="text-center">ORDERED</th>
                                            <th class="text-center">RECEIVED</th>
                                            <th class="text-center">SPOILED</th>
                                            <th class="text-center fw-bold">BILLED QTY</th>
                                            <th class="text-end">TAX RATE</th>
                                            <th class="text-end">SUBTOTAL</th>
                                            <th class="text-end fw-bold">TOTAL</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in SelectedInvoice.Items)
                                        {
                                            var poItem = SelectedPo?.Items?.FirstOrDefault(i => i.ProductID == item.ProductID);
                                            var orderedQty = poItem?.Quantity ?? item.Quantity;
                                            var receivedQty = GetDeliveredQuantity(item.ProductID);
                                            var spoiledQty = GetSpoiledQuantity(item.ProductID);

                                            <tr>
                                                <td class="fw-medium text-dark">@item.ProductName</td>
                                                <td class="text-end text-muted">Rs. @item.UnitPrice.ToString("N2")</td>
                                                <td class="text-center text-muted">@orderedQty.ToString("G29")</td>
                                                <td class="text-center text-dark">@(receivedQty > 0 ? receivedQty.ToString("G29") : orderedQty.ToString("G29"))</td>
                                                <td class="text-center text-danger">@(spoiledQty > 0 ? $"-{spoiledQty.ToString("G29")}" : "0")</td>
                                                <td class="text-center fw-bold text-success">@item.Quantity.ToString("G29")</td>
                                                <td class="text-end text-muted">@item.TaxRate%</td>
                                                <td class="text-end text-dark">Rs. @item.Subtotal.ToString("N2")</td>
                                                <td class="text-end fw-bold text-dark">Rs. @item.TotalAmount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- FINANCIAL TOTALS -->
                            <div class="d-flex justify-content-end mt-4">
                                <div class="p-3 bg-light rounded-3 border" style="min-width: 320px;">
                                    <div class="d-flex justify-content-between text-muted small mb-2">
                                        <span>Net Subtotal:</span>
                                        <span>Rs. @SelectedInvoice.Subtotal.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small mb-2">
                                        <span>Tax Total:</span>
                                        <span>Rs. @SelectedInvoice.TaxAmount.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between fw-bold text-dark border-top pt-2 fs-6">
                                        <span>Invoice Grand Total:</span>
                                        <span class="text-success">Rs. @SelectedInvoice.TotalAmount.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }
                else
                {
                    <!-- =======================================================
                         INVOICES LIST VIEW (ORGANIZATION MANAGER)
                         ======================================================= -->
                    
                    <!-- SUMMARY METRIC CARDS -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6 col-lg-3">
                            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small fw-medium">Total Invoices</span>
                                    <div class="p-2 bg-light rounded-circle text-muted">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                            <line x1="2" y1="10" x2="22" y2="10"></line>
                                        </svg>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-dark">@TotalInvoicesCount</h3>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3">
                            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small fw-medium">Pending Review</span>
                                    <div class="p-2 bg-warning-subtle text-warning rounded-circle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-warning">@PendingInvoicesCount</h3>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3">
                            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small fw-medium">Approved Invoices</span>
                                    <div class="p-2 bg-success-subtle text-success rounded-circle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-success">@ApprovedInvoicesCount</h3>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3">
                            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small fw-medium">Total Invoiced Amount</span>
                                    <div class="p-2 bg-light rounded-circle text-muted">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="12" y1="1" x2="12" y2="23"></line>
                                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                        </svg>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-dark">Rs. @TotalInvoicedAmount.ToString("N2")</h3>
                            </div>
                        </div>
                    </div>

                    <!-- TABLE & FILTERS CARD -->
                    <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
                        <div class="p-3 border-bottom">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                
                                <!-- Filter Pills -->
                                <div class="d-flex flex-wrap gap-1">
                                    <button type="button" class="btn btn-sm @(StatusFilter == "All" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => StatusFilter = "All"'>
                                        All Invoices (@AllInvoices.Count)
                                    </button>
                                    <button type="button" class="btn btn-sm @(StatusFilter == "Pending" ? "btn-warning" : "btn-outline-secondary")" @onclick='() => StatusFilter = "Pending"'>
                                        Pending (@PendingInvoicesCount)
                                    </button>
                                    <button type="button" class="btn btn-sm @(StatusFilter == "Approved" ? "btn-success" : "btn-outline-secondary")" @onclick='() => StatusFilter = "Approved"'>
                                        Approved (@ApprovedInvoicesCount)
                                    </button>
                                    <button type="button" class="btn btn-sm @(StatusFilter == "Rejected" ? "btn-danger" : "btn-outline-secondary")" @onclick='() => StatusFilter = "Rejected"'>
                                        Rejected
                                    </button>
                                    <button type="button" class="btn btn-sm @(StatusFilter == "Paid" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => StatusFilter = "Paid"'>
                                        Paid
                                    </button>
                                </div>

                                <!-- Search Box -->
                                <div class="position-relative" style="min-width: 260px;">
                                    <input type="text" class="form-control form-control-sm ps-4" placeholder="Search by INV, PO, vendor, outlet..." @bind="SearchQuery" @bind:event="oninput" />
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="position-absolute top-50 start-0 translate-middle-y ms-2 text-muted">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                </div>

                            </div>
                        </div>

                        <div class="card-body p-0">
                            @if (!FilteredInvoices.Any())
                            {
                                <div class="text-center py-5">
                                    <div class="p-3 bg-light rounded-circle d-inline-flex mb-3 text-muted">
                                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                            <line x1="2" y1="10" x2="22" y2="10"></line>
                                        </svg>
                                    </div>
                                    <h5 class="fw-bold text-dark">No Invoices Found</h5>
                                    <p class="text-muted small mb-0">No invoices match your selected filter criteria.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table align-middle table-hover mb-0">
                                        <thead class="table-light small">
                                            <tr>
                                                <th>INVOICE REF</th>
                                                <th>PO REF</th>
                                                <th>VENDOR</th>
                                                <th>OUTLET</th>
                                                <th>INVOICE DATE</th>
                                                <th>TOTAL AMOUNT</th>
                                                <th>STATUS</th>
                                                <th class="text-end">ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var invoice in FilteredInvoices)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="fw-bold text-dark">INV-@invoice.InvoiceID</span>
                                                    </td>
                                                    <td>
                                                        <span class="text-muted">PO-@invoice.PurchaseOrderID</span>
                                                    </td>
                                                    <td>
                                                        <span class="text-dark">@invoice.VendorName</span>
                                                    </td>
                                                    <td>
                                                        <span class="text-dark">@invoice.OutletName</span>
                                                    </td>
                                                    <td>
                                                        <span class="text-muted">@invoice.InvoiceDate.ToString("dd MMM yyyy")</span>
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-dark">Rs. @invoice.TotalAmount.ToString("N2")</span>
                                                    </td>
                                                    <td>
                                                        @if (string.Equals(invoice.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Approved</span>
                                                        }
                                                        else if (string.Equals(invoice.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Rejected</span>
                                                        }
                                                        else if (string.Equals(invoice.Status, "Paid", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Paid</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Pending Review</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="d-inline-flex gap-2">
                                                            @if (string.Equals(invoice.Status, "Approved", StringComparison.OrdinalIgnoreCase) && (Auth.IsAdmin || Auth.IsPurchaseManager))
                                                            {
                                                                <button type="button" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1" @onclick='() => Nav.NavigateTo($"/organization/payments/{invoice.InvoiceID}")'>
                                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                                                        <line x1="1" y1="10" x2="23" y2="10"></line>
                                                                    </svg>
                                                                    Pay
                                                                </button>
                                                            }
                                                            <button type="button" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1" @onclick="() => OpenInvoiceDetailsAsync(invoice.InvoiceID)">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                                    <circle cx="12" cy="12" r="3"></circle>
                                                                </svg>
                                                                Review
                                                            </button>

                                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Download PDF" @onclick="() => HandleDownloadPdf(invoice)">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                                    <polyline points="7 10 12 15 17 10"></polyline>
                                                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

        </main>
    </div>

    <!-- =======================================================================
         REJECT INVOICE MODAL
         ======================================================================= -->
    @if (ShowRejectModal && SelectedInvoice != null)
    {
        <div class="modal-backdrop-custom">
            <div class="create-po-modal-card" style="max-width: 500px;">
                <div class="modal-header-custom">
                    <div>
                        <h4 class="modal-title-custom">Reject Invoice INV-@SelectedInvoice.InvoiceID</h4>
                        <p class="modal-sub-custom mb-0">Provide a specific reason for rejecting this vendor invoice.</p>
                    </div>
                    <button type="button" class="modal-close-btn" @onclick="CloseRejectModal">&times;</button>
                </div>

                <div class="modal-body-custom">
                    @if (!string.IsNullOrEmpty(RejectError))
                    {
                        <div class="alert alert-danger py-2 mb-3 small">@RejectError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Reason for Rejection *</label>
                        <textarea class="form-control" rows="4" placeholder="E.g., Discrepancy between delivered quantity and billed amount; spoiled goods not deducted..." @bind="RejectReason"></textarea>
                    </div>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseRejectModal" disabled="@IsProcessingAction">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="HandleConfirmReject" disabled="@IsProcessingAction">
                        @if (IsProcessingAction)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Rejecting...</span>
                        }
                        else
                        {
                            <span>Confirm Rejection</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

