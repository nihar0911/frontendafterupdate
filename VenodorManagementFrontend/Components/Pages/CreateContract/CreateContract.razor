@page "/contract/create"
@page "/contract/create/{QuotationId:int}"
@page "/create-contract/{QuotationId:int}"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Contract Creation &amp; Vendor Assignment - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="unauth-container">
        <div class="unauth-card">
            <h4 class="unauth-title">Authentication Required</h4>
            <p class="unauth-desc">Please log in as an Organization Manager to create contracts.</p>
            <button class="btn-login-redirect" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsOrgManager && !Auth.IsAdmin)
{
    <div class="unauth-container">
        <div class="unauth-card">
            <h4 class="unauth-title text-danger">Access Denied</h4>
            <p class="unauth-desc">You do not have Organization Manager privileges to establish contracts.</p>
            <button class="btn-login-redirect" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="org-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">

        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION (ENTERPRISE DARK GREEN)
             ======================================================================= -->
        <aside class="org-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                    <div class="brand-emblem">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">Smart Vendor</span>
                        <span class="brand-sub">Management</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/outlets")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <path d="M9 22V12h6v10"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Outlets</span>
                        </button>
                    </li>

                    @if (Auth.IsPurchaseManager || Auth.IsAdmin)
                    {
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>
                    }

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="12" y1="18" x2="12" y2="12"></line>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Quotations</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link active" @onclick='() => Nav.NavigateTo("/organization/contracts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Contracts</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>
                </ul>

                <ul class="nav-list nav-list-bottom">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">My Profile</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link nav-logout" @onclick="HandleLogout">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Logout</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- =======================================================================
             MAIN BODY WRAPPER
             ======================================================================= -->
        <div class="org-main-wrapper">

            <!-- TOP HEADER -->
            <header class="org-top-header">
                <button class="menu-toggle-btn" @onclick="ToggleSidebar" title="Toggle Menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <div class="header-right">
                    <div class="profile-capsule-wrapper">
                        <div class="profile-capsule" @onclick="ToggleProfileDropdown">
                            <div class="profile-avatar">@GetUserInitial()</div>
                            <div class="profile-meta">
                                <span class="profile-name">@(string.IsNullOrWhiteSpace(Auth.UserName) ? (Auth.CurrentUser?.Name ?? "Organization Manager") : Auth.UserName)</span>
                                <span class="profile-role">Organization Manager</span>
                            </div>
                            <svg class="dropdown-arrow @(IsProfileDropdownOpen ? "open" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>

                    <button class="header-logout-btn" @onclick="HandleLogout" title="Sign out">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Logout</span>
                    </button>
                </div>
            </header>

            <!-- MAIN CONTENT CANVAS -->
            <main class="org-main-content">
                <div class="content-container">

                    <!-- BREADCRUMB & TOP BACK ACTION -->
                    <div class="top-breadcrumb-row">
                        <div class="breadcrumb-links">
                            <a href="/org-dashboard" class="bc-link">Dashboard</a>
                            <span class="bc-sep">&rsaquo;</span>
                            <a href="/organization/contracts" class="bc-link">Contracts</a>
                            <span class="bc-sep">&rsaquo;</span>
                            <span class="bc-current">Contract Creation</span>
                        </div>

                        <button type="button" class="btn-back-dashboard" @onclick="GoBack">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            <span>Back</span>
                        </button>
                    </div>

                    <!-- PAGE MAIN HEADING -->
                    <div class="page-title-section">
                        <h1 class="page-main-heading">Contract Creation &amp; Vendor Assignment</h1>
                        <p class="page-sub-heading">Establish supply contracts by assigning products to eligible vendors with reference planning quantities. One contract will be created per distinct vendor.</p>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="loading-state">
                            <div class="loading-spinner"></div>
                            <h4 class="loading-text">Loading contract specifications...</h4>
                            <p class="loading-sub">Fetching outlets and active vendor product assignments</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="error-banner">
                            <div class="error-banner-content">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <span>@ErrorMessage</span>
                            </div>
                            <button type="button" class="btn-back-dashboard" @onclick="GoBack">Return</button>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(ValidationMessage))
                        {
                            <div class="warning-banner">
                                <div class="warning-banner-content">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                    <span>@ValidationMessage</span>
                                </div>
                                <button type="button" class="btn-close-banner" @onclick="() => ValidationMessage = null">&times;</button>
                            </div>
                        }

                        <!-- TWO COLUMN MAIN LAYOUT -->
                        <div class="contract-two-col-grid">

                            <!-- =======================================================
                                 LEFT COLUMN: SPECIFICATIONS & SCHEDULE
                                 ======================================================= -->
                            <div class="col-left">

                                @if (IsStandaloneMode)
                                {
                                    <!-- STANDALONE CONTRACT SPECIFICATIONS CARD -->
                                    <div class="content-card mb-4">
                                        <div class="card-header-row">
                                            <div class="card-icon-box">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                                </svg>
                                            </div>
                                            <h3 class="card-section-title">Contract Specifications</h3>
                                        </div>

                                        <div class="form-group-item mb-3">
                                            <label class="form-label-custom">Organization</label>
                                            <input type="text" class="form-input-custom bg-light" value="@OrganizationName" readonly disabled />
                                        </div>

                                        <div class="form-group-item">
                                            <label class="form-label-custom">Select Outlet <span class="required-star">*</span></label>
                                            <div class="select-wrapper-custom">
                                                <select class="form-select-custom" @bind="SelectedOutletId" @bind:after="OnOutletSelected">
                                                    <option value="0">Choose an outlet...</option>
                                                    @foreach (var outlet in OrganizationOutlets)
                                                    {
                                                        <option value="@outlet.OutletID">@outlet.OutletName</option>
                                                    }
                                                </select>
                                                <svg class="select-arrow-custom" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- INHERITED CONTRACT SPECIFICATIONS CARD (QUOTATION MODE) -->
                                    <div class="content-card mb-4">
                                        <div class="card-header-row">
                                            <div class="card-icon-box">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                                </svg>
                                            </div>
                                            <h3 class="card-section-title">Inherited Specifications</h3>
                                        </div>

                                        <div class="specs-grid">
                                            <div class="specs-cell">
                                                <span class="specs-label">Quotation ID</span>
                                                <span class="specs-val text-success fw-bold">@(Quotation?.QuotationID ?? QuotationId ?? 0)</span>
                                            </div>
                                            <div class="specs-cell">
                                                <span class="specs-label">Purchase Request ID</span>
                                                <span class="specs-val text-success fw-bold">PR-@(PurchaseRequest?.RequestID ?? Quotation?.RequestID ?? 0)</span>
                                            </div>
                                            <div class="specs-cell">
                                                <span class="specs-label">Organization</span>
                                                <span class="specs-val">@OrganizationName</span>
                                            </div>
                                            <div class="specs-cell">
                                                <span class="specs-label">Outlet</span>
                                                <span class="specs-val">@OutletName</span>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- CONTRACT TERMS & SCHEDULE CARD -->
                                <div class="content-card">
                                    <div class="card-header-row">
                                        <div class="card-icon-box">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                            </svg>
                                        </div>
                                        <h3 class="card-section-title">Contract Terms &amp; Schedule</h3>
                                    </div>

                                    <div class="dates-form-row">
                                        <div class="form-group-item">
                                            <label class="form-label-custom">Start Date</label>
                                            <input type="date" class="form-input-custom" @bind="StartDate" />
                                        </div>
                                        <div class="form-group-item">
                                            <label class="form-label-custom">End Date</label>
                                            <input type="date" class="form-input-custom" @bind="EndDate" />
                                        </div>
                                    </div>

                                    <div class="form-group-item mt-3">
                                        <label class="form-label-custom">Payment Method</label>
                                        <div class="select-wrapper-custom">
                                            <select class="form-select-custom" @bind="PaymentMethod">
                                                <option value="Bank Transfer">Bank Transfer</option>
                                                <option value="Cash on Delivery">Cash on Delivery</option>
                                                <option value="Net 30">Net 30</option>
                                                <option value="Credit Card">Credit Card</option>
                                            </select>
                                            <svg class="select-arrow-custom" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- =======================================================
                                 RIGHT COLUMN: PRODUCTS & VENDOR ASSIGNMENTS
                                 ======================================================= -->
                            <div class="col-right">
                                <div class="content-card mb-4">

                                    <!-- SECTION HEADER -->
                                    <div class="alloc-card-header">
                                        <div class="alloc-header-left">
                                            <div class="card-icon-box">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="18" cy="5" r="3"></circle>
                                                    <circle cx="6" cy="12" r="3"></circle>
                                                    <circle cx="18" cy="19" r="3"></circle>
                                                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                                </svg>
                                            </div>
                                            <h3 class="card-section-title">Products &amp; Vendor Assignments</h3>
                                        </div>

                                        <div class="alloc-header-right">
                                            <span class="total-qty-label">Products</span>
                                            <span class="total-qty-val">@ProductLines.Count</span>
                                        </div>
                                    </div>

                                    @if (SelectedOutletId <= 0)
                                    {
                                        <p class="alloc-sub-desc">
                                            Please select an outlet on the left to start adding products and assigning eligible vendors.
                                        </p>

                                        <div class="alloc-empty-notice">
                                            <div class="alloc-empty-title">Outlet Selection Required</div>
                                            <div class="alloc-empty-desc">Choose an outlet on the left to activate product addition and vendor candidate discovery.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- ADD PRODUCT LINE FORM -->
                                        @if (IsStandaloneMode)
                                        {
                                            <div class="add-product-container">
                                                <label class="form-label-custom mb-2">Add Product to Contract Preparation</label>
                                                <div class="add-product-form-grid">
                                                    <div class="form-group-item">
                                                        <div class="select-wrapper-custom">
                                                            <select class="form-select-custom" @bind="NewProductId">
                                                                <option value="0">Select a product to add...</option>
                                                                @foreach (var prod in SelectableProducts)
                                                                {
                                                                    <option value="@prod.ProductID">@prod.ProductName (@prod.Unit)</option>
                                                                }
                                                            </select>
                                                            <svg class="select-arrow-custom" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <polyline points="6 9 12 15 18 9"></polyline>
                                                            </svg>
                                                        </div>
                                                    </div>

                                                    <div class="form-group-item">
                                                        <div class="qty-input-wrap">
                                                            <input type="number" step="1" min="1" class="form-input-custom"
                                                                   @bind="NewProductQuantity"
                                                                   placeholder="Planning Qty" />
                                                            <span class="qty-unit-label">@NewProductUnit</span>
                                                        </div>
                                                    </div>

                                                    <button type="button" class="btn-add-product-submit"
                                                            @onclick="AddProductLine"
                                                            disabled="@(NewProductId <= 0 || NewProductQuantity <= 0)">
                                                        Add Product
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        <!-- PRODUCT LINES VENDOR SELECTION SECTION -->
                                        @if (ProductLines.Count == 0)
                                        {
                                            <div class="alloc-empty-notice">
                                                <div class="alloc-empty-title">No Products Added Yet</div>
                                                <div class="alloc-empty-desc">Choose a product and enter a planning quantity above to add it to the contract preparation list.</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="product-lines-container mb-4">
                                                @foreach (var line in ProductLines)
                                                {
                                                    var currentLine = line;
                                                    <div class="product-selection-card mb-3">
                                                        <!-- PRODUCT HEADER ROW -->
                                                        <div class="product-card-header">
                                                            <div class="product-header-title">
                                                                <span class="product-title-text">@currentLine.ProductName</span>
                                                                @if (!string.IsNullOrEmpty(currentLine.ProductCategory))
                                                                {
                                                                    <span class="badge-tag">@currentLine.ProductCategory.ToLowerInvariant()</span>
                                                                }
                                                                @if (currentLine.HasActiveContracts)
                                                                {
                                                                    <span class="badge-active-contract">Active Contract</span>
                                                                }
                                                            </div>

                                                            <div class="product-header-controls">
                                                                <div class="qty-field-wrap">
                                                                    <label class="qty-label-inline">Planning Qty:</label>
                                                                    <input type="number" step="1" min="1" class="line-qty-input"
                                                                           value="@currentLine.ContractQuantity"
                                                                           @onchange="@(e => { if (decimal.TryParse(e.Value?.ToString(), out var q)) OnProductQuantityChanged(currentLine, q); })" />
                                                                    <span class="qty-unit-inline">@currentLine.Unit</span>
                                                                </div>

                                                                <div class="sort-field-wrap">
                                                                    <label class="sort-label-inline">Sort By:</label>
                                                                    <div class="select-wrapper-custom sort-select-wrap">
                                                                        <select class="form-select-custom sort-select-custom"
                                                                                value="@currentLine.SortBy"
                                                                                @onchange="@(e => OnSortByChanged(currentLine, e.Value?.ToString()))">
                                                                            <option value="Overall Reviews">Overall Reviews</option>
                                                                            <option value="Unit Price">Unit Price</option>
                                                                        </select>
                                                                        <svg class="select-arrow-custom" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                            <polyline points="6 9 12 15 18 9"></polyline>
                                                                        </svg>
                                                                    </div>
                                                                </div>

                                                                @if (IsStandaloneMode)
                                                                {
                                                                    <button type="button" class="btn-remove-line"
                                                                            @onclick="() => RemoveProductLine(currentLine.ProductID)"
                                                                            title="Remove product line">
                                                                        Remove
                                                                    </button>
                                                                }
                                                            </div>
                                                        </div>

                                                        <!-- PRODUCT VENDOR SELECTION TABLE -->
                                                        <div class="product-card-body">
                                                            @if (currentLine.IsLoadingVendors)
                                                            {
                                                                <div class="product-loading-vendors">
                                                                    <span class="spinner-border spinner-border-sm text-success me-2" role="status"></span>
                                                                    <span>Loading eligible vendors for @currentLine.ProductName...</span>
                                                                </div>
                                                            }
                                                            else if (currentLine.EligibleVendors.Count == 0)
                                                            {
                                                                <div class="product-no-vendors">
                                                                    <span>No active suppliers found for this product.</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="product-vendor-table-wrap">
                                                                    <table class="product-vendor-table">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>VENDOR</th>
                                                                                <th>UNIT PRICE</th>
                                                                                <th>OVERALL REVIEW</th>
                                                                                <th class="text-end">ACTION</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var v in currentLine.GetSortedVendors())
                                                                            {
                                                                                var currentVendor = v;
                                                                                var isSelected = currentLine.SelectedVendorID == currentVendor.VendorID;
                                                                                <tr class="@(isSelected ? "vendor-row-selected" : "")">
                                                                                    <td>
                                                                                        <div class="vendor-name-cell">
                                                                                            <span class="vendor-title-bold">@currentVendor.VendorName</span>
                                                                                            @if (currentVendor.HasActiveContract)
                                                                                            {
                                                                                                <span class="badge-vendor-contract">Active Contract</span>
                                                                                            }
                                                                                        </div>
                                                                                    </td>
                                                                                    <td>
                                                                                        @if (currentVendor.UnitPrice > 0)
                                                                                        {
                                                                                            <span class="vendor-unit-price">Rs. @currentVendor.UnitPrice.ToString("N2") / @currentLine.Unit</span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span class="text-muted small">Not specified</span>
                                                                                        }
                                                                                    </td>
                                                                                    <td>
                                                                                        @if (currentVendor.AverageRating > 0 || currentVendor.TotalFeedbackCount > 0)
                                                                                        {
                                                                                            <span class="vendor-rating-text">
                                                                                                @currentVendor.AverageRating.ToString("0.0") / 5 (@currentVendor.TotalFeedbackCount @(currentVendor.TotalFeedbackCount == 1 ? "review" : "reviews"))
                                                                                            </span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span class="text-muted small">No reviews yet</span>
                                                                                        }
                                                                                    </td>
                                                                                    <td class="text-end">
                                                                                        <div class="vendor-action-buttons">
                                                                                            <button type="button" class="btn-vendor-reviews"
                                                                                                    @onclick="() => OpenVendorReviewsModal(currentVendor, currentLine.ProductID, currentLine.ProductName)"
                                                                                                    title="View verified customer reviews">
                                                                                                Reviews
                                                                                            </button>
                                                                                            @if (isSelected)
                                                                                            {
                                                                                                <button type="button" class="btn-vendor-selected"
                                                                                                        @onclick="() => SelectVendorForProductLine(currentLine, currentVendor)"
                                                                                                        title="Currently selected vendor (click to deselect)">
                                                                                                    Selected
                                                                                                </button>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <button type="button" class="btn-vendor-select"
                                                                                                        @onclick="() => SelectVendorForProductLine(currentLine, currentVendor)"
                                                                                                        title="Select vendor for this product">
                                                                                                    Select
                                                                                                </button>
                                                                                            }
                                                                                        </div>
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- GROUPING PREVIEW SECTION -->
                                        @if (ProductLines.Count > 0)
                                        {
                                            <div class="grouping-preview-section">
                                                <div class="preview-section-header">
                                                    <div class="preview-title-wrap">
                                                        <h4>Contract Grouping Preview</h4>
                                                        <p>One Contract will be generated per distinct vendor with all assigned products included.</p>
                                                    </div>
                                                    <div class="preview-summary-pills">
                                                        <span class="preview-pill preview-pill-contracts">
                                                            @GroupedContracts.Count @(GroupedContracts.Count == 1 ? "Contract" : "Contracts") to create
                                                        </span>
                                                        <span class="preview-pill preview-pill-vendors">
                                                            @GroupedContracts.Count @(GroupedContracts.Count == 1 ? "Vendor" : "Vendors") involved
                                                        </span>
                                                        <span class="preview-pill preview-pill-products">
                                                            @ProductLines.Count @(ProductLines.Count == 1 ? "Product" : "Products")
                                                        </span>
                                                    </div>
                                                </div>

                                                @if (UnassignedProductsCount > 0)
                                                {
                                                    <div class="warning-banner mb-3 py-2 px-3">
                                                        <div class="warning-banner-content small">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                            </svg>
                                                            <span>@UnassignedProductsCount product(s) still require an assigned vendor to be grouped into a contract.</span>
                                                        </div>
                                                    </div>
                                                }

                                                <div class="vendor-groups-grid">
                                                    @{ int contractIndex = 1; }
                                                    @foreach (var group in GroupedContracts)
                                                    {
                                                        <div class="vendor-group-card">
                                                            <div>
                                                                <div class="group-card-header">
                                                                    <span class="group-vendor-title">@group.VendorName</span>
                                                                    <span class="group-contract-tag">Contract #@contractIndex</span>
                                                                </div>

                                                                <ul class="group-products-list">
                                                                    @foreach (var prod in group.Products)
                                                                    {
                                                                        <li class="group-product-item">
                                                                            <span class="group-product-name">@prod.ProductName</span>
                                                                            <span class="group-product-qty">@prod.ContractQuantity.ToString("N2") @prod.Unit</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>

                                                            <div class="group-card-footer">
                                                                <span>Total Reference Quantity</span>
                                                                <span class="group-card-total">@group.TotalQuantity.ToString("N2") Units</span>
                                                            </div>
                                                        </div>
                                                        contractIndex++;
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- VALIDATION STATUS BANNER -->
                                        <div class="validation-status-card @(CanSubmit ? "valid-card" : "invalid-card")">
                                            <div class="status-icon-circle">
                                                @if (CanSubmit)
                                                {
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                        <polyline points="20 6 9 17 4 12"></polyline>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                                    </svg>
                                                }
                                            </div>
                                            <div class="status-text-content">
                                                @if (CanSubmit)
                                                {
                                                    <span><strong>Ready:</strong> All @ProductLines.Count product(s) have assigned eligible vendors with planning quantities. @GroupedContracts.Count contract(s) will be created.</span>
                                                }
                                                else if (ProductLines.Count == 0)
                                                {
                                                    <span><strong>Notice:</strong> Please add at least one product to the contract preparation list.</span>
                                                }
                                                else if (UnassignedProductsCount > 0)
                                                {
                                                    <span><strong>Notice:</strong> Please select an eligible vendor for each product in the table.</span>
                                                }
                                                else if (ProductLines.Any(p => p.ContractQuantity <= 0))
                                                {
                                                    <span><strong>Notice:</strong> Planning quantity for each product must be greater than zero.</span>
                                                }
                                                else if (EndDate <= StartDate)
                                                {
                                                    <span><strong>Notice:</strong> End date must be after the start date.</span>
                                                }
                                                else
                                                {
                                                    <span><strong>Notice:</strong> Please complete all required specifications.</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- SUBMIT BUTTON -->
                                        <button type="button" class="btn-submit-contract"
                                                @onclick="SubmitContractCreation"
                                                disabled="@(!CanSubmit)">
                                            @if (IsProcessing)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                <span>CREATING CONTRACTS...</span>
                                            }
                                            else
                                            {
                                                <span>CREATE CONTRACTS</span>
                                            }
                                        </button>
                                    }

                                </div>
                            </div>

                        </div>

                        <!-- =======================================================
                             CUSTOMER REVIEWS & QUALITY DETAILS MODAL OVERLAY
                             ======================================================= -->
                        @if (IsReviewsModalOpen && SelectedVendorForReviews != null)
                        {
                            <div class="custom-modal-backdrop" @onclick="CloseVendorReviewsModal"></div>
                            <div class="custom-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="reviewsModalTitle">
                                <div class="custom-modal-content">
                                    <!-- MODAL HEADER -->
                                    <div class="custom-modal-header d-flex align-items-start justify-content-between p-4 border-bottom">
                                        <div>
                                            <h3 id="reviewsModalTitle" class="custom-modal-title mb-1 fw-bold text-dark fs-5">Customer Reviews &amp; Quality Details</h3>
                                            <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                                <span class="fs-6 fw-bold text-dark">@SelectedVendorForReviews.VendorName</span>
                                                <span class="text-muted">&bull;</span>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded fw-semibold">
                                                    @(string.IsNullOrWhiteSpace(SelectedProductForReviewsName) ? "Selected Product" : SelectedProductForReviewsName)
                                                </span>
                                            </div>
                                            <p class="custom-modal-subtitle text-muted small mt-1 mb-0">Verified feedback from completed purchase orders</p>
                                        </div>
                                        <button type="button" class="btn-modal-close" @onclick="CloseVendorReviewsModal" title="Close">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </div>

                                    <!-- MODAL BODY -->
                                    <div class="custom-modal-body p-4">
                                        @if (IsLoadingVendorReviews)
                                        {
                                            <div class="modal-loading-state text-center py-5">
                                                <div class="spinner-border text-success mb-3" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                                                <div class="fw-bold text-dark fs-6">Loading verified reviews...</div>
                                                <div class="small text-muted mt-1">Fetching feedback records for @SelectedVendorForReviews.VendorName</div>
                                            </div>
                                        }
                                        else if (CurrentVendorReviews.Count == 0)
                                        {
                                            <div class="modal-empty-state text-center py-5">
                                                <div class="empty-reviews-icon mx-auto mb-3">
                                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                                    </svg>
                                                </div>
                                                <h4 class="fw-bold text-dark mb-1">No Reviews Yet</h4>
                                                <p class="text-muted small mb-4" style="max-width: 440px; margin: 0 auto;">
                                                    There are no verified customer reviews for <strong>@SelectedVendorForReviews.VendorName</strong> supplying <strong>@(string.IsNullOrWhiteSpace(SelectedProductForReviewsName) ? "this product" : SelectedProductForReviewsName)</strong> yet.
                                                </p>
                                                <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold px-4 py-1.5" @onclick="CloseVendorReviewsModal">
                                                    Back to Contract Creation
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- SUMMARY METRICS CARDS -->
                                            <div class="row g-3 mb-4">
                                                <div class="col-md-4">
                                                    <div class="review-stat-card p-3 h-100 rounded border">
                                                        <div class="stat-card-label text-muted small fw-bold">AVERAGE RATING</div>
                                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                                            <span class="fs-2 fw-bold text-success">@CurrentVendorAvgRating.ToString("0.0")</span>
                                                            <span class="text-muted fw-normal">/ 5.0</span>
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold ms-1">
                                                                @GetQualitativeRatingText(CurrentVendorAvgRating)
                                                            </span>
                                                        </div>
                                                        <div class="small text-muted mt-1">
                                                            Based on <strong>@CurrentVendorReviews.Count</strong> @(CurrentVendorReviews.Count == 1 ? "verified review" : "verified reviews")
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="review-stat-card p-3 h-100 rounded border">
                                                        <div class="stat-card-label text-muted small fw-bold">QUALITY RATING</div>
                                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                                            <span class="fs-2 fw-bold text-dark">@(CurrentVendorAvgQuality > 0 ? CurrentVendorAvgQuality.ToString("0.0") : "5.0")</span>
                                                            <span class="text-muted fw-normal">/ 5.0</span>
                                                        </div>
                                                        <div class="small text-muted mt-1">Average Product Quality Score</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="review-stat-card p-3 h-100 rounded border">
                                                        <div class="stat-card-label text-muted small fw-bold">DELIVERY RATING</div>
                                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                                            <span class="fs-2 fw-bold text-dark">@(CurrentVendorAvgDelivery > 0 ? CurrentVendorAvgDelivery.ToString("0.0") : "5.0")</span>
                                                            <span class="text-muted fw-normal">/ 5.0</span>
                                                        </div>
                                                        <div class="small text-muted mt-1">Average Delivery Punctuality Score</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- LATEST REVIEW HIGHLIGHT SECTION -->
                                            @if (LatestReviewInModal != null)
                                            {
                                                var latest = LatestReviewInModal;
                                                <div class="latest-review-panel p-4 mb-4 border border-success-subtle rounded bg-white shadow-sm">
                                                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="badge bg-success text-white px-2.5 py-1 fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                                                Latest Review
                                                            </span>
                                                            <span class="text-dark fw-bold fs-6">Rating:</span>
                                                            <span class="text-success fw-bold fs-5">@latest.Rating.ToString("0.0") / 5.0</span>
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle small fw-semibold">(@GetQualitativeRatingText(latest.Rating))</span>
                                                        </div>
                                                        <div class="small text-muted">
                                                            @latest.FeedbackDate.ToIst("MMMM dd, yyyy")
                                                        </div>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(latest.Review))
                                                    {
                                                        <blockquote class="latest-review-quote p-3 rounded mb-3">
                                                            &ldquo;@latest.Review&rdquo;
                                                        </blockquote>
                                                    }

                                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-2 border-top border-light-subtle text-muted small">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="review-avatar">
                                                                @(string.IsNullOrWhiteSpace(latest.RatedByUserName) ? "M" : latest.RatedByUserName.Substring(0, 1).ToUpperInvariant())
                                                            </div>
                                                            <div>
                                                                <span class="text-dark fw-semibold">Reviewed by:</span>
                                                                <span class="text-dark fw-bold ms-1">@(string.IsNullOrWhiteSpace(latest.RatedByUserName) ? "Purchase Manager" : latest.RatedByUserName)</span>
                                                                <span class="text-muted small ms-2">&bull; <span class="fw-semibold text-dark">Outlet:</span> @ResolveReviewOutletName(latest)</span>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-3">
                                                            @if (latest.ProductQualityRating > 0)
                                                            {
                                                                <span>Quality: <strong class="text-dark">@latest.ProductQualityRating.ToString("0.0") / 5.0</strong></span>
                                                            }
                                                            @if (latest.DeliveryRating > 0)
                                                            {
                                                                <span>Delivery: <strong class="text-dark">@latest.DeliveryRating.ToString("0.0") / 5.0</strong></span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <!-- REVIEW HISTORY SECTION -->
                                            <div class="review-history-panel p-4 rounded border bg-white mb-2">
                                                <div class="d-flex align-items-center justify-content-between mb-3">
                                                    <div>
                                                        <h5 class="fw-bold text-dark mb-0">Review History</h5>
                                                        <p class="text-muted small mb-0">All verified feedback records ordered newest-first</p>
                                                    </div>
                                                    <span class="badge bg-light text-dark border px-2.5 py-1">@CurrentVendorReviews.Count Total</span>
                                                </div>

                                                <div class="review-cards-list d-flex flex-column gap-3">
                                                    @foreach (var rev in CurrentVendorReviews)
                                                    {
                                                        <div class="single-review-card p-3 rounded border">
                                                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <span class="text-success fw-bold fs-6">@rev.Rating.ToString("0.0") / 5.0</span>
                                                                    <span class="badge bg-light text-dark border small fw-normal">@GetQualitativeRatingText(rev.Rating)</span>
                                                                </div>
                                                                <div class="text-muted small">
                                                                    @rev.FeedbackDate.ToIst("MMM dd, yyyy")
                                                                </div>
                                                            </div>

                                                            <div class="row g-2 small text-muted mb-2">
                                                                <div class="col-sm-6">
                                                                    <span class="fw-semibold text-dark">Reviewed by:</span> @(string.IsNullOrWhiteSpace(rev.RatedByUserName) ? "Purchase Manager" : rev.RatedByUserName)
                                                                </div>
                                                                <div class="col-sm-6 text-sm-end">
                                                                    <span class="fw-semibold text-dark">Outlet:</span> @ResolveReviewOutletName(rev)
                                                                </div>
                                                                <div class="col-sm-6">
                                                                    <span class="fw-semibold text-dark">Product:</span> @(string.IsNullOrWhiteSpace(rev.ProductName) ? SelectedProductForReviewsName : rev.ProductName)
                                                                </div>
                                                                <div class="col-sm-6 text-sm-end">
                                                                    @if (rev.ProductQualityRating > 0 || rev.DeliveryRating > 0)
                                                                    {
                                                                        <span class="me-3">Quality: <strong class="text-dark">@rev.ProductQualityRating.ToString("0.0") / 5.0</strong></span>
                                                                        <span>Delivery: <strong class="text-dark">@rev.DeliveryRating.ToString("0.0") / 5.0</strong></span>
                                                                    }
                                                                </div>
                                                            </div>

                                                            @if (!string.IsNullOrWhiteSpace(rev.Review))
                                                            {
                                                                <div class="review-card-comment p-2.5 rounded bg-light mt-2 small text-dark">
                                                                    &ldquo;@rev.Review&rdquo;
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted small mt-1">
                                                                    — No comment provided with this rating —
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <!-- MODAL FOOTER -->
                                    <div class="custom-modal-footer p-3 border-top d-flex justify-content-end">
                                        <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold px-4 py-1.5" @onclick="CloseVendorReviewsModal">
                                            Close
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </main>
        </div>
    </div>
}
