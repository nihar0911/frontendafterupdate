@page "/procurement"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Purchase Requests - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="container py-5">
        <div class="alert alert-warning text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as a Purchase Manager to access purchase requests.</p>
            <button class="btn btn-primary fw-bold px-4" @onclick='() => Nav.NavigateTo("/purchase-manager/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsPurchaseManager && !Auth.IsAdmin)
{
    <div class="container py-5">
        <div class="alert alert-danger text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-3">You do not have Purchase Manager privileges to access this portal.</p>
            <button class="btn btn-outline-secondary fw-bold px-4" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="pm-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">

        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION (DARK GREEN #174F45)
             ======================================================================= -->
        <aside class="pm-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                    <div class="brand-emblem">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">PROCUREMENT</span>
                        <span class="brand-sub">MANAGEMENT</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <!-- MAIN -->
                <div class="nav-section-title">MAIN</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>
                </ul>

                <!-- PROCUREMENT -->
                <div class="nav-section-title">PROCUREMENT</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link active" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Vendor Quotations</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Deliveries</span>
                        </button>
                    </li>
                </ul>

                <!-- FINANCE -->
                <div class="nav-section-title">FINANCE</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/invoices")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Invoices &amp; Billing</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/payments")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                    <line x1="1" y1="10" x2="23" y2="10"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Payments &amp; Settlements</span>
                        </button>
                    </li>
                </ul>

                <!-- VENDOR MANAGEMENT -->
                <div class="nav-section-title">VENDOR MANAGEMENT</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/vendor-performance")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Vendor Performance</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/vendor-performance")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Vendor Feedback</span>
                        </button>
                    </li>
                </ul>

                <!-- ACCOUNT -->
                <div class="nav-section-account">
                    <div class="nav-section-title">ACCOUNT</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <button class="sidebar-nav-link" @onclick="OpenProfileModal">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </span>
                                <span class="nav-label">My Profile</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="sidebar-nav-link" @onclick="HandleLogout">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                </span>
                                <span class="nav-label">Logout</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- =======================================================================
             MAIN WRAPPER & TOPBAR
             ======================================================================= -->
        <div class="pm-main-wrapper">
            <!-- Topbar -->
            <header class="pm-topbar">
                <div class="topbar-left">
                    <button class="topbar-menu-toggle" @onclick="ToggleSidebar" title="Toggle Sidebar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <h1 class="topbar-title">Purchase Manager Portal</h1>
                </div>

                <div class="topbar-right">
                    <!-- Notifications -->
                    <div class="notification-wrapper">
                        <button class="notification-btn" @onclick="ToggleNotifications" title="Notifications">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            @if (UnreadNotificationCount > 0)
                            {
                                <span class="notification-badge">@UnreadNotificationCount</span>
                            }
                        </button>

                        @if (ShowNotificationDropdown)
                        {
                            <div class="notification-dropdown">
                                <div class="dropdown-header">
                                    <span>Notifications</span>
                                    <span class="badge bg-light text-dark">@UnreadNotificationCount unread</span>
                                </div>
                                <div class="dropdown-list">
                                    @if (Notifications.Count == 0)
                                    {
                                        <div class="p-3 text-center text-muted small">No notifications</div>
                                    }
                                    else
                                    {
                                        @foreach (var n in Notifications)
                                        {
                                            <div class="dropdown-item-notif @(!n.IsRead ? "unread" : "")" @onclick="() => MarkNotificationRead(n.NotificationID)">
                                                <div class="notif-text">@n.Message</div>
                                                <div class="notif-time">@n.CreatedDate.ToIst("dd MMM yyyy, hh:mm tt")</div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="profile-wrapper">
                        <button class="profile-pill-btn" @onclick="ToggleProfileDropdown">
                            <div class="profile-avatar">@UserInitial</div>
                            <div class="profile-info">
                                <span class="profile-name">@Auth.UserName</span>
                                <span class="profile-role">Purchase Manager</span>
                            </div>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>

                        @if (IsProfileDropdownOpen)
                        {
                            <div class="profile-dropdown-menu">
                                <button class="profile-menu-item" @onclick="OpenProfileModal">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <span>My Profile</span>
                                </button>
                                <button class="profile-menu-item logout" @onclick="HandleLogout">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    <span>Logout</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <main class="pm-page-container">

                @if (IsReviewsModalOpen && SelectedVendorForReviews != null)
                {
                    <!-- =======================================================
                         DEDICATED VENDOR REVIEWS PAGE VIEW
                         ======================================================= -->
                    <div class="vendor-reviews-page mb-4">
                        <!-- Navigation & Page Header -->
                        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                            <div>
                                <button type="button" class="btn-back-link" @onclick="CloseVendorReviewsModal">
                                    &larr; Back to Vendor Recommendations
                                </button>
                                <h2 class="greeting-title mt-2">Customer Reviews</h2>
                                <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                    <span class="fs-5 fw-bold text-dark">@SelectedVendorForReviews.VendorName</span>
                                    <span class="text-muted">&bull;</span>
                                    <span class="fs-6 text-success fw-semibold bg-success-subtle px-2.5 py-0.5 rounded border border-success-subtle">
                                        @(SelectedProduct?.ProductName ?? SelectedVendorForReviews.ProductName)
                                    </span>
                                </div>
                                <p class="greeting-subtitle mt-1">Verified feedback from completed purchase orders</p>
                            </div>
                            <div>
                                <button type="button" class="btn btn-outline-secondary fw-semibold px-3 py-1.5" @onclick="CloseVendorReviewsModal">
                                    &larr; Back to Vendor Recommendations
                                </button>
                            </div>
                        </div>

                        @if (IsLoadingVendorReviews)
                        {
                            <div class="pm-panel p-5 text-center text-muted mb-4">
                                <div class="spinner-border text-success mb-3" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                                <div class="fs-6 fw-semibold text-dark">Loading verified reviews...</div>
                                <div class="small text-muted mt-1">Fetching feedback records for @SelectedVendorForReviews.VendorName</div>
                            </div>
                        }
                        else if (CurrentVendorReviews.Count == 0)
                        {
                            <!-- Empty State -->
                            <div class="pm-panel p-5 text-center mb-4">
                                <div class="empty-reviews-icon mx-auto mb-3">
                                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                </div>
                                <h4 class="fw-bold text-dark mb-1">No Reviews Yet</h4>
                                <p class="text-muted small mb-4" style="max-width: 440px; margin: 0 auto;">
                                    There are no verified customer reviews for <strong>@SelectedVendorForReviews.VendorName</strong> supplying <strong>@(SelectedProduct?.ProductName ?? SelectedVendorForReviews.ProductName)</strong> yet.
                                </p>
                                <button type="button" class="btn-primary-action px-4 py-2" @onclick="CloseVendorReviewsModal">
                                    &larr; Back to Vendor Recommendations
                                </button>
                            </div>
                        }
                        else
                        {
                            <!-- SUMMARY METRICS CARDS -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="review-stat-card p-3 h-100">
                                        <div class="stat-card-label">AVERAGE RATING</div>
                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                            <span class="fs-2 fw-bold text-success">★ @CurrentVendorAvgRating.ToString("0.0")</span>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                                @GetQualitativeRatingText(CurrentVendorAvgRating)
                                            </span>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            Based on <strong>@CurrentVendorReviews.Count</strong> @(CurrentVendorReviews.Count == 1 ? "verified review" : "verified reviews")
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="review-stat-card p-3 h-100">
                                        <div class="stat-card-label">QUALITY RATING</div>
                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                            <span class="fs-2 fw-bold text-dark">★ @(CurrentVendorAvgQuality > 0 ? CurrentVendorAvgQuality.ToString("0.0") : "5.0")</span>
                                            <span class="small text-muted">/ 5.0</span>
                                        </div>
                                        <div class="small text-muted mt-1">Average Product Quality Score</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="review-stat-card p-3 h-100">
                                        <div class="stat-card-label">DELIVERY RATING</div>
                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                            <span class="fs-2 fw-bold text-dark">★ @(CurrentVendorAvgDelivery > 0 ? CurrentVendorAvgDelivery.ToString("0.0") : "5.0")</span>
                                            <span class="small text-muted">/ 5.0</span>
                                        </div>
                                        <div class="small text-muted mt-1">Average Delivery Punctuality Score</div>
                                    </div>
                                </div>
                            </div>

                            <!-- LATEST REVIEW HIGHLIGHT SECTION -->
                            @if (LatestReviewInModal != null)
                            {
                                var latest = LatestReviewInModal;
                                <div class="pm-panel p-4 mb-4 border-success-subtle bg-white shadow-sm">
                                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-success text-white px-2.5 py-1 fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                                Latest Review
                                            </span>
                                            <span class="text-success fw-bold fs-5">@GetStarString(latest.Rating) @latest.Rating.ToString("0.0")</span>
                                            <span class="text-muted small fw-semibold">(@GetQualitativeRatingText(latest.Rating))</span>
                                        </div>
                                        <div class="small text-muted">
                                            @latest.FeedbackDate.ToIst("MMMM dd, yyyy")
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(latest.Review))
                                    {
                                        <blockquote class="latest-review-quote p-3 rounded mb-3">
                                            &ldquo;@latest.Review&rdquo;
                                        </blockquote>
                                    }

                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-2 border-top border-light-subtle text-muted small">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="review-avatar">
                                                @(string.IsNullOrWhiteSpace(latest.RatedByUserName) ? "M" : latest.RatedByUserName.Substring(0, 1).ToUpperInvariant())
                                            </div>
                                            <div>
                                                <span class="text-dark fw-bold">Reviewed by @(string.IsNullOrWhiteSpace(latest.RatedByUserName) ? "Purchase Manager" : latest.RatedByUserName)</span>
                                                <span class="text-muted small ms-1">&bull; Outlet: @latest.OutletName</span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (latest.ProductQualityRating > 0)
                                            {
                                                <span>Quality: <strong class="text-dark">★ @latest.ProductQualityRating.ToString("0.0")</strong></span>
                                            }
                                            @if (latest.DeliveryRating > 0)
                                            {
                                                <span>Delivery: <strong class="text-dark">★ @latest.DeliveryRating.ToString("0.0")</strong></span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- REVIEW HISTORY SECTION -->
                            <div class="pm-panel p-4 mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div>
                                        <h4 class="fw-bold text-dark mb-0">Review History</h4>
                                        <p class="text-muted small mb-0">All verified feedback records ordered newest-first</p>
                                    </div>
                                    <span class="badge bg-light text-dark border px-2.5 py-1">@CurrentVendorReviews.Count Total</span>
                                </div>

                                <div class="review-cards-list d-flex flex-column gap-3">
                                    @foreach (var rev in CurrentVendorReviews)
                                    {
                                        <div class="single-review-card p-3 rounded border">
                                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="text-success fw-bold fs-6">@GetStarString(rev.Rating) @rev.Rating.ToString("0.0")</span>
                                                    <span class="badge bg-light text-dark border small fw-normal">@GetQualitativeRatingText(rev.Rating)</span>
                                                </div>
                                                <div class="text-muted small">
                                                    @rev.FeedbackDate.ToIst("MMM dd, yyyy")
                                                </div>
                                            </div>

                                            <div class="row g-2 small text-muted mb-2">
                                                <div class="col-sm-6">
                                                    <span class="fw-semibold text-dark">Reviewed by:</span> @(string.IsNullOrWhiteSpace(rev.RatedByUserName) ? "Purchase Manager" : rev.RatedByUserName)
                                                </div>
                                                <div class="col-sm-6 text-sm-end">
                                                    <span class="fw-semibold text-dark">Outlet:</span> @rev.OutletName
                                                </div>
                                                <div class="col-sm-6">
                                                    <span class="fw-semibold text-dark">Product:</span> @(string.IsNullOrWhiteSpace(rev.ProductName) ? (SelectedProduct?.ProductName ?? "General Product") : rev.ProductName)
                                                </div>
                                                <div class="col-sm-6 text-sm-end">
                                                    @if (rev.ProductQualityRating > 0 || rev.DeliveryRating > 0)
                                                    {
                                                        <span class="me-2">Quality: <strong class="text-dark">★ @rev.ProductQualityRating.ToString("0.0")</strong></span>
                                                        <span>Delivery: <strong class="text-dark">★ @rev.DeliveryRating.ToString("0.0")</strong></span>
                                                    }
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(rev.Review))
                                            {
                                                <div class="review-card-comment p-2.5 rounded bg-light mt-2 small text-dark">
                                                    &ldquo;@rev.Review&rdquo;
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small fst-italic mt-1">
                                                    — No comment provided with this rating —
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (!IsCreateMode)
                {
                    <!-- =======================================================
                         PURCHASE REQUESTS LANDING PAGE & LIST TABLE
                         ======================================================= -->
                    <div class="pm-header-banner">
                        <div>
                            <h2 class="greeting-title">Purchase Requests</h2>
                            <p class="greeting-subtitle">Create, manage and dispatch purchase requests to vendors.</p>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="outlet-badge-card">
                                <div class="outlet-badge-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                </div>
                                <div class="outlet-badge-text">
                                    <span class="outlet-name-label">@ConfirmedOutletName</span>
                                    <span class="org-name-sub">@OrganizationName</span>
                                </div>
                            </div>
                            <button class="btn-primary-action" @onclick="StartCreateRequest">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Create Purchase Request</span>
                            </button>
                        </div>
                    </div>

                    <!-- Search & Filter Controls -->
                    <div class="pm-panel mb-4">
                        <div class="p-3 d-flex align-items-center justify-content-between gap-3 flex-wrap">
                            <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 400px;">
                                <div class="search-input-box">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                    <input type="text" class="search-control" placeholder="Search by PR code, product..." @bind="SearchListQuery" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <label class="small text-muted fw-semibold">Status:</label>
                                <select class="form-select form-select-sm" style="width: 160px; border-radius: 6px;" @bind="StatusFilter">
                                    <option value="All">All Statuses</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Submitted">Submitted</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Dispatched">Dispatched</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Purchase Requests Data Table -->
                    <div class="pm-panel">
                        <div class="panel-header">
                            <div class="panel-title-wrap">
                                <h3 class="panel-title">Request Records (@FilteredPurchaseRequests.Count)</h3>
                                <p class="panel-subtitle">All purchase requests registered for your assigned outlet</p>
                            </div>
                        </div>

                        @if (IsLoadingList)
                        {
                            <div class="p-5 text-center text-muted">
                                <div class="spinner-border text-success mb-2" role="status" style="width: 2.5rem; height: 2.5rem; color: #174F45 !important;"></div>
                                <p class="small fw-semibold">Loading purchase requests...</p>
                            </div>
                        }
                        else if (HasListError)
                        {
                            <div class="alert alert-danger m-4">
                                Failed to load purchase requests. <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadInitialDataAsync">Retry</button>
                            </div>
                        }
                        else if (FilteredPurchaseRequests.Count == 0)
                        {
                            <div class="p-5 text-center text-muted">
                                <div class="mb-3">
                                    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                    </svg>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">No Purchase Requests Found</h5>
                                <p class="small mb-3">You have not created any purchase requests for this outlet yet.</p>
                                <button class="btn-primary-action" @onclick="StartCreateRequest">+ Create Purchase Request</button>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="pm-table">
                                    <thead>
                                        <tr>
                                            <th>PR REFERENCE</th>
                                            <th>PRODUCT &amp; ITEMS</th>
                                            <th>QUANTITY</th>
                                            <th>OUTLET</th>
                                            <th>CREATED DATE</th>
                                            <th>STATUS</th>
                                            <th>VENDORS / QUOTATIONS</th>
                                            <th>ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pr in FilteredPurchaseRequests)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="ref-pill">PR-@pr.RequestID</span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark">@GetPrProductDisplay(pr)</div>
                                                    <div class="small text-muted">Created by: @(!string.IsNullOrWhiteSpace(pr.CreatedByName) ? pr.CreatedByName : "Outlet Staff")</div>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">@GetPrQuantityDisplay(pr)</span>
                                                </td>
                                                <td>
                                                    <span class="small">@(string.IsNullOrWhiteSpace(pr.OutletName) ? ConfirmedOutletName : pr.OutletName)</span>
                                                </td>
                                                <td>
                                                    <span class="small text-muted">@pr.RequestDate.ToIst("MMM dd, yyyy")</span>
                                                </td>
                                                <td>
                                                    <span class="@GetStatusBadgeClass(pr.Status)">@pr.Status</span>
                                                </td>
                                                <td>
                                                    <span class="small text-secondary">@GetPrVendorDisplay(pr)</span>
                                                </td>
                                                <td>
                                                    <button class="btn-action-table" @onclick='() => Nav.NavigateTo($"/purchase-request/{pr.RequestID}")'>
                                                        View &rarr;
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- =======================================================
                         4-STEP PURCHASE REQUEST CREATION WIZARD
                         ======================================================= -->
                    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                        <div>
                            <button type="button" class="btn-back-link" @onclick="CancelCreateRequest">
                                &larr; Back to Purchase Requests
                            </button>
                            <h2 class="greeting-title mt-2">Create Purchase Request</h2>
                            <p class="greeting-subtitle">Follow the 4 steps to configure and dispatch request directly to vendors.</p>
                        </div>
                    </div>

                    <!-- STEP PROGRESS INDICATOR -->
                    <div class="wizard-steps-container mb-4">
                        <div class="wizard-step @(CurrentStep == 1 ? "active" : (CurrentStep > 1 ? "completed" : ""))" @onclick="() => GoBackToStep(1)">
                            <div class="step-badge">1</div>
                            <div class="step-text">
                                <span class="step-title">Assigned Outlet</span>
                                <span class="step-sub">@ConfirmedOutletName</span>
                            </div>
                        </div>
                        <div class="step-divider"></div>
                        <div class="wizard-step @(CurrentStep == 2 ? "active" : (CurrentStep > 2 ? "completed" : ""))" @onclick="() => { if (CurrentStep > 2) GoBackToStep(2); }">
                            <div class="step-badge">2</div>
                            <div class="step-text">
                                <span class="step-title">Select Product</span>
                                <span class="step-sub">@(SelectedProduct != null ? SelectedProduct.ProductName : "Choose Item")</span>
                            </div>
                        </div>
                        <div class="step-divider"></div>
                        <div class="wizard-step @(CurrentStep == 3 ? "active" : (CurrentStep > 3 ? "completed" : ""))" @onclick="() => { if (CurrentStep > 3) GoBackToStep(3); }">
                            <div class="step-badge">3</div>
                            <div class="step-text">
                                <span class="step-title">Quantity &amp; Vendors</span>
                                <span class="step-sub">@(QuantityInput.HasValue ? $"{QuantityInput} {SelectedProduct?.Unit}" : "Recommendations")</span>
                            </div>
                        </div>
                        <div class="step-divider"></div>
                        <div class="wizard-step @(CurrentStep == 4 ? "active" : "")">
                            <div class="step-badge">4</div>
                            <div class="step-text">
                                <span class="step-title">Review &amp; Dispatch</span>
                                <span class="step-sub">Direct Send</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(DispatchSuccessMessage) && CreatedPurchaseRequest != null)
                    {
                        <!-- SUCCESS CONFIRMATION STATE -->
                        var primaryVendor = SelectedVendors.FirstOrDefault();
                        string primaryVendorName = primaryVendor?.VendorName ?? "Selected Vendor";

                        <div class="pm-panel p-5 text-center mb-4">
                            <div class="success-icon-circle mx-auto mb-3">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <h3 class="fw-bold text-dark mb-2">Purchase Request PR-@CreatedPurchaseRequest.RequestID Created &amp; Dispatched!</h3>
                            <p class="text-muted mb-4" style="max-width: 600px; margin: 0 auto;">
                                Your purchase request has been officially dispatched to <strong>@primaryVendorName</strong>. The respective vendor manager has received the request and can now submit quotations.
                            </p>

                            <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
                                <button class="btn-primary-action" @onclick='() => Nav.NavigateTo($"/purchase-request/{CreatedPurchaseRequest.RequestID}")'>
                                    View Purchase Request &rarr;
                                </button>
                                <button class="btn btn-outline-success fw-bold px-4 py-2" @onclick="StartCreateRequest">
                                    + Create Another Request
                                </button>
                                <button class="btn btn-outline-secondary fw-semibold px-4 py-2" @onclick="CancelCreateRequest">
                                    Back to Requests List
                                </button>
                                <button class="btn btn-outline-secondary fw-semibold px-4 py-2" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                                    Return to Dashboard
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (CurrentStep == 1)
                        {
                            <!-- STEP 1: ASSIGNED OUTLET -->
                            <div class="pm-panel p-4 mb-4">
                                <h4 class="fw-bold text-dark mb-1">Step 1: Confirm Assigned Outlet</h4>
                                <p class="text-muted small mb-4">Purchase Requests are automatically scoped to your assigned outlet branch.</p>

                                <div class="assigned-outlet-box p-4 mb-4">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="outlet-badge-icon" style="width: 44px; height: 44px;">
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                    <circle cx="12" cy="10" r="3"></circle>
                                                </svg>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold text-dark mb-0">@ConfirmedOutletName</h5>
                                                <span class="small text-muted">@OrganizationName &bull; @OutletAddress</span>
                                            </div>
                                        </div>
                                        <span class="badge bg-success px-3 py-2">Assigned &amp; Verified</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(ValidationMessage))
                                {
                                    <div class="alert alert-danger p-3 mb-3">@ValidationMessage</div>
                                }

                                <div class="d-flex justify-content-end">
                                    <button class="btn-primary-action px-4 py-2" @onclick="GoToStep2Product">
                                        Continue to Product Selection &rarr;
                                    </button>
                                </div>
                            </div>
                        }
                        else if (CurrentStep == 2)
                        {
                            <!-- STEP 2: SELECT PRODUCT -->
                            <div class="pm-panel p-4 mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                    <div>
                                        <h4 class="fw-bold text-dark mb-1">Step 2: Select a Product to Procure</h4>
                                        <p class="text-muted small mb-0">Search and pick the item required for @ConfirmedOutletName</p>
                                    </div>
                                    <div class="search-input-box" style="max-width: 320px;">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        </svg>
                                        <input type="text" class="search-control" placeholder="Search product or category..." @bind="SearchProductQuery" @bind:event="oninput" />
                                    </div>
                                </div>

                                @if (IsLoadingProducts)
                                {
                                    <div class="text-center py-5 text-muted">
                                        <div class="spinner-border text-success mb-2" role="status"></div>
                                        <p class="small">Loading product catalog...</p>
                                    </div>
                                }
                                else if (FilteredProducts.Count == 0)
                                {
                                    <div class="text-center py-5 text-muted">
                                        <p class="mb-0">No matching products found.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="product-selection-grid mb-4">
                                        @foreach (var prod in FilteredProducts)
                                        {
                                            <div class="product-card-selectable @(SelectedProduct?.ProductID == prod.ProductID ? "selected" : "")" @onclick="() => SelectProduct(prod)">
                                                <div class="d-flex align-items-start justify-content-between mb-2">
                                                    <div>
                                                        <h5 class="fw-bold text-dark mb-1">@prod.ProductName</h5>
                                                        <span class="small text-muted">Category: @(string.IsNullOrWhiteSpace(prod.Category) ? "General" : prod.Category)</span>
                                                    </div>
                                                    <span class="badge bg-light text-dark border">@prod.Unit</span>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-outline-success w-100 fw-bold mt-2">
                                                    Select Item &rarr;
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="d-flex justify-content-between pt-3 border-top">
                                    <button class="btn btn-outline-secondary fw-semibold px-4" @onclick="() => GoBackToStep(1)">
                                        &larr; Back
                                    </button>
                                </div>
                            </div>
                        }
                        else if (CurrentStep == 3 && SelectedProduct != null)
                        {
                            <!-- STEP 3: QUANTITY & VENDOR RECOMMENDATIONS -->
                            <div class="pm-panel p-4 mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="outlet-badge-icon">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <span class="small text-muted text-uppercase fw-bold">Selected Item</span>
                                            <h5 class="fw-bold text-dark mb-0">@SelectedProduct.ProductName &bull; <span class="text-muted fw-normal">Unit: @SelectedProduct.Unit</span></h5>
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary fw-semibold" @onclick="() => GoBackToStep(2)">Change Product</button>
                                </div>

                                <!-- Quantity Input -->
                                <div class="quantity-card-box p-3 mb-4">
                                    <label class="fw-bold text-dark mb-2">Required Quantity</label>
                                    <div class="d-flex align-items-center gap-2" style="max-width: 250px;">
                                        <input type="number" class="form-control fw-bold" @bind="QuantityInput" @bind:after="OnQuantityChanged" min="0.01" step="any" placeholder="Enter quantity" />
                                        <span class="input-group-text fw-bold">@SelectedProduct.Unit</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(QuantityValidationMessage))
                                    {
                                        <div class="text-danger small mt-1">@QuantityValidationMessage</div>
                                    }
                                </div>

                                <!-- Vendor Recommendations Header & Sort Controls -->
                                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-3">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">Step 3 &mdash; Vendor Recommendations</h5>
                                        <p class="text-muted small mb-0">Choose the best vendor for your purchase</p>
                                    </div>
                                    <div class="d-flex align-items-center gap-3 bg-light px-3 py-2 rounded border border-light-subtle">
                                        <span class="small text-muted fw-bold">Sort vendors by:</span>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="form-check form-check-inline mb-0">
                                                <input class="form-check-input" type="radio" name="vendorSort" id="sortReviews" value="Reviews" checked="@(VendorSortBy == "Reviews")" @onchange='() => VendorSortBy = "Reviews"' />
                                                <label class="form-check-label small fw-semibold text-dark" for="sortReviews">Overall Reviews</label>
                                            </div>
                                            <div class="form-check form-check-inline mb-0">
                                                <input class="form-check-input" type="radio" name="vendorSort" id="sortPrice" value="Price" checked="@(VendorSortBy == "Price")" @onchange='() => VendorSortBy = "Price"' />
                                                <label class="form-check-label small fw-semibold text-dark" for="sortPrice">Unit Price</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (IsFindingVendors)
                                {
                                    <div class="text-center py-4 text-muted">
                                        <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                                        <span>Evaluating available supplier recommendations...</span>
                                    </div>
                                }
                                else if (SortedVendorRecommendations.Count == 0)
                                {
                                    <div class="alert alert-warning p-3 mb-3">
                                        No active vendors found supplying <strong>@SelectedProduct.ProductName</strong>. Please choose another product or contact your administrator.
                                    </div>
                                }
                                else
                                {
                                    <div class="vendor-recommendations-list mb-4">
                                        @foreach (var rec in SortedVendorRecommendations)
                                        {
                                            bool isSelected = SelectedVendors.Any(v => v.VendorID == rec.VendorID);
                                            <div class="vendor-rec-card @(isSelected ? "selected" : "")" @onclick="() => ToggleVendorSelection(rec)">
                                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                                            <h5 class="fw-bold text-dark mb-0">@rec.VendorName</h5>
                                                            @if (!string.IsNullOrWhiteSpace(rec.SmartBadge))
                                                            {
                                                                <span class="badge bg-success-subtle text-success border border-success-subtle">@rec.SmartBadge</span>
                                                            }
                                                            @if (rec.HasActiveContract && rec.RemainingQuantity > 0)
                                                            {
                                                                <span class="badge bg-light text-dark border">Active Contract (@rec.RemainingQuantity:N0 @SelectedProduct.Unit remaining)</span>
                                                            }
                                                        </div>
                                                        <div class="small text-muted mt-0.5">
                                                            @(string.IsNullOrWhiteSpace(rec.ProductName) ? SelectedProduct.ProductName : rec.ProductName)
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="fw-bold text-success fs-5">
                                                            ₹@rec.UnitPrice.ToString("N0") <span class="small text-muted fw-normal">/ @SelectedProduct.Unit</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2">
                                                    <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
                                                        <div>
                                                            @if (rec.TotalFeedbackCount > 0)
                                                            {
                                                                <button type="button" class="btn p-0 text-success fw-bold text-decoration-underline border-0 bg-transparent" @onclick="() => OpenVendorReviewsModal(rec)" @onclick:stopPropagation="true">
                                                                    ⭐ @rec.AverageRating.ToString("0.0") (@rec.TotalFeedbackCount @(rec.TotalFeedbackCount == 1 ? "review" : "reviews"))
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-secondary">⭐ No Reviews Yet</span>
                                                            }
                                                        </div>
                                                        <div>&bull;</div>
                                                        <div>Quality: <strong class="text-dark">@(rec.AverageQualityRating > 0 ? $"{rec.AverageQualityRating:0.0} / 5" : "Standard")</strong></div>
                                                        <div>&bull;</div>
                                                        <div>Est. Delivery: <strong class="text-dark">@rec.EstimatedDeliveryDays days</strong></div>
                                                    </div>

                                                    <div>
                                                        <button type="button" class="btn btn-sm @(isSelected ? "btn-success" : "btn-outline-success") fw-bold px-3 py-1" @onclick="() => ToggleVendorSelection(rec)" @onclick:stopPropagation="true">
                                                            @(isSelected ? "Selected ✓" : "Select Vendor")
                                                        </button>
                                                    </div>
                                                </div>

                                                @if (LatestReviewsByVendorDict.TryGetValue(rec.VendorID, out var latestRev) && !string.IsNullOrWhiteSpace(latestRev.Review))
                                                {
                                                    <div class="mt-2 p-2 rounded small text-muted bg-light border border-light-subtle d-flex align-items-start gap-2">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success mt-1 flex-shrink-0">
                                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                                        </svg>
                                                        <div>
                                                            <strong class="text-dark">Latest Review: </strong>
                                                            <span>&ldquo;@(latestRev.Review.Length > 120 ? latestRev.Review.Substring(0, 117) + "..." : latestRev.Review)&rdquo;</span>
                                                        </div>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(rec.Recommendation))
                                                {
                                                    <div class="why-rec-callout mt-2 p-2 rounded small text-muted">
                                                        <strong>Why: </strong>@rec.Recommendation
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="d-flex justify-content-between pt-3 border-top">
                                    <button class="btn btn-outline-secondary fw-semibold px-4" @onclick="() => GoBackToStep(2)">
                                        &larr; Back
                                    </button>
                                    <button class="btn-primary-action px-4 py-2" @onclick="GoToStep4Review" disabled="@(SelectedVendors.Count == 0 || !QuantityInput.HasValue || QuantityInput.Value <= 0)">
                                        Review &amp; Dispatch &rarr;
                                    </button>
                                </div>
                            </div>
                        }
                        else if (CurrentStep == 4 && SelectedProduct != null)
                        {
                            <!-- STEP 4: REVIEW & DISPATCH -->
                            var primaryVendor = SelectedVendors.FirstOrDefault();
                            <div class="pm-panel p-4 mb-4">
                                <h4 class="fw-bold text-dark mb-1">Step 4: Review &amp; Dispatch Request</h4>
                                <p class="text-muted small mb-4">Confirm all procurement parameters before direct dispatch to vendors.</p>

                                <div class="review-summary-card p-4 mb-4">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="text-muted small fw-bold">DESTINATION OUTLET</div>
                                            <div class="fw-bold text-dark fs-6">@ConfirmedOutletName</div>
                                            <div class="small text-muted">@OrganizationName</div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted small fw-bold">SELECTED PRODUCT</div>
                                            <div class="fw-bold text-dark fs-6">@SelectedProduct.ProductName</div>
                                            <div class="small text-muted">Category: @(string.IsNullOrWhiteSpace(SelectedProduct.Category) ? "General" : SelectedProduct.Category)</div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted small fw-bold">REQUIRED QUANTITY</div>
                                            <div class="fw-bold text-success fs-5">@(QuantityInput ?? 0) @SelectedProduct.Unit</div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted small fw-bold">SELECTED VENDOR</div>
                                            <div class="fw-bold text-dark fs-6">@(primaryVendor?.VendorName ?? "Selected Vendor")</div>
                                            <div class="small text-muted">Rs. @(primaryVendor?.UnitPrice.ToString("N2")) / @SelectedProduct.Unit &bull; Est. Delivery: @primaryVendor?.EstimatedDeliveryDays days</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info p-3 mb-4 d-flex align-items-center gap-2">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="16" x2="12"></line>
                                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                    </svg>
                                    <span class="small">
                                        <strong>Direct Dispatch:</strong> Purchase Request will be sent directly to the selected vendor(s). No internal approval step required.
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(PurchaseRequestError))
                                {
                                    <div class="alert alert-danger p-3 mb-3">@PurchaseRequestError</div>
                                }

                                <div class="d-flex justify-content-between pt-3 border-top">
                                    <button class="btn btn-outline-secondary fw-semibold px-4" @onclick="() => GoBackToStep(3)" disabled="@IsDispatching">
                                        &larr; Back
                                    </button>
                                    <button class="btn-primary-action px-4 py-2" @onclick="DispatchToSelectedVendors" disabled="@IsDispatching">
                                        @if (IsDispatching)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Dispatching Request...</span>
                                        }
                                        else
                                        {
                                            <span>Create &amp; Dispatch Request &rarr;</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    }
                }

            </main>
        </div>
    </div>

    <!-- =======================================================================
         MY PROFILE MODAL DIALOG
         ======================================================================= -->
    @if (ShowProfileModal)
    {
        <div class="pm-modal-backdrop" @onclick="CloseProfileModal">
            <div class="pm-modal-card" @onclick:stopPropagation="true">
                <div class="pm-modal-header">
                    <h5 class="pm-modal-title">My Profile &mdash; Purchase Manager</h5>
                    <button class="pm-modal-close-btn" @onclick="CloseProfileModal" title="Close">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="pm-modal-body">
                    <div class="profile-meta-row">
                        <span class="meta-label">Full Name</span>
                        <span class="meta-val">@Auth.UserName</span>
                    </div>
                    <div class="profile-meta-row">
                        <span class="meta-label">Email Address</span>
                        <span class="meta-val">@Auth.Email</span>
                    </div>
                    <div class="profile-meta-row">
                        <span class="meta-label">Assigned Role</span>
                        <span class="meta-val text-success">Purchase Manager</span>
                    </div>
                    <div class="profile-meta-row">
                        <span class="meta-label">Assigned Outlet</span>
                        <span class="meta-val">@ConfirmedOutletName</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(OutletAddress))
                    {
                        <div class="profile-meta-row">
                            <span class="meta-label">Outlet Address</span>
                            <span class="meta-val">@OutletAddress</span>
                        </div>
                    }
                    <div class="profile-meta-row">
                        <span class="meta-label">Organization</span>
                        <span class="meta-val">@OrganizationName</span>
                    </div>
                </div>
                <div class="pm-modal-footer">
                    <button class="btn-modal-close" @onclick="CloseProfileModal">Close</button>
                </div>
            </div>
        </div>
    }
}
