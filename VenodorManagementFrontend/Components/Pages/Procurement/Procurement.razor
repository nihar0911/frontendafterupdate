@page "/procurement"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Procurement - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="container py-5">
        <div class="alert alert-warning text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in to access the Procurement feature.</p>
            <button class="btn btn-primary fw-bold px-4" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsOrgManager && !Auth.IsOutletManager && !Auth.IsPurchaseManager && !Auth.IsAdmin)
{
    <div class="container py-5">
        <div class="alert alert-danger text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-3">You do not have privileges to access Procurement.</p>
            <button class="btn btn-outline-secondary fw-bold px-4" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="@SidebarLayoutClass">

        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION
             ======================================================================= -->
        <aside class="org-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager" : (Auth.IsOutletManager ? "/outlet-manager" : "/org-dashboard"))'>
                    <div class="brand-emblem">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">Smart Vendor</span>
                        <span class="brand-sub">Management</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager" : (Auth.IsOutletManager ? "/outlet-manager" : "/org-dashboard"))'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>

                    @if (Auth.IsOrgManager || Auth.IsAdmin)
                    {
                        <li class="nav-item">
                            <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/outlets")'>
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <path d="M9 22V12h6v10"></path>
                                    </svg>
                                </span>
                                <span class="nav-label">Outlets</span>
                            </button>
                        </li>
                    }

                    <li class="nav-item">
                        <button class="nav-link active" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Quotations</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/contracts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Contracts</span>
                        </button>
                    </li>

                    @if (Auth.IsOrgManager || Auth.IsAdmin)
                    {
                        <li class="nav-item">
                            <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="3" width="15" height="13"></rect>
                                        <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                    </svg>
                                </span>
                                <span class="nav-label">Purchase Orders</span>
                            </button>
                        </li>
                    }
                </ul>

                <ul class="nav-list">
                    <li class="sidebar-divider"></li>
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager" : (Auth.IsOutletManager ? "/outlet-manager" : "/org-dashboard"))'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">My Profile</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick="HandleLogout">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Logout</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- =======================================================================
             MAIN BODY WRAPPER
             ======================================================================= -->
        <div class="org-main-wrapper">

            <!-- TOP HEADER (No notification bell) -->
            <header class="org-top-header">
                <button class="menu-toggle-btn" @onclick="ToggleSidebar" title="Toggle Menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <div class="header-right">
                    <div class="profile-capsule-wrapper">
                        <div class="profile-capsule" @onclick="ToggleProfileDropdown">
                            <div class="profile-avatar">@GetUserInitial()</div>
                            <div class="profile-meta">
                                <span class="profile-name">@(string.IsNullOrWhiteSpace(Auth.UserName) ? (Auth.IsPurchaseManager ? "Purchase Manager" : (Auth.IsOutletManager ? "Outlet Manager" : "Organization Manager")) : Auth.UserName)</span>
                                <span class="profile-role">@(Auth.IsPurchaseManager ? "Purchase Manager" : (Auth.IsOutletManager ? "Outlet Manager" : (Auth.IsOrgManager ? "Organization Manager" : "Administrator")))</span>
                            </div>
                            <svg class="dropdown-arrow @(IsProfileDropdownOpen ? "open" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>

                    <button class="header-logout-btn" @onclick="HandleLogout" title="Sign out">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Logout</span>
                    </button>
                </div>
            </header>

            <!-- MAIN CONTENT CANVAS -->
            <main class="org-main-content">
                <div class="content-container">

                    @if (IsReviewsModalOpen && SelectedVendorForReviews != null)
                    {
                        <!-- =======================================================
                             VENDOR REVIEW DETAILS (FULL PAGE VIEW MATCHING DESIGN)
                             ======================================================= -->
                        <!-- TOP ACTION ROW (Back Button & Org Manager Badge) -->
                        <div class="top-action-row">
                            <button type="button" class="btn-back-link" @onclick="CloseVendorReviewsModal">
                                &larr; Back to Procurement
                            </button>
                            <span class="org-manager-badge">
                                @(Auth.IsPurchaseManager ? "Purchase Manager: " : (Auth.IsOutletManager ? "Outlet Manager: " : "Org Manager: "))@(string.IsNullOrWhiteSpace(Auth.UserName) ? (Auth.CurrentUser?.Name ?? "User") : Auth.UserName)
                            </span>
                        </div>

                        <!-- PAGE TITLE SECTION -->
                        <div class="page-title-section">
                            <h1 class="page-heading">Vendor Review Details</h1>
                            <p class="page-subheading">All customer reviews for this vendor</p>
                        </div>

                        <!-- VENDOR REVIEW SUMMARY CARD -->
                        <div class="vendor-review-summary-card">
                            <div class="vendor-review-card-header">
                                <div class="vendor-info-group">
                                    <div class="vendor-review-icon-box">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                            <path d="M9 22v-4h6v4"></path>
                                            <line x1="8" y1="6" x2="8.01" y2="6"></line>
                                            <line x1="16" y1="6" x2="16.01" y2="6"></line>
                                            <line x1="8" y1="10" x2="8.01" y2="10"></line>
                                            <line x1="16" y1="10" x2="16.01" y2="10"></line>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="vendor-summary-name">@SelectedVendorForReviews.VendorName</h3>
                                        <span class="vendor-summary-sub">Verified Customer Reviews</span>
                                    </div>
                                </div>
                                <button type="button" class="btn-close-review" @onclick="CloseVendorReviewsModal">
                                    Close
                                </button>
                            </div>

                            <!-- 4 METRIC CARDS GRID -->
                            <div class="review-metrics-grid">
                                <div class="review-metric-tile">
                                    <span class="metric-label">OVERALL RATING</span>
                                    <div class="metric-score">@SelectedVendorForReviews.AverageRating.ToString("0.0") <span class="metric-total">/ 5</span></div>
                                    <span class="metric-sub">@GetQualitativeRatingText(SelectedVendorForReviews.AverageRating)</span>
                                </div>
                                <div class="review-metric-tile">
                                    <span class="metric-label">QUALITY RATING</span>
                                    <div class="metric-score">@(SelectedVendorForReviews.AverageQualityRating > 0 ? SelectedVendorForReviews.AverageQualityRating.ToString("0.0") : SelectedVendorForReviews.AverageRating.ToString("0.0")) <span class="metric-total">/ 5</span></div>
                                    <span class="metric-sub">@GetQualitativeRatingText(SelectedVendorForReviews.AverageQualityRating > 0 ? SelectedVendorForReviews.AverageQualityRating : SelectedVendorForReviews.AverageRating)</span>
                                </div>
                                <div class="review-metric-tile">
                                    <span class="metric-label">DELIVERY RATING</span>
                                    <div class="metric-score">@(SelectedVendorForReviews.AverageDeliveryRating > 0 ? SelectedVendorForReviews.AverageDeliveryRating.ToString("0.0") : SelectedVendorForReviews.AverageRating.ToString("0.0")) <span class="metric-total">/ 5</span></div>
                                    <span class="metric-sub">@GetQualitativeRatingText(SelectedVendorForReviews.AverageDeliveryRating > 0 ? SelectedVendorForReviews.AverageDeliveryRating : SelectedVendorForReviews.AverageRating)</span>
                                </div>
                                <div class="review-metric-tile">
                                    <span class="metric-label">TOTAL REVIEWS</span>
                                    <div class="metric-score">@SelectedVendorForReviews.TotalFeedbackCount</div>
                                    <span class="metric-sub">All Time</span>
                                </div>
                            </div>
                        </div>

                        <!-- ALL CUSTOMER REVIEWS CARD -->
                        <div class="all-reviews-card">
                            <h4 class="all-reviews-heading">All Customer Reviews (@CurrentVendorReviews.Count)</h4>

                            @if (IsLoadingVendorReviews)
                            {
                                <div class="py-5 text-center text-muted">
                                    <div class="spinner-border spinner-border-sm text-success mb-2" role="status"></div>
                                    <p class="mb-0 small">Loading customer reviews...</p>
                                </div>
                            }
                            else if (CurrentVendorReviews.Count == 0)
                            {
                                <div class="p-4 text-center text-muted">
                                    <p class="mb-0 fw-semibold">No customer reviews available yet.</p>
                                    <small>This vendor does not have any feedback records registered yet.</small>
                                </div>
                            }
                            else
                            {
                                <div class="reviews-table-wrapper">
                                    <table class="reviews-table">
                                        <thead>
                                            <tr>
                                                <th>OUTLET</th>
                                                <th>PRODUCT</th>
                                                <th>QUALITY / DELIVERY / OVERALL</th>
                                                <th>REVIEWED BY</th>
                                                <th>DATE</th>
                                                <th>COMMENT</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var rev in CurrentVendorReviews)
                                            {
                                                <tr>
                                                    <td class="cell-outlet">@rev.OutletName</td>
                                                    <td class="cell-product">
                                                        <div class="product-title">@rev.ProductName</div>
                                                        @if (!string.IsNullOrWhiteSpace(SelectedProduct?.Unit))
                                                        {
                                                            <div class="product-qty-tag">@SelectedProduct.Unit</div>
                                                        }
                                                    </td>
                                                    <td class="cell-ratings">
                                                        <div class="ratings-row">
                                                            @rev.ProductQualityRating.ToString("0.0") / @rev.DeliveryRating.ToString("0.0") / @rev.Rating.ToString("0.0")
                                                        </div>
                                                        <div class="ratings-qualitative">
                                                            @GetQualitativeRatingText(rev.Rating)
                                                        </div>
                                                    </td>
                                                    <td class="cell-user">@(string.IsNullOrWhiteSpace(rev.RatedByUserName) ? "Manager" : rev.RatedByUserName)</td>
                                                    <td class="cell-date">@rev.FeedbackDate.ToString("dd MMM yyyy")</td>
                                                    <td class="cell-comment">@(string.IsNullOrWhiteSpace(rev.Review) ? "—" : rev.Review)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Table Footer -->
                                <div class="reviews-table-footer">
                                    <span class="reviews-table-count">Showing 1 to @CurrentVendorReviews.Count of @CurrentVendorReviews.Count reviews</span>
                                    <div class="reviews-footer-right">
                                        <div class="reviews-pagination">
                                            <button type="button" class="btn-page-nav" disabled>&lsaquo;</button>
                                            <span class="page-pill active">1</span>
                                            <button type="button" class="btn-page-nav" disabled>&rsaquo;</button>
                                        </div>
                                        <div class="rows-select-group">
                                            <span>Rows per page:</span>
                                            <select class="form-select form-select-sm rows-dropdown" disabled>
                                                <option>10</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- TOP ACTION ROW (Back Button & Org Manager Badge) -->
                        <div class="top-action-row">
                            <button type="button" class="btn-back-link" @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager" : (Auth.IsOutletManager ? "/outlet-manager" : "/org-dashboard"))'>
                                &larr; Back to Dashboard
                            </button>
                            <span class="org-manager-badge">
                                @(Auth.IsPurchaseManager ? "Purchase Manager: " : (Auth.IsOutletManager ? "Outlet Manager: " : "Org Manager: "))@(string.IsNullOrWhiteSpace(Auth.UserName) ? (Auth.CurrentUser?.Name ?? "User") : Auth.UserName)
                            </span>
                        </div>

                        <!-- PAGE TITLE SECTION -->
                        <div class="page-title-section">
                            @if (!string.IsNullOrEmpty(DispatchSuccessMessage))
                            {
                                <h1 class="page-heading">Purchase Request Created Successfully!</h1>
                                <p class="page-subheading">Your purchase request has been dispatched to the selected vendor.</p>
                            }
                            else
                            {
                                <h1 class="page-heading">@(SelectedProduct != null ? "Create Purchase Request" : "Procurement")</h1>
                                <p class="page-subheading">@(SelectedProduct != null ? "Select a vendor and specify the quantity you want to procure." : "Create and dispatch purchase requests to selected vendors")</p>
                            }
                        </div>

                        @if (IsLoadingOutlets)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-success mb-3" role="status" style="width: 3rem; height: 3rem;">
                                    <span class="visually-hidden">Loading outlets...</span>
                                </div>
                                <h5 class="text-muted fw-bold">Loading outlets...</h5>
                            </div>
                        }
                        else if (HasErrorOutlets)
                        {
                            <div class="alert alert-danger p-4 text-center my-4 shadow-sm rounded-3">
                                <h5 class="fw-bold text-danger mb-2">Unable to load outlets.</h5>
                                <p class="text-muted small mb-3">An error occurred while connecting to the server. Please try again.</p>
                                <button class="btn btn-danger fw-bold px-4" @onclick="LoadOutlets">Try Again</button>
                            </div>
                        }
                        else
                        {
                            <div class="workflow-card">
                                @if (!IsOutletConfirmed)
                                {
                                <!-- =======================================================
                                     STAGE 1: OUTLET SELECTION
                                     ======================================================= -->
                                <div class="org-context-row">
                                    <div class="org-context-icon">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                            <circle cx="9.5" cy="14.5" r="1.5"></circle>
                                            <path d="M6 11h4l1.5 5h3"></path>
                                        </svg>
                                    </div>
                                    <div class="org-context-content">
                                        <span class="org-context-label">Organization</span>
                                        <span class="org-context-value">
                                            @(string.IsNullOrWhiteSpace(OrganizationName) ? "Organization" : OrganizationName)
                                        </span>
                                    </div>
                                </div>

                                <div class="info-helper-box">
                                    <svg class="info-helper-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="16" x2="12"></line>
                                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                    </svg>
                                    <span>Select an outlet to create a purchase request and dispatch it to vendors.</span>
                                </div>

                                <div class="form-field-group">
                                    <label class="form-field-label">@(Auth.IsOutletManager || Auth.IsPurchaseManager ? "Assigned Outlet" : "Select Outlet")</label>

                                    @if (Auth.IsOutletManager || Auth.IsPurchaseManager)
                                    {
                                        <div class="assigned-outlet-display">
                                            <span>@(string.IsNullOrWhiteSpace(ConfirmedOutletName) ? "Outlet Branch" : ConfirmedOutletName)</span>
                                            <span class="badge bg-success">Assigned</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="select-outlet-container">
                                            <svg class="select-outlet-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                <path d="M9 22V12h6v10"></path>
                                            </svg>
                                            <select class="select-outlet-control" @bind="SelectedOutletId" @bind:after="OnOutletSelected">
                                                <option value="0">-- Select an outlet --</option>
                                                @foreach (var outlet in Outlets)
                                                {
                                                    <option value="@outlet.OutletID">
                                                        @GetDisplayOutletName(outlet)
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(ValidationMessage))
                                    {
                                        <div class="validation-error-text">
                                            @ValidationMessage
                                        </div>
                                    }
                                </div>

                                <div class="workflow-help-panel">
                                    <div class="help-panel-left">
                                        <div class="help-icon-circle">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                <path d="M9 22V12h6v10"></path>
                                            </svg>
                                        </div>
                                        <div class="help-panel-content">
                                            <h4 class="help-title">Choose the outlet</h4>
                                            <p class="help-desc">Purchase requests will be created for the selected outlet and can be shared with vendors.</p>
                                        </div>
                                    </div>

                                    <div class="help-illustration">
                                        <svg width="100" height="38" viewBox="0 0 100 38" fill="none">
                                            <circle cx="15" cy="24" r="6" stroke="#174F45" stroke-width="2" fill="#E6F0EB"></circle>
                                            <path d="M15 20c-2.2 0-4 1.8-4 4s4 9 4 9 4-7 4-9-1.8-4-4-4z" fill="#174F45" opacity="0.8"></path>
                                            <circle cx="15" cy="24" r="2" fill="white"></circle>
                                            <path d="M25 24 C40 24, 45 14, 60 14 S75 24, 80 24" stroke="#7B8782" stroke-width="1.5" stroke-dasharray="3 3"></path>
                                            <rect x="75" y="14" width="20" height="16" rx="2" stroke="#174F45" stroke-width="1.5" fill="#E6F0EB"></rect>
                                            <path d="M72 14l5-6h16l5 6" stroke="#174F45" stroke-width="1.5" fill="#E6F0EB"></path>
                                            <rect x="81" y="22" width="8" height="8" stroke="#174F45" stroke-width="1.2" fill="white"></rect>
                                        </svg>
                                    </div>
                                </div>

                                <button type="button" class="btn-procurement-continue" @onclick="HandleContinue">
                                    <span>Continue</span>
                                </button>
                            }
                            else if (SelectedProduct == null)
                            {
                                <!-- =======================================================
                                     STAGE 2: PRODUCT SEARCH & SELECTION
                                     ======================================================= -->
                                <div class="stage-confirmed-outlet">
                                    <div class="outlet-badge-container">
                                        <div class="outlet-badge-icon">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                <path d="M9 22V12h6v10"></path>
                                            </svg>
                                        </div>
                                        <div class="confirmed-outlet-meta">
                                            <span class="confirmed-label">Selected Outlet</span>
                                            <span class="confirmed-val">@ConfirmedOutletName</span>
                                        </div>
                                    </div>

                                    @if (!Auth.IsOutletManager && !Auth.IsPurchaseManager)
                                    {
                                        <button type="button" class="btn-change-action" @onclick="ChangeOutlet" disabled="@IsFindingVendors">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="16 3 21 3 21 8"></polyline>
                                                <line x1="4" y1="20" x2="21" y2="3"></line>
                                                <polyline points="21 16 21 21 16 21"></polyline>
                                                <line x1="15" y1="15" x2="21" y2="21"></line>
                                                <line x1="4" y1="4" x2="9" y2="9"></line>
                                            </svg>
                                            <span>Change Outlet</span>
                                        </button>
                                    }
                                </div>

                                <div class="section-title-wrap">
                                    <h3 class="section-title">Select a Product to Procure</h3>
                                </div>

                                <div class="product-search-input-wrapper">
                                    <svg class="product-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                    <input type="text" class="product-search-input" placeholder="Search product name or category..."
                                           @bind="SearchQuery" @bind:event="oninput" />
                                </div>

                                @if (IsLoadingProducts)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-success" role="status">
                                            <span class="visually-hidden">Loading products...</span>
                                        </div>
                                        <p class="text-muted small mt-2">Loading product catalog...</p>
                                    </div>
                                }
                                else if (HasErrorProducts)
                                {
                                    <div class="alert alert-danger p-3 text-center rounded-3">
                                        <p class="mb-2 small">Error loading products.</p>
                                        <button class="btn btn-outline-danger btn-sm fw-bold" @onclick="LoadProducts">Retry</button>
                                    </div>
                                }
                                else if (FilteredProducts.Count == 0)
                                {
                                    <div class="text-center py-4 text-muted">
                                        <p class="mb-0">No matching products found.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="product-list-container">
                                        @foreach (var prod in FilteredProducts)
                                        {
                                            <div class="product-list-item">
                                                <div class="product-item-info">
                                                    <h4 class="product-item-title">@prod.ProductName</h4>
                                                    <p class="product-item-meta">
                                                        Category: @(string.IsNullOrWhiteSpace(prod.Category) ? "General" : prod.Category) &bull; Unit: @prod.Unit
                                                    </p>
                                                </div>
                                                <button type="button" class="btn-select-product" @onclick="() => SelectProduct(prod)">
                                                    <span>Select &rarr;</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <!-- =======================================================
                                     STAGE 3: SELECTED PRODUCT / VENDOR SELECTION (REFERENCE IMAGE)
                                     ======================================================= -->

                                <!-- Selected Context Card (Outlet + Product) -->
                                <div class="dual-context-card">
                                    <div class="dual-context-grid">
                                        <div class="context-block">
                                            <div class="context-icon-box">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                    <path d="M9 22V12h6v10"></path>
                                                </svg>
                                            </div>
                                            <div class="context-text">
                                                <span class="context-label">Selected Outlet</span>
                                                <span class="context-val">@ConfirmedOutletName</span>
                                                <span class="context-sub">
                                                    @(Outlets.FirstOrDefault(o => o.OutletID == SelectedOutletId)?.Address ?? "Outlet Location")
                                                </span>
                                            </div>
                                        </div>

                                        <div class="context-block">
                                            <div class="context-icon-box">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                                </svg>
                                            </div>
                                            <div class="context-text">
                                                <span class="context-label">Selected Product</span>
                                                <span class="context-val">@SelectedProduct.ProductName</span>
                                                <span class="context-sub">Category: @(string.IsNullOrWhiteSpace(SelectedProduct.Category) ? "General" : SelectedProduct.Category) &bull; Unit: @SelectedProduct.Unit</span>
                                            </div>
                                        </div>

                                        <div class="context-action-wrap">
                                            <button type="button" class="btn-change-action" @onclick="ChangeProduct" disabled="@IsFindingVendors">
                                                <span>Change Product</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- SUCCESS CONFIRMATION STATE -->
                                @if (!string.IsNullOrEmpty(DispatchSuccessMessage) && CreatedPurchaseRequest != null)
                                {
                                    var primaryVendor = SelectedVendors.FirstOrDefault();
                                    string primaryVendorName = primaryVendor?.VendorName ?? "Selected Vendor";

                                    <div class="success-main-card">
                                        <!-- Big Check Icon + Banner Message -->
                                        <div class="success-banner-row">
                                            <div class="success-large-circle-icon">
                                                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                            </div>
                                            <div class="success-banner-content">
                                                <h2 class="success-banner-title">Purchase Request PR-@CreatedPurchaseRequest.RequestID Created &amp; Dispatched!</h2>
                                                <p class="success-banner-desc">Purchase Request PR-@CreatedPurchaseRequest.RequestID has been successfully sent to '@primaryVendorName'.</p>
                                                <p class="success-banner-sub">The respective Vendor Manager(s) have been notified and can now accept or reject the opportunity.</p>
                                            </div>
                                        </div>

                                        <!-- 4 Small Summary Info Tiles -->
                                        <div class="success-summary-tiles-grid">
                                            <div class="success-tile">
                                                <div class="success-tile-icon">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                        <polyline points="14 2 14 8 20 8"></polyline>
                                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                                    </svg>
                                                </div>
                                                <div class="success-tile-meta">
                                                    <span class="success-tile-label">Request Number</span>
                                                    <span class="success-tile-val">PR-@CreatedPurchaseRequest.RequestID</span>
                                                </div>
                                            </div>

                                            <div class="success-tile">
                                                <div class="success-tile-icon">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                                    </svg>
                                                </div>
                                                <div class="success-tile-meta">
                                                    <span class="success-tile-label">Request Date</span>
                                                    <span class="success-tile-val">@DateTime.Now.ToString("dd MMM yyyy")</span>
                                                    <span class="success-tile-sub">@DateTime.Now.ToString("hh:mm tt")</span>
                                                </div>
                                            </div>

                                            <div class="success-tile">
                                                <div class="success-tile-icon">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                        <circle cx="12" cy="7" r="4"></circle>
                                                    </svg>
                                                </div>
                                                <div class="success-tile-meta">
                                                    <span class="success-tile-label">Selected Vendor</span>
                                                    <span class="success-tile-val" title="@primaryVendorName">@primaryVendorName</span>
                                                </div>
                                            </div>

                                            <div class="success-tile">
                                                <div class="success-tile-icon">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                                    </svg>
                                                </div>
                                                <div class="success-tile-meta">
                                                    <span class="success-tile-label">Status</span>
                                                    <span class="success-tile-val text-success">DISPATCHED</span>
                                                    <span class="success-tile-sub">Awaiting Response</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Information Message -->
                                        <div class="success-notification-info">
                                            <svg class="success-notification-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="16" x2="12"></line>
                                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                            </svg>
                                            <span>You will be notified once the vendor responds to your request.</span>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="success-action-buttons-row">
                                            <button type="button" 
                                                    class="btn-success-primary" 
                                                    @onclick='() => Nav.NavigateTo(Auth.IsPurchaseManager ? "/purchase-manager" : (Auth.IsOutletManager ? "/outlet-manager" : "/org-dashboard"))'>
                                                <span>Go to Dashboard</span>
                                            </button>
                                            <button type="button" 
                                                    class="btn-success-secondary" 
                                                    @onclick="ChangeProduct">
                                                <span>Create Another Request</span>
                                            </button>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(PurchaseRequestError))
                                {
                                    <div class="alert alert-danger p-3 mb-4 rounded-3">
                                        <strong>Error:</strong> @PurchaseRequestError
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(RecommendationsError))
                                {
                                    <div class="alert alert-warning p-4 mb-4 rounded-3">
                                        <h6 class="fw-bold mb-1">Notice</h6>
                                        <p class="small text-muted mb-2">@RecommendationsError</p>
                                        <button type="button" class="btn-change-action" @onclick="HandleFindVendors">Retry Loading Vendors</button>
                                    </div>
                                }

                                <!-- TWO-COLUMN WORKFLOW GRID OR NO VENDORS EMPTY STATE -->
                                @if (string.IsNullOrEmpty(DispatchSuccessMessage))
                                {
                                    @if (IsFindingVendors && (VendorRecommendations == null))
                                    {
                                        <div class="text-center py-5">
                                            <div class="spinner-border text-success mb-3" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                                            <h5 class="fw-bold text-dark mb-1">Finding available vendors...</h5>
                                            <p class="small text-muted mb-0">Analyzing pricing and active supplier contracts</p>
                                        </div>
                                    }
                                    else if (!string.IsNullOrEmpty(RecommendationsError))
                                    {
                                        <div class="alert alert-warning p-4 mb-4 rounded-3 text-center">
                                            <h5 class="fw-bold text-dark mb-2">Unable to Load Vendors</h5>
                                            <p class="small text-muted mb-3">@RecommendationsError</p>
                                            <button type="button" class="btn btn-outline-success fw-bold px-4" @onclick="HandleFindVendors">
                                                Retry Loading Vendors
                                            </button>
                                        </div>
                                    }
                                    else if (VendorRecommendations != null && VendorRecommendations.Count == 0)
                                    {
                                        <!-- NO VENDORS AVAILABLE EMPTY STATE -->
                                        <div class="no-vendors-empty-card">
                                            <div class="no-vendors-icon-circle">
                                                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                                    <path d="M9 22v-4h6v4"></path>
                                                    <line x1="8" y1="6" x2="8.01" y2="6"></line>
                                                    <line x1="16" y1="6" x2="16.01" y2="6"></line>
                                                    <line x1="8" y1="10" x2="8.01" y2="10"></line>
                                                    <line x1="16" y1="10" x2="16.01" y2="10"></line>
                                                </svg>
                                                <div class="no-vendors-badge-cross">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                    </svg>
                                                </div>
                                            </div>

                                            <h2 class="no-vendors-title">No Vendors Available</h2>
                                            <p class="no-vendors-desc">
                                                There are currently no vendors configured to supply <strong>@SelectedProduct.ProductName</strong>.
                                            </p>
                                            <p class="no-vendors-sub">
                                                Please choose another product or contact your administrator to configure a vendor for this product.
                                            </p>

                                            <button type="button" class="btn-no-vendors-change" @onclick="ChangeProduct">
                                                <span>Change Product</span>
                                            </button>
                                        </div>

                                        <!-- Admin Notification Info Bar -->
                                        <div class="no-vendors-admin-info-bar">
                                            <svg class="no-vendors-info-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="16" x2="12"></line>
                                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                            </svg>
                                            <span>If you believe this is an issue, please contact your organization administrator to add vendors for this product.</span>
                                        </div>
                                    }
                                    else if (VendorRecommendations != null && VendorRecommendations.Count > 0)
                                    {
                                        <div class="two-column-workflow-grid">

                                            <!-- LEFT COLUMN: CHOOSE VENDOR & WHY RECOMMENDED -->
                                            <div class="workflow-column">
                                                <div class="section-title-wrap">
                                                    <h3 class="section-title">Choose Vendor</h3>
                                                    <p class="section-desc">Select the vendor you want to purchase this product from.</p>
                                                </div>

                                                <div class="vendor-cards-list">
                                                    @foreach (var rec in VendorRecommendations)
                                                    {
                                                        bool isSelected = SelectedVendors.Any(v => v.VendorID == rec.VendorID);

                                                        <div class="selectable-vendor-card @(isSelected ? "selected" : "")"
                                                             @onclick="() => ToggleVendorSelection(rec)">
                                                            
                                                            <div class="vendor-card-top-row">
                                                                <div class="vendor-identity">
                                                                    <div class="radio-indicator">
                                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                            @if (isSelected)
                                                                            {
                                                                                <circle cx="12" cy="12" r="10" stroke="#174F45" fill="none"></circle>
                                                                                <circle cx="12" cy="12" r="5" fill="#174F45"></circle>
                                                                            }
                                                                            else
                                                                            {
                                                                                <circle cx="12" cy="12" r="10" stroke="#D1D5DB"></circle>
                                                                            }
                                                                        </svg>
                                                                    </div>
                                                                    <h4 class="vendor-title">@rec.VendorName</h4>
                                                                </div>

                                                                @if (isSelected)
                                                                {
                                                                    <span class="vendor-selected-tag">Selected</span>
                                                                }
                                                            </div>

                                                            <!-- Secondary Status / Badges Row -->
                                                            <div class="vendor-badges-row">
                                                                @if (!string.IsNullOrWhiteSpace(rec.SmartBadge))
                                                                {
                                                                    <span class="vendor-status-pill badge-smart-rec">@rec.SmartBadge</span>
                                                                }
                                                                @if (rec.HasActiveContract && rec.RemainingQuantity > 0)
                                                                {
                                                                    <span class="vendor-status-pill badge-recommended">Active Contract</span>
                                                                    <span class="vendor-status-pill badge-contract">Remaining: @rec.RemainingQuantity.ToString("N0") @SelectedProduct.Unit</span>
                                                                }
                                                                else if (!string.IsNullOrEmpty(rec.Recommendation) && rec.Recommendation.Contains("Best Price"))
                                                                {
                                                                    <span class="vendor-status-pill badge-alternative-price">Alternative — Best Price</span>
                                                                    <span class="vendor-status-pill badge-no-contract">No Active Contract</span>
                                                                }
                                                                else if (rec.HasActiveContract && rec.RemainingQuantity <= 0)
                                                                {
                                                                    <span class="vendor-status-pill badge-alternative">Alternative</span>
                                                                    <span class="vendor-status-pill badge-depleted">Contract Capacity Depleted</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="vendor-status-pill badge-alternative">Alternative</span>
                                                                    <span class="vendor-status-pill badge-no-contract">No Active Contract</span>
                                                                }
                                                            </div>

                                                            <!-- 4 Key Statistics Grid -->
                                                            <div class="vendor-stats-columns">
                                                                <div class="vendor-stat-item">
                                                                    <span class="stat-item-label">Customer Rating</span>
                                                                    @if (rec.TotalFeedbackCount > 0)
                                                                    {
                                                                        <button type="button" class="btn p-0 text-start border-0 bg-transparent rating-btn-view" @onclick="() => OpenVendorReviewsModal(rec)" @onclick:stopPropagation="true" title="Click to view verified customer reviews">
                                                                            <span class="stat-item-val rating-highlight text-decoration-underline">
                                                                                ★ @rec.AverageRating.ToString("0.0") <span class="rating-sub">(@rec.TotalFeedbackCount reviews)</span>
                                                                            </span>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="stat-item-val text-muted">No Reviews Yet</span>
                                                                    }
                                                                </div>
                                                                <div class="vendor-stat-item">
                                                                    <span class="stat-item-label">Quality Score</span>
                                                                    @if (rec.TotalFeedbackCount > 0 && rec.AverageQualityRating > 0)
                                                                    {
                                                                        <span class="stat-item-val">@rec.AverageQualityRating.ToString("0.0") / 5</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="stat-item-val text-muted">Standard</span>
                                                                    }
                                                                </div>
                                                                <div class="vendor-stat-item">
                                                                    <span class="stat-item-label">Unit Price</span>
                                                                    <span class="stat-item-val">Rs. @rec.UnitPrice.ToString("N2") / @SelectedProduct.Unit</span>
                                                                </div>
                                                                <div class="vendor-stat-item">
                                                                    <span class="stat-item-label">Estimated Delivery</span>
                                                                    <span class="stat-item-val">@rec.EstimatedDeliveryDays days</span>
                                                                </div>
                                                            </div>

                                                        </div>
                                                    }
                                                </div>

                                                <!-- WHY THIS VENDOR IS RECOMMENDED SECTION -->
                                                @if (VendorRecommendations.Count > 0)
                                                {
                                                    var recVendor = VendorRecommendations.FirstOrDefault();
                                                    if (recVendor != null)
                                                    {
                                                        <div class="why-recommended-box">
                                                            <div class="why-rec-header">
                                                                <span class="why-rec-title">Why this vendor is recommended</span>
                                                                @if (!string.IsNullOrWhiteSpace(recVendor.SmartBadge))
                                                                {
                                                                    <span class="vendor-status-pill badge-smart-rec">@recVendor.SmartBadge</span>
                                                                }
                                                            </div>
                                                            <p class="why-rec-desc">
                                                                @(!string.IsNullOrWhiteSpace(recVendor.Recommendation) ? recVendor.Recommendation : (recVendor.HasActiveContract ? "Recommended because of active contract allocation and verified performance." : "Recommended based on competitive pricing and quality."))
                                                            </p>
                                                        </div>
                                                    }
                                                }
                                            </div>

                                            <!-- RIGHT COLUMN: PURCHASE DETAILS (QUANTITY & SUMMARY) -->
                                            <div class="workflow-column">
                                                <div class="section-title-wrap">
                                                    <h3 class="section-title">Purchase Details</h3>
                                                    <p class="section-desc">Specify the quantity and review procurement parameters.</p>
                                                </div>

                                                <!-- QUANTITY TO PROCURE CARD -->
                                                <div class="quantity-section-card">
                                                    <h4 class="sub-section-title">Quantity to Procure</h4>
                                                    <div class="quantity-form-group">
                                                        <label class="form-field-label">Quantity</label>
                                                        <div class="quantity-input-box">
                                                            <input type="number" 
                                                                   class="quantity-input-control" 
                                                                   placeholder="10"
                                                                   @bind="QuantityInput" 
                                                                   @bind:after="OnQuantityChanged" 
                                                                   min="0.01" 
                                                                   step="any" 
                                                                   disabled="@IsFindingVendors" />
                                                            <span class="quantity-unit-tag">@SelectedProduct.Unit</span>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(QuantityValidationMessage))
                                                        {
                                                            <div class="validation-error-text">
                                                                @QuantityValidationMessage
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- REQUEST SUMMARY BLOCK -->
                                                @{
                                                    var selectedVendor = SelectedVendors.FirstOrDefault();
                                                }
                                                <div class="request-summary-block">
                                                    <h4 class="summary-block-title">Request Summary</h4>
                                                    <div class="summary-rows-list">
                                                        <div class="summary-row">
                                                            <span class="summary-row-label">Outlet</span>
                                                            <span class="summary-row-val">@ConfirmedOutletName</span>
                                                        </div>
                                                        <div class="summary-row">
                                                            <span class="summary-row-label">Product</span>
                                                            <span class="summary-row-val">@SelectedProduct.ProductName</span>
                                                        </div>
                                                        <div class="summary-row">
                                                            <span class="summary-row-label">Category</span>
                                                            <span class="summary-row-val">@(string.IsNullOrWhiteSpace(SelectedProduct.Category) ? "General" : SelectedProduct.Category)</span>
                                                        </div>
                                                        <div class="summary-row">
                                                            <span class="summary-row-label">Unit</span>
                                                            <span class="summary-row-val">@SelectedProduct.Unit</span>
                                                        </div>
                                                        <div class="summary-row">
                                                            <span class="summary-row-label">Selected Vendor</span>
                                                            <span class="summary-row-val">@(selectedVendor?.VendorName ?? "None selected")</span>
                                                        </div>
                                                        <div class="summary-row">
                                                            <span class="summary-row-label">Unit Price</span>
                                                            <span class="summary-row-val">@(selectedVendor != null ? $"Rs. {selectedVendor.UnitPrice:N2} / {SelectedProduct.Unit}" : "—")</span>
                                                        </div>
                                                        <div class="summary-row">
                                                            <span class="summary-row-label">Estimated Delivery</span>
                                                            <span class="summary-row-val">@(selectedVendor != null ? $"{selectedVendor.EstimatedDeliveryDays} days" : "—")</span>
                                                        </div>
                                                        
                                                        <div class="summary-divider"></div>

                                                        <div class="summary-total-row">
                                                            <span class="summary-total-label">Total Quantity</span>
                                                            <span class="summary-total-val">@(QuantityInput.HasValue ? $"{QuantityInput.Value} {SelectedProduct.Unit}" : $"0 {SelectedProduct.Unit}")</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <!-- ACTION FOOTER ROW -->
                                        <div class="workflow-footer-actions">
                                            <button type="button" class="btn-footer-cancel" @onclick="ChangeProduct" disabled="@IsDispatching">
                                                Cancel
                                            </button>

                                            <button type="button" 
                                                    class="btn-footer-submit" 
                                                    @onclick="DispatchToSelectedVendors" 
                                                    disabled="@(IsDispatching || SelectedVendors.Count == 0 || !QuantityInput.HasValue || QuantityInput.Value <= 0)">
                                                @if (IsDispatching)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                    <span>Creating Request...</span>
                                                }
                                                else
                                                {
                                                    <span>Review &amp; Create Request</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }

                    } @* end else (IsReviewsModalOpen) *@

                </div>
            </main>

        </div>

    </div>

}
