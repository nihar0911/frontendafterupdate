@page "/purchase-manager/recommendation-settings"
@page "/recommendation-settings"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Vendor Recommendation Settings - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="container py-5">
        <div class="alert alert-warning text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as a Purchase Manager to view this portal.</p>
            <button class="btn btn-primary fw-bold px-4" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsPurchaseManager && !Auth.IsAdmin && !Auth.IsOrgManager)
{
    <div class="container py-5">
        <div class="alert alert-danger text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-3">You do not have sufficient privileges to access Recommendation Settings.</p>
            <button class="btn btn-outline-secondary fw-bold px-4" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="pm-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">

        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION (ENTERPRISE DARK GREEN)
             ======================================================================= -->
        <aside class="pm-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/purchase-manager")' style="cursor:pointer;">
                    <div class="brand-emblem">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">PROCUREMENT</span>
                        <span class="brand-sub">MANAGEMENT</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <!-- DASHBOARD -->
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>
                </ul>

                <!-- PROCUREMENT -->
                <div class="nav-section-title">PROCUREMENT</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Vendor Quotations</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders?view=deliveries")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Deliveries</span>
                        </button>
                    </li>
                </ul>

                <!-- FINANCE -->
                <div class="nav-section-title">FINANCE</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/invoices")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Invoices &amp; Billing</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/payments")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                    <line x1="1" y1="10" x2="23" y2="10"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Payments &amp; Settlements</span>
                        </button>
                    </li>
                </ul>

                <!-- CONFIGURATION -->
                <div class="nav-section-title">CONFIGURATION</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link active" @onclick='() => Nav.NavigateTo("/purchase-manager/recommendation-settings")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Recommendation Settings</span>
                        </button>
                    </li>
                </ul>

                <!-- ACCOUNT -->
                <div class="nav-section-account">
                    <div class="nav-section-title">ACCOUNT</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <button class="sidebar-nav-link" @onclick="OpenProfileModal">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </span>
                                <span class="nav-label">My Profile</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="sidebar-nav-link" @onclick="HandleLogout">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                </span>
                                <span class="nav-label">Logout</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- =======================================================================
             MAIN CONTENT AREA
             ======================================================================= -->
        <main class="pm-main-content">
            <!-- TOP BAR -->
            <header class="pm-topbar">
                <div class="topbar-left">
                    <button class="topbar-menu-toggle" @onclick="ToggleSidebar" title="Toggle Sidebar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <div class="topbar-title-block">
                        <span class="topbar-breadcrumb">Dashboard / Configuration</span>
                        <h1 class="topbar-heading">Vendor Recommendation Settings</h1>
                    </div>
                </div>

                <div class="topbar-right">
                    <div class="topbar-profile-container">
                        <button class="profile-pill-btn" @onclick="ToggleProfileDropdown">
                            <div class="profile-avatar">
                                @(DisplayName.Length > 0 ? DisplayName[0].ToString().ToUpper() : "P")
                            </div>
                            <span class="profile-name">@DisplayName</span>
                            <span class="profile-badge">Purchase Manager</span>
                        </button>
                        @if (ShowProfileDropdown)
                        {
                            <div class="profile-dropdown-menu">
                                <div class="dropdown-header">
                                    <div class="fw-bold">@DisplayName</div>
                                    <div class="text-muted small">@Auth.Email</div>
                                </div>
                                <div class="dropdown-divider"></div>
                                <button class="profile-menu-item" @onclick="OpenProfileModal">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <span>My Profile</span>
                                </button>
                                <button class="profile-menu-item logout" @onclick="HandleLogout">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    <span>Logout</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <div class="pm-dashboard-body">

                <!-- Header Actions Card -->
                <div class="settings-header-card mb-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div>
                            <h2 class="settings-title mb-1">Recommendation Scoring &amp; Rules Engine</h2>
                            <p class="settings-subtitle text-muted mb-0">
                                Tune multi-factor weights, minimum thresholds, and contract priorities used to evaluate vendor quotations across all outlets.
                            </p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-semibold" @onclick="ResetToDefaults" disabled="@IsSavingSettings">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <polyline points="1 4 1 10 7 10"></polyline>
                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                </svg>
                                Reset Defaults
                            </button>
                            <button type="button" class="btn btn-success px-4 py-2 fw-bold text-white shadow-sm" @onclick="SaveSettingsAsync" disabled="@(IsSavingSettings || !IsTotalWeightValid)">
                                @if (IsSavingSettings)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                        <polyline points="7 3 7 8 15 8"></polyline>
                                    </svg>
                                    <span>Save Configuration</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(SettingsSuccessMessage))
                {
                    <div class="alert alert-success d-flex align-items-center mb-4 py-3 px-4 rounded-3 shadow-sm" role="alert">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2 text-success flex-shrink-0">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <div class="fw-semibold">@SettingsSuccessMessage</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(SettingsErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4 py-3 px-4 rounded-3 shadow-sm" role="alert">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2 text-danger flex-shrink-0">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div class="fw-semibold">@SettingsErrorMessage</div>
                    </div>
                }

                @if (IsLoadingSettings)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading settings...</span>
                        </div>
                        <p class="text-muted mt-3 fw-medium">Loading current recommendation settings...</p>
                    </div>
                }
                else if (Settings != null)
                {
                    <!-- CARD 1: SCORING WEIGHTS DISTRIBUTION -->
                    <div class="settings-card mb-4">
                        <div class="card-header-row d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h3 class="card-section-title mb-1">Composite Multi-Factor Scoring Weights</h3>
                                <p class="card-section-subtitle mb-0">Total weights must sum to exactly 100.00% across all four evaluation criteria.</p>
                            </div>
                            <div>
                                @if (IsTotalWeightValid)
                                {
                                    <span class="badge bg-success px-3 py-2 fs-6 fw-bold">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-1">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        Total Weight: @TotalWeight.ToString("0.##")% (Balanced)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 fs-6 fw-bold">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-1">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="12" y1="8" x2="12" y2="12"></line>
                                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                        </svg>
                                        Total Weight: @TotalWeight.ToString("0.##")% (Must equal 100%)
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Visual Distribution Bar -->
                        <div class="weight-progress-wrap mb-4">
                            <div class="weight-progress-bar">
                                <div class="weight-slice quality" style="width: @(Settings.QualityWeight)%;" title="Quality: @(Settings.QualityWeight)%"></div>
                                <div class="weight-slice delivery" style="width: @(Settings.DeliveryWeight)%;" title="Delivery: @(Settings.DeliveryWeight)%"></div>
                                <div class="weight-slice price" style="width: @(Settings.PriceWeight)%;" title="Price: @(Settings.PriceWeight)%"></div>
                                <div class="weight-slice reliability" style="width: @(Settings.ReliabilityWeight)%;" title="Reliability: @(Settings.ReliabilityWeight)%"></div>
                            </div>
                            <div class="weight-legend-row mt-2 d-flex flex-wrap gap-3">
                                <div class="legend-item"><span class="dot quality"></span> Quality: <strong>@(Settings.QualityWeight)%</strong></div>
                                <div class="legend-item"><span class="dot delivery"></span> Delivery: <strong>@(Settings.DeliveryWeight)%</strong></div>
                                <div class="legend-item"><span class="dot price"></span> Price: <strong>@(Settings.PriceWeight)%</strong></div>
                                <div class="legend-item"><span class="dot reliability"></span> Reliability: <strong>@(Settings.ReliabilityWeight)%</strong></div>
                            </div>
                        </div>

                        <!-- Slider / Input Rows -->
                        <div class="row g-4">
                            <!-- Quality Weight -->
                            <div class="col-md-6">
                                <div class="weight-control-box p-3 rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold text-dark mb-0">Product Quality Weight (%)</label>
                                        <input type="number" class="form-control form-control-sm text-end fw-bold" style="width: 80px;" min="0" max="100" step="1" @bind="Settings.QualityWeight" />
                                    </div>
                                    <input type="range" class="form-range" min="0" max="100" step="1" @bind="Settings.QualityWeight" />
                                    <div class="form-text text-muted small">Influence of customer quality ratings on overall composite recommendation rank.</div>
                                </div>
                            </div>

                            <!-- Delivery Weight -->
                            <div class="col-md-6">
                                <div class="weight-control-box p-3 rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold text-dark mb-0">Delivery Speed / Completion Weight (%)</label>
                                        <input type="number" class="form-control form-control-sm text-end fw-bold" style="width: 80px;" min="0" max="100" step="1" @bind="Settings.DeliveryWeight" />
                                    </div>
                                    <input type="range" class="form-range" min="0" max="100" step="1" @bind="Settings.DeliveryWeight" />
                                    <div class="form-text text-muted small">Influence of on-time delivery track record on vendor ranking.</div>
                                </div>
                            </div>

                            <!-- Price Weight -->
                            <div class="col-md-6">
                                <div class="weight-control-box p-3 rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold text-dark mb-0">Price Competitiveness Weight (%)</label>
                                        <input type="number" class="form-control form-control-sm text-end fw-bold" style="width: 80px;" min="0" max="100" step="1" @bind="Settings.PriceWeight" />
                                    </div>
                                    <input type="range" class="form-range" min="0" max="100" step="1" @bind="Settings.PriceWeight" />
                                    <div class="form-text text-muted small">Relative price advantage compared to the lowest quoted market unit price.</div>
                                </div>
                            </div>

                            <!-- Reliability Weight -->
                            <div class="col-md-6">
                                <div class="weight-control-box p-3 rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold text-dark mb-0">Volume &amp; Reliability Max Bonus (%)</label>
                                        <input type="number" class="form-control form-control-sm text-end fw-bold" style="width: 80px;" min="0" max="100" step="1" @bind="Settings.ReliabilityWeight" />
                                    </div>
                                    <input type="range" class="form-range" min="0" max="100" step="1" @bind="Settings.ReliabilityWeight" />
                                    <div class="form-text text-muted small">Maximum cumulative bonus points awarded for proven order volume and verified delivery track record.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 2: RELIABILITY & NEW VENDOR COLD-START BASELINE -->
                    <div class="settings-card mb-4">
                        <h3 class="card-section-title mb-1">Volume &amp; Cold-Start Baseline Rules</h3>
                        <p class="card-section-subtitle mb-4">Control how points accumulate for completed orders and default ratings for newly onboarded vendors.</p>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark mb-1">Reliability Points Per Verified Order</label>
                                <input type="number" class="form-control" min="0.5" step="0.5" @bind="Settings.ReliabilityPointsPerReview" />
                                <div class="form-text text-muted small">Points awarded per verified review/delivery toward the reliability bonus (capped by the Max Bonus weight above).</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark mb-1">Neutral Baseline Score for New Vendors (0 - 100)</label>
                                <input type="number" class="form-control" min="0" max="100" step="1" @bind="Settings.NeutralScoreForNewVendors" />
                                <div class="form-text text-muted small">Default quality and delivery score assigned to new vendors who have zero historical reviews.</div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 3: CONTRACT PRIORITY & RANKING POLICY -->
                    <div class="settings-card mb-4">
                        <h3 class="card-section-title mb-1">Contract Prioritization Policy</h3>
                        <p class="card-section-subtitle mb-3">Enforce long-term supplier commitments and contractual quota compliance.</p>

                        <div class="form-check form-switch p-3 ps-5 rounded-3 border bg-light">
                            <input class="form-check-input fs-5" type="checkbox" role="switch" id="prioritizeContractsSwitch" @bind="Settings.PrioritizeActiveContracts" />
                            <label class="form-check-label fw-bold text-dark ms-2 pt-1" for="prioritizeContractsSwitch">
                                Prioritize Active Usable Contracts Above Non-Contract Vendors
                            </label>
                            <div class="form-text text-muted small ms-2">
                                When enabled, vendors with active contracts and remaining allocation are ranked strictly above non-contract vendors, regardless of raw composite score.
                            </div>
                        </div>
                    </div>

                    <!-- CARD 4: SMART BADGES & RECOMMENDATION RATIONALE -->
                    <div class="settings-card mb-4">
                        <h3 class="card-section-title mb-1">Smart Badge &amp; Rationale Thresholds</h3>
                        <p class="card-section-subtitle mb-4">Configure the minimum rating thresholds required to award badges and highlight high performance in recommendations.</p>

                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark mb-1">Best Quality Badge Threshold</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" min="1.0" max="5.0" step="0.1" @bind="Settings.BestQualityThreshold" />
                                    <span class="input-group-text">/ 5.0</span>
                                </div>
                                <div class="form-text text-muted small">Minimum average product quality rating to earn the "Best Quality" badge.</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark mb-1">Fastest Delivery Badge Threshold</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" min="1.0" max="5.0" step="0.1" @bind="Settings.FastestDeliveryThreshold" />
                                    <span class="input-group-text">/ 5.0</span>
                                </div>
                                <div class="form-text text-muted small">Minimum average delivery speed rating to earn the "Fastest Delivery" badge.</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark mb-1">High Quality Rationale Threshold</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" min="1.0" max="5.0" step="0.1" @bind="Settings.HighQualityRationaleThreshold" />
                                    <span class="input-group-text">/ 5.0</span>
                                </div>
                                <div class="form-text text-muted small">Quality rating to trigger specific high-quality rationales for alternative vendors.</div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </main>
    </div>

    <!-- PROFILE MODAL -->
    @if (ShowProfileModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg border-0 rounded-4">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold">Purchase Manager Profile</h5>
                        <button type="button" class="btn-close" @onclick="CloseProfileModal"></button>
                    </div>
                    <div class="modal-body py-4 text-center">
                        <div class="profile-avatar mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
                            @(DisplayName.Length > 0 ? DisplayName[0].ToString().ToUpper() : "P")
                        </div>
                        <h5 class="fw-bold mb-1">@DisplayName</h5>
                        <p class="text-muted small mb-3">@Auth.Email</p>
                        <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill fw-semibold">
                            Role: Purchase Manager
                        </span>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-secondary w-100 fw-semibold" @onclick="CloseProfileModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
