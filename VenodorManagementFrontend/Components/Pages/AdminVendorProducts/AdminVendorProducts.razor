@page "/admin/vendorproducts"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Vendor Products - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="container py-5">
        <div class="alert alert-warning text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as an Admin user to view this page.</p>
            <button class="btn btn-primary fw-bold px-4" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsAdmin)
{
    <div class="container py-5">
        <div class="alert alert-danger text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-3">You do not have administrative privileges to manage vendor product mappings.</p>
            <button class="btn btn-outline-secondary fw-bold px-4" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="admin-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">

        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION
             ======================================================================= -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/admin")'>
                    <div class="brand-emblem">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">Smart Vendor</span>
                        <span class="brand-sub">Management</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/organizations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                    <path d="M9 22v-4h6v4"></path>
                                    <path d="M8 6h.01"></path>
                                    <path d="M16 6h.01"></path>
                                    <path d="M8 10h.01"></path>
                                    <path d="M16 10h.01"></path>
                                    <path d="M8 14h.01"></path>
                                    <path d="M16 14h.01"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Organizations</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/users")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Users</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/vendors")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Vendors</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/outlets")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Outlets</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/products")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Products</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link active" @onclick='() => Nav.NavigateTo("/admin/vendorproducts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Vendor Products</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/taxrates")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Tax Rates</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/contracts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Contracts</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/admin/profile")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Settings</span>
                        </button>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <button class="collapse-toggle-link" @onclick="ToggleSidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    <span class="collapse-label">Collapse</span>
                </button>
            </div>
        </aside>

        <!-- =======================================================================
             MAIN BODY AREA
             ======================================================================= -->
        <div class="admin-main-wrapper">

            <!-- TOP HEADER BAR -->
            <header class="admin-top-header">
                <div class="header-left">
                    <button class="menu-toggle-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="header-right">
                    <!-- User Profile Dropdown Capsule -->
                    <div class="profile-capsule-wrapper">
                        <div class="profile-capsule" @onclick="ToggleProfileDropdown">
                            <div class="profile-avatar">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <div class="profile-meta">
                                <span class="profile-name">@(string.IsNullOrEmpty(Auth.UserName) ? "System Admin" : Auth.UserName)</span>
                                <span class="profile-role">Administrator</span>
                            </div>
                            <svg class="dropdown-arrow @(IsProfileDropdownOpen ? "open" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>

                        @if (IsProfileDropdownOpen)
                        {
                            <div class="profile-dropdown-menu">
                                <div class="dropdown-header">
                                    <strong>@Auth.CurrentUser?.Email</strong>
                                </div>
                                <button class="dropdown-item" @onclick='() => Nav.NavigateTo("/admin/profile")'>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                    View Profile &amp; Settings
                                </button>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item text-danger" @onclick="HandleLogout">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                    Sign Out
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <!-- MAIN CONTENT CANVAS -->
            <main class="admin-main-content">
                <div class="content-container">

                    <!-- PAGE TITLE & HEADER ACTIONS -->
                    <div class="page-title-row">
                        <div class="page-title-left">
                            <h1 class="page-heading">Vendor Products</h1>
                            <div class="breadcrumbs-bar">
                                <span class="breadcrumb-item breadcrumb-link" @onclick='() => Nav.NavigateTo("/admin")'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                    Dashboard
                                </span>
                                <span class="breadcrumb-separator">&rsaquo;</span>
                                <span class="breadcrumb-item active">Vendor Products</span>
                            </div>
                            <p class="page-subheading">Manage which vendors supply which products, their prices and delivery estimates.</p>
                        </div>

                        <div class="page-title-right">
                            <button type="button" class="btn-add-primary" @onclick="OpenAddForm" disabled="@IsSubmitting">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                Add Mapping
                            </button>
                            <button type="button" class="btn-filter-icon" title="Filter list">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                            </button>
                        </div>
                    </div>

                    <!-- SUCCESS BANNER -->
                    @if (!string.IsNullOrEmpty(SuccessMessage))
                    {
                        <div class="svm-alert svm-alert-success">
                            <div class="d-flex align-items-center gap-2">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>@SuccessMessage</span>
                            </div>
                            <button type="button" class="alert-close-btn" @onclick="() => SuccessMessage = null">&times;</button>
                        </div>
                    }

                    <!-- ERROR BANNER -->
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="svm-alert svm-alert-danger">
                            <div class="d-flex align-items-center gap-2">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                <span>@ErrorMessage</span>
                            </div>
                            <button type="button" class="alert-close-btn" @onclick="() => ErrorMessage = null">&times;</button>
                        </div>
                    }

                    <!-- SUMMARY BANNER CARD -->
                    <div class="mapping-summary-banner">
                        <div class="summary-icon-circle">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                        </div>
                        <div class="summary-info">
                            <span class="summary-title">Total Vendor Product Mappings</span>
                            <h2 class="summary-count">@VendorProducts.Count</h2>
                            <span class="summary-sub">Vendor product mappings in the system</span>
                        </div>
                    </div>

                    <!-- ADD / EDIT FORM WRAPPER -->
                    @if (IsFormOpen)
                    {
                        <div class="form-modal-card">
                            <div class="form-modal-header">
                                <h5 class="form-modal-title">
                                    @(EditingMapping != null ? "Edit Vendor Product Mapping" : "Add Vendor Product Mapping")
                                </h5>
                            </div>
                            <div class="form-modal-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Vendor <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="FormVendorID" disabled="@IsSubmitting">
                                            <option value="0">-- Select Vendor --</option>
                                            @foreach (var v in Vendors)
                                            {
                                                <option value="@v.VendorID">@v.VendorName</option>
                                            }
                                        </select>
                                        @if (FormSubmitted && FormVendorID == 0)
                                        {
                                            <div class="text-danger small mt-1">Vendor is required.</div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Product <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="FormProductID" disabled="@IsSubmitting">
                                            <option value="0">-- Select Product --</option>
                                            @foreach (var p in Products)
                                            {
                                                <option value="@p.ProductID">@p.ProductName (@p.Unit)</option>
                                            }
                                        </select>
                                        @if (FormSubmitted && FormProductID == 0)
                                        {
                                            <div class="text-danger small mt-1">Product is required.</div>
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">Unit Price (Rs.) <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" min="0" step="0.01" @bind="FormUnitPrice" disabled="@IsSubmitting" placeholder="e.g. 45.00" />
                                        @if (FormSubmitted && FormUnitPrice < 0)
                                        {
                                            <div class="text-danger small mt-1">Unit Price must be 0 or greater.</div>
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">Estimated Delivery Days <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" min="1" step="1" @bind="FormDeliveryDays" disabled="@IsSubmitting" placeholder="e.g. 2" />
                                        @if (FormSubmitted && FormDeliveryDays < 1)
                                        {
                                            <div class="text-danger small mt-1">Must be at least 1 day.</div>
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">Status <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="FormStatus" disabled="@IsSubmitting">
                                            <option value="Active">Active</option>
                                            <option value="Inactive">Inactive</option>
                                        </select>
                                    </div>
                                </div>

                                @if (FormSubmitted && IsDuplicateMapping())
                                {
                                    <div class="svm-alert svm-alert-danger mt-3 mb-0">
                                        An Active mapping for this Vendor + Product combination already exists. Edit the existing mapping or choose a different vendor/product.
                                    </div>
                                }

                                <div class="d-flex justify-content-end gap-2 mt-4">
                                    <button type="button" class="btn-form-cancel" @onclick="CloseForm" disabled="@IsSubmitting">CANCEL</button>
                                    <button type="button" class="btn-form-submit" @onclick="HandleSave" disabled="@IsSubmitting">
                                        @if (IsSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        @(EditingMapping != null ? "SAVE CHANGES" : "CREATE MAPPING")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- DELETE CONFIRMATION WRAPPER -->
                    @if (DeletingMapping != null)
                    {
                        <div class="delete-confirm-card">
                            <div class="delete-confirm-body">
                                <h5 class="fw-bold text-danger mb-2">Confirm Delete</h5>
                                <p class="mb-3">
                                    Are you sure you want to delete the mapping for <strong>@GetVendorName(DeletingMapping.VendorID)</strong> supplying <strong>@GetProductName(DeletingMapping.ProductID)</strong>?
                                    <br /><small class="text-muted">This permanently removes the mapping and cannot be undone.</small>
                                </p>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn-form-cancel" @onclick="() => DeletingMapping = null" disabled="@IsSubmitting">CANCEL</button>
                                    <button type="button" class="btn-delete-confirm" @onclick="ConfirmDelete" disabled="@IsSubmitting">
                                        @if (IsSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        YES, DELETE
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- VENDOR PRODUCTS DATA TABLE -->
                    @if (IsLoading)
                    {
                        <div class="table-loading-card">
                            <div class="spinner-border text-success mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h5 class="fw-semibold text-muted">Loading vendor product mappings...</h5>
                        </div>
                    }
                    else if (HasError)
                    {
                        <div class="table-error-card">
                            <h5 class="fw-bold text-danger mb-2">Unable to load vendor product mappings</h5>
                            <p class="text-muted small mb-3">An error occurred while connecting to the server. Please try again.</p>
                            <button class="btn-primary-action px-4" @onclick="LoadData">Try Again</button>
                        </div>
                    }
                    else if (VendorProducts == null || VendorProducts.Count == 0)
                    {
                        <div class="table-empty-card">
                            <h5 class="fw-bold mb-1">No Vendor Product Mappings Found</h5>
                            <p class="text-muted mb-0">No vendor-product mappings exist yet. Click Add Mapping to create the first one.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-card">
                            <div class="table-responsive">
                                <table class="mapping-table">
                                    <thead>
                                        <tr>
                                            <th class="th-vendor">VENDOR</th>
                                            <th class="th-prod">PRODUCT</th>
                                            <th class="th-price">UNIT PRICE</th>
                                            <th class="th-deliv">EST. DELIVERY</th>
                                            <th class="th-status">STATUS</th>
                                            <th class="th-actions">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var vp in VendorProducts)
                                        {
                                            var currentVp = vp;
                                            bool isActive = string.Equals(currentVp.Status, "Active", StringComparison.OrdinalIgnoreCase);
                                            string vendorName = GetVendorName(currentVp.VendorID);
                                            string productName = GetProductName(currentVp.ProductID);

                                            <tr class="mapping-row @(SelectedMappingDetails?.VendorProductID == currentVp.VendorProductID ? "row-selected" : "")">
                                                <td class="td-vendor">
                                                    <span class="vendor-name-link" @onclick="() => OpenDetailsDrawer(currentVp)" title="Click to view details">
                                                        @vendorName
                                                    </span>
                                                </td>
                                                <td class="td-prod">@productName</td>
                                                <td class="td-price">Rs. @currentVp.UnitPrice.ToString("N2")</td>
                                                <td class="td-deliv">@currentVp.EstimatedDeliveryDays day@(currentVp.EstimatedDeliveryDays == 1 ? "" : "s")</td>
                                                <td class="td-status">
                                                    <span class="status-indicator">
                                                        <span class="status-dot"></span>
                                                        @(string.IsNullOrWhiteSpace(currentVp.Status) ? "Active" : currentVp.Status)
                                                    </span>
                                                </td>
                                                <td class="td-actions">
                                                    <div class="action-btn-group">
                                                        <button type="button" class="btn-edit-action" @onclick="() => OpenEditForm(currentVp)" title="Edit mapping" disabled="@IsSubmitting">
                                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                            Edit
                                                        </button>
                                                        <button type="button" class="btn-delete-action" @onclick="() => OpenDeleteConfirm(currentVp)" title="Delete mapping" disabled="@IsSubmitting">
                                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                            Delete
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- TABLE FOOTER -->
                            <div class="table-pagination-footer">
                                <span class="pagination-info">
                                    Showing 1 to @VendorProducts.Count of @VendorProducts.Count mappings
                                </span>
                                <div class="pagination-controls">
                                    <button class="page-btn page-arrow" disabled title="Previous page">&lsaquo;</button>
                                    <button class="page-btn page-number active">1</button>
                                    <button class="page-btn page-arrow" disabled title="Next page">&rsaquo;</button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- FOOTER -->
                    <footer class="admin-footer">
                        <p class="footer-text">
                            &copy; @DateTime.Now.Year Smart Vendor Management System &bull; Secured Enterprise Access
                        </p>
                    </footer>

                </div>
            </main>

        </div>

        <!-- =======================================================================
             RIGHT-SIDE MAPPING DETAILS DRAWER / PANEL
             ======================================================================= -->
        @if (SelectedMappingDetails != null)
        {
            var selMapping = SelectedMappingDetails;
            string vendorName = GetVendorName(selMapping.VendorID);
            string productName = GetProductName(selMapping.ProductID);
            var selProduct = GetProduct(selMapping.ProductID);

            <div class="drawer-overlay" @onclick="CloseDetailsDrawer"></div>
            <div class="details-drawer">
                <div class="drawer-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="drawer-icon-circle">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#134E48" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                        </div>
                        <div>
                            <h4 class="drawer-vendor-title">@vendorName</h4>
                            <div class="text-muted small fw-medium">@productName</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="status-indicator">
                                    <span class="status-dot"></span>
                                    @(string.IsNullOrWhiteSpace(selMapping.Status) ? "Active" : selMapping.Status)
                                </span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="drawer-close-btn" @onclick="CloseDetailsDrawer" title="Close Details">&times;</button>
                </div>

                <div class="drawer-body">
                    <!-- SECTION 1: VENDOR INFORMATION -->
                    <div class="drawer-section">
                        <div class="drawer-section-header">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            <h6 class="drawer-section-title">Vendor Information</h6>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Vendor Name</span>
                            <span class="detail-value fw-bold text-dark">@vendorName</span>
                        </div>
                    </div>

                    <!-- SECTION 2: PRODUCT INFORMATION -->
                    <div class="drawer-section">
                        <div class="drawer-section-header">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                            <h6 class="drawer-section-title">Product Information</h6>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Product Name</span>
                            <span class="detail-value fw-bold text-dark">@productName</span>
                        </div>
                        @if (selProduct != null)
                        {
                            <div class="detail-row">
                                <span class="detail-label">Category</span>
                                <span class="detail-value">@(string.IsNullOrWhiteSpace(selProduct.Category) ? "Standard" : selProduct.Category)</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Unit</span>
                                <span class="detail-value">@selProduct.Unit</span>
                            </div>
                        }
                    </div>

                    <!-- SECTION 3: PRICING INFORMATION -->
                    <div class="drawer-section">
                        <div class="drawer-section-header">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            <h6 class="drawer-section-title">Pricing Information</h6>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Unit Price</span>
                            <span class="detail-value fw-bold text-success">Rs. @selMapping.UnitPrice.ToString("N2")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Status</span>
                            <span class="status-active-pill">@(string.IsNullOrWhiteSpace(selMapping.Status) ? "Active" : selMapping.Status)</span>
                        </div>
                    </div>

                    <!-- SECTION 4: DELIVERY INFORMATION -->
                    <div class="drawer-section">
                        <div class="drawer-section-header">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                            <h6 class="drawer-section-title">Delivery Information</h6>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Est. Delivery</span>
                            <span class="detail-value fw-semibold">@selMapping.EstimatedDeliveryDays day@(selMapping.EstimatedDeliveryDays == 1 ? "" : "s")</span>
                        </div>
                    </div>

                    <!-- SECTION 5: SYSTEM INFORMATION -->
                    <div class="drawer-section">
                        <div class="drawer-section-header">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            <h6 class="drawer-section-title">System Information</h6>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Registration Status</span>
                            <span class="status-active-badge">Active</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Classification</span>
                            <span class="detail-value">Verified Vendor Mapping</span>
                        </div>
                    </div>
                </div>

                <div class="drawer-footer">
                    <button type="button" class="btn-drawer-edit" @onclick="() => OpenEditForm(selMapping)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        Edit Mapping
                    </button>
                    <button type="button" class="btn-drawer-close" @onclick="CloseDetailsDrawer">
                        Close
                    </button>
                </div>
            </div>
        }

    </div>
}
