@page "/contract/{contractId:int}"
@page "/contract"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Contract Details - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="unauth-container">
        <div class="unauth-card">
            <h4 class="unauth-title">Authentication Required</h4>
            <p class="unauth-desc">Please log in to view contract details.</p>
            <button class="btn-login-redirect" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else
{
    <div class="org-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">
        @if (Auth.IsOutletManager)
        {
        <aside class="org-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/outlet-manager")' style="cursor: pointer;">
                    <div class="brand-emblem">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">OUTLET</span>
                        <span class="brand-sub">WORKSPACE</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/outlet-manager")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/outlet-manager?tab=MyRequests")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <line x1="10" y1="9" x2="8" y2="9"></line>
                                </svg>
                            </span>
                            <span class="nav-label">My Purchase Requests</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/outlet-manager?tab=PurchaseOrders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link active" @onclick='() => Nav.NavigateTo("/outlet-manager?tab=MyContracts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">My Contracts</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/outlet-manager?tab=MyOutlet")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                    <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                                    <path d="M2 7h20"></path>
                                    <path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"></path>
                                </svg>
                            </span>
                            <span class="nav-label">My Outlet</span>
                        </button>
                    </li>
                </ul>

                <ul class="nav-list nav-list-bottom">
                    <li class="nav-item">
                        <button class="nav-link nav-logout" @onclick="HandleLogout">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Logout</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </aside>
        }
        else
        {
        <aside class="org-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                    <div class="brand-emblem">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">Smart Vendor</span>
                        <span class="brand-sub">Management</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/outlets")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <path d="M9 22V12h6v10"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Outlets</span>
                        </button>
                    </li>

                    @if (Auth.IsPurchaseManager || Auth.IsAdmin)
                    {
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>
                    }

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="12" y1="18" x2="12" y2="12"></line>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Quotations</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link active" @onclick='() => Nav.NavigateTo("/organization/contracts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Contracts</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>
                </ul>

                <ul class="nav-list nav-list-bottom">
                    <li class="nav-item">
                        <button class="nav-link nav-logout" @onclick="HandleLogout">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Logout</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </aside>
        }
        <div class="org-main-wrapper">

            <!-- TOP HEADER -->
            <header class="org-top-header">
                <div class="header-left">
                    <button class="menu-toggle-btn" @onclick="ToggleSidebar" title="Toggle Menu">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <div>
                        <h1 class="page-heading">Contract Details</h1>
                        <p class="page-subheading">Comprehensive contract information and performance</p>
                    </div>
                </div>

                <div class="header-right">
                    @if (!string.IsNullOrEmpty(Contract?.OrganizationName))
                    {
                        <span class="topbar-org-badge">@Contract.OrganizationName</span>
                    }
                    <ProfileMenu OrganizationName="@Contract?.OrganizationName" OutletName="@Contract?.OutletName" VendorName="@Contract?.VendorName" />
                </div>
            </header>

            <!-- MAIN CONTENT CANVAS -->
            <main class="org-main-content">
                <div class="content-container">

                    <!-- BREADCRUMB & TOP BACK ACTION -->
                    <div class="top-breadcrumb-row">
                        <div class="breadcrumb-links">
                            <a href="/org-dashboard" class="bc-link">Dashboard</a>
                            <span class="bc-sep">&rsaquo;</span>
                            <a href="/organization/contracts" class="bc-link">Contracts</a>
                            <span class="bc-sep">&rsaquo;</span>
                            <span class="bc-current">Contract Details</span>
                        </div>

                        <button type="button" class="btn-back-dashboard" @onclick="NavigateBack">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            <span>Back to Dashboard</span>
                        </button>
                    </div>

                    <!-- PAGE MAIN HEADING -->
                    <div class="page-title-section">
                        <h1 class="page-main-heading">Contract Details</h1>
                        <p class="page-sub-heading">View contract information, vendor allocation and terms.</p>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="loading-state">
                            <div class="loading-spinner"></div>
                            <h4 class="loading-text">Loading contract details...</h4>
                            <p class="loading-sub">Fetching persisted vendor allocations, financials and terms</p>
                        </div>
                    }
                    else if (HasError || Contract == null)
                    {
                        <div class="error-banner">
                            <div class="error-banner-content">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <span>@ErrorMessage</span>
                            </div>
                            <button type="button" class="btn-back-dashboard" @onclick="NavigateBack">Return</button>
                        </div>
                    }
                    else
                    {
                        <div class="contract-hero-card mb-4">
                            <div class="hero-left">
                                <div class="hero-icon-box">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                    </svg>
                                </div>
                                <div class="hero-info">
                                    <div class="hero-title-row">
                                        <h2 class="hero-contract-title">Contract @Contract.ContractID</h2>
                                        <span class="hero-effective-dates">
                                            Effective: @Contract.StartDate.ToIst("dd MMM yyyy") &ndash; @Contract.EndDate.ToIst("dd MMM yyyy")
                                        </span>
                                    </div>
                                    <div class="hero-meta-row">
                                        <span>Organization: <strong>@Contract.OrganizationName</strong></span>
                                        <span class="meta-bullet">&bull;</span>
                                        <span>Outlet: <strong>@Contract.OutletName</strong></span>
                                    </div>
                                </div>
                            </div>

                            <div class="hero-right">
                                @if (string.Equals(Contract.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="status-pill status-active">
                                            <span>Active</span>
                                        </span>
                                        @if (Auth.IsOrgManager || Auth.IsAdmin)
                                        {
                                            <button type="button" class="btn-end-contract" @onclick="PromptEndContract">
                                                <span>End Contract</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (string.Equals(Contract.Status, "Reached", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="status-pill status-reached">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                            </svg>
                                            <span>Capacity Reached</span>
                                        </span>
                                        @if (Auth.IsOrgManager || Auth.IsAdmin)
                                        {
                                            <button type="button" class="btn-reset-contract" @onclick="PromptReset">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="1 4 1 10 7 10"></polyline>
                                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                                </svg>
                                                <span>Reset Allocation</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (string.Equals(Contract.Status, "Ended", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="status-pill status-ended">Ended</span>
                                }
                                else if (string.Equals(Contract.Status, "Expired", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="status-pill status-expired">Expired</span>
                                        @if (Auth.IsOrgManager || Auth.IsAdmin)
                                        {
                                            <button type="button" class="btn-renew-contract" @onclick='() => Nav.NavigateTo($"/contract/{Contract.ContractID}/renew")'>
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="1 4 1 10 7 10"></polyline>
                                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                                </svg>
                                                <span>Renew Contract</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (string.Equals(Contract.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="status-pill status-completed">Completed</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pending">@Contract.Status</span>
                                }
                            </div>
                        </div>

                        <!-- TWO COLUMN MAIN LAYOUT (MATCHING REFERENCE IMAGE) -->
                        <div class="contract-details-two-col">
                            <div class="details-left-col">

                                <!-- VENDOR & ALLOCATION INFORMATION CARD -->
                                <div class="content-card mb-4">
                                    <div class="card-header-row">
                                        <div class="card-icon-box">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="9" cy="7" r="4"></circle>
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                            </svg>
                                        </div>
                                        <h3 class="card-section-title">Vendor &amp; Allocation Information</h3>
                                    </div>

                                    <!-- Key Details Row Above Table -->
                                    <div class="vendor-meta-grid">
                                        <div class="vendor-meta-item">
                                            <span class="vmeta-label">Primary Vendor</span>
                                            <span class="vmeta-val text-success fw-bold">@Contract.VendorName</span>
                                        </div>
                                        <div class="vendor-meta-item">
                                            <span class="vmeta-label">Payment Method</span>
                                            <span class="vmeta-val">@Contract.PaymentMethod</span>
                                        </div>
                                    </div>

                                    <!-- ALLOCATION TABLE -->
                                    <div class="alloc-table-wrap">
                                        <table class="alloc-table">
                                            <thead>
                                                <tr>
                                                    <th>VENDOR</th>
                                                    <th class="text-center">ALLOCATION %</th>
                                                    <th class="text-center">ALLOCATED QTY</th>
                                                    <th class="text-center">USED QTY</th>
                                                    <th class="text-center">STATUS</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Contract.Allocations != null && Contract.Allocations.Count > 0)
                                                {
                                                    @foreach (var alloc in Contract.Allocations)
                                                    {
                                                        <tr>
                                                            <td class="vendor-title-cell">
                                                                <strong>@(string.IsNullOrWhiteSpace(alloc.VendorName) ? Contract.VendorName : alloc.VendorName)</strong>
                                                            </td>
                                                            <td class="text-center">
                                                                @alloc.AllocationPercentage.ToString("0.00")%
                                                            </td>
                                                            <td class="text-center text-success fw-bold">
                                                                @alloc.AllocatedQuantity.ToString("N2") @Contract.Unit
                                                            </td>
                                                            <td class="text-center">
                                                                @alloc.UsedQuantity.ToString("N2") @Contract.Unit
                                                            </td>
                                                            <td class="text-center">
                                                                <span class="badge-active-tag">Active</span>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td class="vendor-title-cell">
                                                            <strong>@Contract.VendorName</strong>
                                                        </td>
                                                        <td class="text-center">100.00%</td>
                                                        <td class="text-center text-success fw-bold">@Contract.TotalQuantity.ToString("N2") @Contract.Unit</td>
                                                        <td class="text-center">@Contract.UsedQuantity.ToString("N2") @Contract.Unit</td>
                                                        <td class="text-center">
                                                            <span class="badge-active-tag">Active</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- PRODUCTS / CONTRACT TRACKING CARD -->
                                <div class="content-card">
                                    <div class="card-header-row">
                                        <div class="card-icon-box">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
                                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                            </svg>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between flex-grow-1">
                                            <h3 class="card-section-title mb-0">Products / Contract Tracking</h3>
                                            @if (Contract.ContractProducts != null && Contract.ContractProducts.Count > 1)
                                            {
                                                <span class="badge bg-light text-dark fw-bold border">@Contract.ContractProducts.Count Products</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- PRODUCT TRACKING TABLE -->
                                    <div class="alloc-table-wrap">
                                        <table class="alloc-table">
                                            <thead>
                                                <tr>
                                                    <th>PRODUCT</th>
                                                    <th class="text-center">UNIT PRICE</th>
                                                    <th class="text-center">CONTRACTED</th>
                                                    <th class="text-center">PURCHASED</th>
                                                    <th class="text-center">REMAINING</th>
                                                    <th class="text-center">EXTRA ORDER</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Contract.ContractProducts != null && Contract.ContractProducts.Count > 0)
                                                {
                                                    @foreach (var prod in Contract.ContractProducts)
                                                    {
                                                        string unit = string.IsNullOrWhiteSpace(prod.Unit) ? Contract.Unit : prod.Unit;
                                                        decimal unitPrice = (prod.UnitPrice.HasValue && prod.UnitPrice.Value > 0) ? prod.UnitPrice.Value : Contract.UnitPrice;
                                                        <tr>
                                                            <td class="vendor-title-cell">
                                                                <strong>@prod.ProductName</strong>
                                                            </td>
                                                            <td class="text-center">
                                                                @(unitPrice > 0 ? $"Rs. {unitPrice:N2}" : "-")
                                                            </td>
                                                            <td class="text-center text-success fw-bold">
                                                                @prod.ContractQuantity.ToString("N2") @unit
                                                            </td>
                                                            <td class="text-center fw-bold">
                                                                @prod.PurchasedQuantity.ToString("N2") @unit
                                                            </td>
                                                            <td class="text-center text-success fw-bold">
                                                                @prod.RemainingQuantity.ToString("N2") @unit
                                                            </td>
                                                            <td class="text-center">
                                                                @if (prod.ExtraOrderQuantity > 0)
                                                                {
                                                                    <span class="text-warning fw-bold">+@prod.ExtraOrderQuantity.ToString("N2") @unit</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">0.00 @unit</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td class="vendor-title-cell">
                                                            <strong>@Contract.ProductName</strong>
                                                        </td>
                                                        <td class="text-center">
                                                            @(Contract.UnitPrice > 0 ? $"Rs. {Contract.UnitPrice:N2}" : "-")
                                                        </td>
                                                        <td class="text-center text-success fw-bold">
                                                            @Contract.TotalQuantity.ToString("N2") @Contract.Unit
                                                        </td>
                                                        <td class="text-center fw-bold">
                                                            @Contract.UsedQuantity.ToString("N2") @Contract.Unit
                                                        </td>
                                                        <td class="text-center text-success fw-bold">
                                                            @RemainingQuantity.ToString("N2") @Contract.Unit
                                                        </td>
                                                        <td class="text-center">
                                                            @if (ExtraOrderQuantity > 0)
                                                            {
                                                                <span class="text-warning fw-bold">+@ExtraOrderQuantity.ToString("N2") @Contract.Unit</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">0.00 @Contract.Unit</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- CONTRACT-LEVEL SUMMARY (PRESERVING OVERALL CONTRACT TOTAL) -->
                                    <div class="contract-tracking-summary-bar mt-3 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <span class="text-muted small">
                                            Contract Summary (@(Contract.ContractProducts?.Count ?? 1) @(Contract.ContractProducts?.Count == 1 ? "Product" : "Products")):
                                        </span>
                                        <div class="d-flex align-items-center gap-3 small flex-wrap">
                                            <span>Total Contracted: <strong class="text-success">@Contract.TotalQuantity.ToString("N2") @Contract.Unit</strong></span>
                                            <span class="text-muted">&bull;</span>
                                            <span>Total Purchased: <strong>@Contract.UsedQuantity.ToString("N2") @Contract.Unit</strong></span>
                                            <span class="text-muted">&bull;</span>
                                            <span>Total Remaining: <strong class="text-success">@RemainingQuantity.ToString("N2") @Contract.Unit</strong></span>
                                            @if (ExtraOrderQuantity > 0)
                                            {
                                                <span class="text-muted">&bull;</span>
                                                <span>Total Extra: <strong class="text-warning">+@ExtraOrderQuantity.ToString("N2") @Contract.Unit</strong></span>
                                            }
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="details-right-col">
                                <div class="content-card h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="card-header-row">
                                            <div class="card-icon-box">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                                                    <line x1="8" y1="6" x2="16" y2="6"></line>
                                                    <line x1="16" y1="14" x2="16" y2="18"></line>
                                                    <path d="M16 10h.01"></path>
                                                    <path d="M12 10h.01"></path>
                                                    <path d="M8 10h.01"></path>
                                                    <path d="M12 14h.01"></path>
                                                    <path d="M8 14h.01"></path>
                                                    <path d="M12 18h.01"></path>
                                                    <path d="M8 18h.01"></path>
                                                </svg>
                                            </div>
                                            <h3 class="card-section-title">Contract Terms &amp; Financials</h3>
                                        </div>

                                        <!-- Unit Price & Tax Row -->
                                        <div class="financials-row">
                                            <div class="fin-item">
                                                <span class="fin-label">Unit Price</span>
                                                @if (Contract.ContractProducts != null && Contract.ContractProducts.Count > 1 && Contract.ContractProducts.Any(cp => cp.UnitPrice.HasValue && cp.UnitPrice > 0))
                                                {
                                                    var pricedProducts = Contract.ContractProducts.Where(p => p.UnitPrice.HasValue && p.UnitPrice > 0).ToList();
                                                    var minPrice = pricedProducts.Min(p => p.UnitPrice!.Value);
                                                    var maxPrice = pricedProducts.Max(p => p.UnitPrice!.Value);
                                                    if (minPrice == maxPrice)
                                                    {
                                                        <span class="fin-val">Rs. @minPrice.ToString("N2")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="fin-val" title="Per-product pricing in tracking table">Rs. @minPrice.ToString("N2") &ndash; @maxPrice.ToString("N2")</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="fin-val">Rs. @Contract.UnitPrice.ToString("N2")</span>
                                                }
                                            </div>
                                            <div class="fin-item">
                                                <span class="fin-label">Tax Amount</span>
                                                <span class="fin-val">Rs. @Contract.TaxAmount.ToString("N2")</span>
                                            </div>
                                        </div>

                                        <!-- Total Estimated Contract Value -->
                                        <div class="contract-total-box">
                                            <span class="total-box-label">Total Estimated Contract Value</span>
                                            <span class="total-box-val">Rs. @ComputedTotalValue.ToString("N2")</span>
                                        </div>

                                        <!-- Dates Row -->
                                        <div class="contract-dates-row">
                                            <div class="cdate-item">
                                                <span class="cdate-label">Start Date</span>
                                                <span class="cdate-val">@Contract.StartDate.ToIst("dd MMM yyyy")</span>
                                            </div>
                                            <div class="cdate-item">
                                                <span class="cdate-label">End Date</span>
                                                <span class="cdate-val">@Contract.EndDate.ToIst("dd MMM yyyy")</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- BOTTOM RETURN TO WORKSPACE ACTION -->
                                    <div class="return-action-wrap mt-4">
                                        <button type="button" class="btn-return-workspace" @onclick="NavigateBack">
                                            Return to Workspace
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }

                </div>
            </main>
        </div>
    </div>
}

@if (IsResetModalOpen && Contract != null)
{
    <div class="reset-modal-backdrop" @onclick="CancelReset">
        <div class="reset-modal-content" @onclick:stopPropagation="true">
            <div class="reset-modal-header">
                <div class="reset-header-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="reset-modal-title">Reset Contract Allocation</h3>
                    <p class="reset-modal-sub">Contract #@Contract.ContractID &bull; @Contract.OutletName</p>
                </div>
                <button type="button" class="btn-close-reset" @onclick="CancelReset" aria-label="Close">&times;</button>
            </div>

            <div class="reset-modal-body">
                <div class="reset-info-box">
                    <div class="reset-info-row">
                        <span class="info-label">Product:</span>
                        <span class="info-val fw-bold">@GetContractProductsSummary()</span>
                    </div>
                    <div class="reset-info-row">
                        <span class="info-label">Total Commitment:</span>
                        <span class="info-val">@Contract.TotalQuantity.ToString("N2") @Contract.Unit</span>
                    </div>
                    <div class="reset-info-row">
                        <span class="info-label">Current Usage:</span>
                        <span class="info-val text-danger fw-bold">@Contract.UsedQuantity.ToString("N2") @Contract.Unit (100% Reached)</span>
                    </div>
                </div>

                <div class="reset-alert-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2 text-warning flex-shrink-0">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                    <span>
                        Resetting this contract will restore its status to <strong>Active</strong> and set <strong>Used Quantity to 0</strong> for all allocations. This allows new Purchase Orders to utilize the contracted volume again.
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(ResetErrorMessage))
                {
                    <div class="alert alert-danger mt-3 py-2 small" role="alert">
                        @ResetErrorMessage
                    </div>
                }
            </div>

            <div class="reset-modal-footer">
                <button type="button" class="btn-cancel-reset" @onclick="CancelReset" disabled="@IsResetting">Cancel</button>
                <button type="button" class="btn-confirm-reset" @onclick="ExecuteResetContractAsync" disabled="@IsResetting">
                    @if (IsResetting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Resetting...</span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-1">
                            <polyline points="1 4 1 10 7 10"></polyline>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                        </svg>
                        <span>Yes, Reset Contract</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (IsEndModalOpen && Contract != null)
{
    <div class="reset-modal-backdrop" @onclick="CancelEndContract">
        <div class="reset-modal-content" @onclick:stopPropagation="true">
            <div class="reset-modal-header">
                <div class="reset-header-icon" style="background-color: #FEE2E2; color: #DC2626;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>
                <div>
                    <h3 class="reset-modal-title">End Contract</h3>
                    <p class="reset-modal-sub">Contract #@Contract.ContractID &bull; @Contract.OutletName</p>
                </div>
                <button type="button" class="btn-close-reset" @onclick="CancelEndContract" aria-label="Close">&times;</button>
            </div>

            <div class="reset-modal-body">
                <div class="reset-info-box">
                    <div class="reset-info-row">
                        <span class="info-label">Product:</span>
                        <span class="info-val fw-bold">@GetContractProductsSummary()</span>
                    </div>
                    <div class="reset-info-row">
                        <span class="info-label">Vendor:</span>
                        <span class="info-val fw-bold">@Contract.VendorName</span>
                    </div>
                    <div class="reset-info-row">
                        <span class="info-label">Total Commitment:</span>
                        <span class="info-val">@Contract.TotalQuantity.ToString("N2") @Contract.Unit</span>
                    </div>
                    <div class="reset-info-row">
                        <span class="info-label">Status:</span>
                        <span class="info-val fw-bold">@Contract.Status</span>
                    </div>
                </div>

                <div class="reset-alert-box" style="background-color: #FEF2F2; border-color: #FECACA; color: #991B1B;">
                    <span>
                        Are you sure you want to end this contract? The contract will remain in history but will no longer be treated as active.
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(EndErrorMessage))
                {
                    <div class="alert alert-danger mt-3 py-2 small" role="alert">
                        @EndErrorMessage
                    </div>
                }
            </div>

            <div class="reset-modal-footer">
                <button type="button" class="btn-cancel-reset" @onclick="CancelEndContract" disabled="@IsEnding">Cancel</button>
                <button type="button" class="btn-confirm-reset" style="background-color: #DC2626;" @onclick="ExecuteEndContractAsync" disabled="@IsEnding">
                    @if (IsEnding)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Ending Contract...</span>
                    }
                    else
                    {
                        <span>Confirm End Contract</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
