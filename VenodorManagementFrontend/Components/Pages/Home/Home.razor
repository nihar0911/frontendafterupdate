@page "/"
@page "/login"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Sign In - Smart Vendor Management System</PageTitle>

<div class="svm-login-page">
    <div class="svm-login-wrapper">

        <!-- BRANDING -->
        <div class="svm-branding">
            <div class="svm-brand-icon">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="3" width="16" height="18" rx="2" ry="2"></rect>
                    <rect x="8" y="7" width="2" height="2"></rect>
                    <rect x="14" y="7" width="2" height="2"></rect>
                    <rect x="8" y="12" width="2" height="2"></rect>
                    <rect x="14" y="12" width="2" height="2"></rect>
                    <path d="M10 21v-4h4v4"></path>
                </svg>
            </div>
            <h1 class="svm-brand-title">Smart Vendor Management</h1>
            <p class="svm-brand-subtitle">Enterprise Procurement &amp; Vendor Allocation Platform</p>
        </div>

        <!-- MAIN LOGIN CARD -->
        <div class="svm-card svm-login-card">

            @if (Auth.IsAuthenticated)
            {
                <div class="svm-already-signed-in">
                    <div class="svm-session-badge">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Signed in as @Auth.Role
                    </div>
                    <p class="svm-session-info"><span class="svm-label-inline">Account:</span> <strong>@Auth.CurrentUser?.Email</strong></p>
                    <p class="svm-session-info mb-3"><span class="svm-label-inline">Name:</span> <strong>@Auth.UserName</strong></p>

                    @if (Auth.IsAdmin)
                    {
                        <button class="btn svm-btn-primary w-100 mb-2" @onclick='() => Nav.NavigateTo("/admin")'>
                            Go to Admin Dashboard &rarr;
                        </button>
                    }
                    else if (Auth.IsOrgManager)
                    {
                        <button class="btn svm-btn-primary w-100 mb-2" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                            Go to Organization Dashboard &rarr;
                        </button>
                    }
                    else if (Auth.IsVendorManager)
                    {
                        <button class="btn svm-btn-primary w-100 mb-2" @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                            Go to Vendor Dashboard &rarr;
                        </button>
                    }
                    else if (Auth.IsOutletManager)
                    {
                        <button class="btn svm-btn-primary w-100 mb-2" @onclick='() => Nav.NavigateTo("/outlet-manager")'>
                            Go to Outlet Dashboard &rarr;
                        </button>
                    }
                    else if (Auth.IsPurchaseManager)
                    {
                        <button class="btn svm-btn-primary w-100 mb-2" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                            Go to Purchase Manager Dashboard &rarr;
                        </button>
                    }

                    <button class="btn svm-btn-ghost w-100 mt-1" @onclick="HandleLogout">
                        Sign Out / Switch Account
                    </button>
                </div>
            }
            else
            {
                <!-- LOGIN HEADER -->
                <div class="svm-card-heading">
                    <h2 class="svm-signin-title">Login</h2>
                </div>

                <!-- ERROR MESSAGE -->
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="svm-error-alert" role="alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        @ErrorMessage
                    </div>
                }

                <!-- FORM -->
                <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
                    <div class="svm-field">
                        <label class="svm-label" for="login-email">Email Address</label>
                        <div class="svm-input-wrapper">
                            <svg class="svm-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                            </svg>
                            <input id="login-email"
                                   type="email"
                                   class="svm-input"
                                   @bind="Email"
                                   @bind:event="oninput"
                                   placeholder="name@example.com"
                                   autocomplete="email"
                                   required />
                        </div>
                    </div>

                    <div class="svm-field">
                        <label class="svm-label" for="login-password">Password</label>
                        <div class="svm-input-wrapper">
                            <svg class="svm-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <input id="login-password"
                                   type="@(ShowPassword ? "text" : "password")"
                                   class="svm-input svm-input-password"
                                   @bind="Password"
                                   @bind:event="oninput"
                                   placeholder="••••••••"
                                   autocomplete="current-password"
                                   required />
                            <button type="button" 
                                    class="svm-password-toggle" 
                                    @onclick="ToggleShowPassword"
                                    title="@(ShowPassword ? "Hide password" : "Show password")"
                                    tabindex="-1">
                                @if (ShowPassword)
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                }
                                else
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn svm-btn-primary w-100 svm-signin-btn" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>SIGN IN &rarr;</span>
                        }
                    </button>
                </form>
            }
        </div>

        <!-- FOOTER -->
        <p class="svm-footer-text">
            &copy; Smart Vendor Management System &bull; Secured Enterprise Access
        </p>

    </div>
</div>
