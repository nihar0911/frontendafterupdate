                                <div class="om-po-search-box">
                                    <svg class="om-po-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                    <input type="text" class="om-po-search-input" placeholder="Search by PO #, vendor or product..." @bind="PoSearchQuery" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="om-card-body p-0">
                                @if (FilteredPOs == null || FilteredPOs.Count == 0)
                                {
                                    <div class="p-5 text-center text-muted">
                                        <div class="mb-3">
                                            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="1" y="3" width="15" height="13"></rect>
                                                <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                                <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                            </svg>
                                        </div>
                                        <h6 class="fw-bold mb-1 text-dark">No Purchase Orders Found</h6>
                                        <p class="mb-0 small">There are currently no purchase orders matching your search or assigned to your outlet.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="om-po-clean-table">
                                            <thead>
                                                <tr>
                                                    <th>PO Reference</th>
                                                    <th>Vendor</th>
                                                    <th>Product</th>
                                                    <th>Quantity</th>
                                                    <th>Status</th>
                                                    <th>Last Updated</th>
                                                    <th class="text-end">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var po in FilteredPOs)
                                                {
                                                    <tr class="om-po-row" @onclick='() => OpenPurchaseOrderDetails(po.PurchaseOrderID)'>
                                                        <td class="om-po-col-ref">
                                                            <span class="om-po-ref-text">PO-@po.PurchaseOrderID</span>
                                                        </td>
                                                        <td class="om-po-col-vendor">
                                                            <span>@(string.IsNullOrWhiteSpace(po.VendorName) ? $"Vendor #{po.VendorID}" : po.VendorName)</span>
                                                        </td>
                                                        <td class="om-po-col-product">
                                                            <span>@GetPrimaryProductName(po)</span>
                                                        </td>
                                                        <td class="om-po-col-qty">
                                                            <span>@GetPrimaryProductQty(po)</span>
                                                        </td>
                                                        <td class="om-po-col-status">
                                                            @if (po.Status == "Dispatched" || po.Status == "In Transit")
                                                            {
                                                                <div class="d-flex flex-column align-items-start">
                                                                    <span class="om-po-pill-dispatched">Dispatched</span>
                                                                    <span class="om-po-subdate">@po.OrderDate.ToIst("dd MMM yyyy, hh:mm tt")</span>
                                                                </div>
                                                            }
                                                            else if (po.Status == "Delivered" || po.Status == "Completed")
                                                            {
                                                                <div class="d-flex flex-column align-items-start">
                                                                    <span class="om-po-pill-delivered">Delivered</span>
                                                                    <span class="om-po-subdate">@((po.ActualDeliveryDate ?? po.OrderDate).ToIst("dd MMM yyyy, hh:mm tt"))</span>
                                                                </div>
                                                            }
                                                            else if (po.Status == "Accepted")
                                                            {
                                                                <div class="d-flex flex-column align-items-start">
                                                                    <span class="om-po-pill-accepted">Accepted</span>
                                                                    <span class="om-po-subdate">Accepted by Vendor</span>
                                                                </div>
                                                            }
                                                            else if (po.Status == "Rejected")
                                                            {
                                                                <div class="d-flex flex-column align-items-start">
                                                                    <span class="om-po-pill-rejected">Rejected</span>
                                                                    <span class="om-po-subdate">Declined</span>
                                                                </div>
                                                            }
                                                            else if (po.Status == "Awaiting Approval" || po.Status == "AwaitingApproval")
                                                            {
                                                                <div class="d-flex flex-column align-items-start">
                                                                    <span class="om-po-pill-pending">Awaiting Approval</span>
                                                                    <span class="om-po-subdate">@(CanApprovePo(po) ? "Waiting for your approval" : "Not placed with vendor yet")</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex flex-column align-items-start">
                                                                    <span class="om-po-pill-pending">Pending</span>
                                                                    <span class="om-po-subdate">Pending Vendor Confirmation</span>
                                                                </div>
                                                            }
                                                        </td>
                                                        <td class="om-po-col-date">
                                                            <div class="d-flex flex-column">
                                                                <span class="fw-semibold text-dark">@((po.ActualDeliveryDate ?? po.OrderDate).ToIst("dd MMM yyyy"))</span>
                                                                <span class="om-po-subdate">@((po.ActualDeliveryDate ?? po.OrderDate).ToIst("hh:mm tt"))</span>
                                                            </div>
                                                        </td>
                                                        <td class="om-po-col-action text-end">
                                                            @if (CanApprovePo(po))
                                                            {
                                                                <button type="button" class="btn btn-success btn-sm me-1" @onclick="() => HandleApprovePo(po.PurchaseOrderID)" @onclick:stopPropagation="true" disabled="@IsPoActionProcessing">Approve</button>
                                                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => HandleRejectPo(po.PurchaseOrderID)" @onclick:stopPropagation="true" disabled="@IsPoActionProcessing">Reject</button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="om-btn-view-status" @onclick='() => OpenPurchaseOrderDetails(po.PurchaseOrderID)' @onclick:stopPropagation="true">
                                                                    <span>View Status</span>
                                                                    <span>&rarr;</span>
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- PAGINATION FOOTER -->
                                    <div class="om-po-pagination-footer">
                                        <span class="om-po-pagination-text">Showing 1 to @FilteredPOs.Count of @FilteredPOs.Count orders</span>
                                        <div class="om-po-page-pills">
                                            <button type="button" class="om-po-page-arrow" disabled>&lsaquo;</button>
                                            <button type="button" class="om-po-page-num active">1</button>
                                            <button type="button" class="om-po-page-arrow" disabled>&rsaquo;</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- ===============================================================
                     TAB 4: MY PROFILE VIEW
                     =============================================================== -->
                else if (ActiveTab == "MyProfile")
                {
                    <div class="row justify-content-center">
                        <div class="col-lg-7">
                            <div class="om-card">
                                <div class="om-card-header">
                                    <h3 class="om-card-title">Outlet Manager Profile</h3>
                                </div>
                                <div class="om-card-body p-4">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="om-field-label">NAME</label>
                                            <div class="om-field-val fw-bold">@OutletManagerName</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="om-field-label">EMAIL</label>
                                            <div class="om-field-val">@(Auth.CurrentUser?.Email ?? (Auth.Email ?? string.Empty))</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="om-field-label">ROLE</label>
                                            <div class="om-field-val text-green fw-bold">Outlet Manager</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="om-field-label">ASSIGNED OUTLET</label>
                                            <div class="om-field-val fw-bold">@OutletNameDisplay</div>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                                        <button type="button" class="btn btn-outline-danger fw-bold px-4 py-2" @onclick="HandleLogout">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                                <polyline points="16 17 21 12 16 7"></polyline>
                                                <line x1="21" y1="12" x2="9" y2="12"></line>
                                            </svg>
                                            <span>Logout</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            }

        </main>

        <!-- ===================================================================
             PURCHASE ORDER STATUS & DETAILS MODAL (MATCHES SCREENSHOT 1 DESIGN)
             =================================================================== -->
        @if (ShowPoDetailsModal && SelectedPurchaseOrder != null)
        {
            var primaryItem = SelectedPurchaseOrder.Items?.FirstOrDefault();
            string prodName = primaryItem != null ? GetProductName(primaryItem.ProductID) : "General Goods";
            string prodUnit = primaryItem != null ? GetProductUnit(primaryItem.ProductID) : "units";
            decimal orderedQty = primaryItem?.Quantity ?? 0;
            var primaryDeliveryRecord = DeliveryRecordsForSelectedPo.FirstOrDefault();

            <div class="om-modal-overlay" @onclick="ClosePoDetailsModal">
                <div class="om-po-drawer-card" @onclick:stopPropagation="true">
                    <!-- HEADER -->
                    <div class="om-po-drawer-header">
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h4 class="mb-0 fw-bold text-dark" style="font-size: 1.1rem;">PO-@SelectedPurchaseOrder.PurchaseOrderID</h4>
                                @if (SelectedPurchaseOrder.Status == "Dispatched" || SelectedPurchaseOrder.Status == "In Transit")
                                {
                                    <span class="om-po-pill-dispatched">Dispatched</span>
                                }
                                else if (SelectedPurchaseOrder.Status == "Delivered" || SelectedPurchaseOrder.Status == "Completed")
                                {
                                    <span class="om-po-pill-delivered">Delivered</span>
                                }
                                else if (SelectedPurchaseOrder.Status == "Accepted")
                                {
                                    <span class="om-po-pill-accepted">Accepted</span>
                                }
                                else if (SelectedPurchaseOrder.Status == "Rejected")
                                {
                                    <span class="om-po-pill-rejected">Rejected</span>
                                }
                                else
                                {
                                    <span class="om-po-pill-pending">Pending</span>
                                }
                            </div>
                            <span class="text-muted small">Vendor: @(string.IsNullOrWhiteSpace(SelectedPurchaseOrder.VendorName) ? $"Vendor #{SelectedPurchaseOrder.VendorID}" : SelectedPurchaseOrder.VendorName)</span>
                        </div>
                        <button type="button" class="btn-close" @onclick="ClosePoDetailsModal" aria-label="Close"></button>
                    </div>

                    <div class="om-po-drawer-body">

                        <!-- ALERTS -->
                        @if (!string.IsNullOrWhiteSpace(DeliverySuccessMessage))
                        {
                            <div class="alert alert-success d-flex align-items-center justify-content-between mb-3 shadow-sm rounded-3 py-2 px-3">
                                <div class="d-flex align-items-center gap-2">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span class="small fw-semibold">@DeliverySuccessMessage</span>
                                </div>
                                <button type="button" class="btn-close btn-close-sm" @onclick="() => DeliverySuccessMessage = string.Empty"></button>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(DeliveryFormError))
                        {
                            <div class="alert alert-danger d-flex align-items-center justify-content-between mb-3 shadow-sm rounded-3 py-2 px-3">
                                <div class="d-flex align-items-center gap-2">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    <span class="small fw-semibold">@DeliveryFormError</span>
                                </div>
                                <button type="button" class="btn-close btn-close-sm" @onclick="() => DeliveryFormError = string.Empty"></button>
                            </div>
                        }

                        <!-- =======================================================
                             VIEW MODE: STANDARD PO DETAILS
                             ======================================================= -->
                        @if (!IsRecordingDelivery && !IsReviewingDelivery)
                        {
                            <!-- 2-COLUMN ORDER DETAILS GRID -->
                            <div class="om-po-details-grid mb-4">
                                <div class="om-po-grid-item">
                                    <span class="om-po-grid-label">Product</span>
                                    <span class="om-po-grid-value">@prodName</span>
                                </div>
                                <div class="om-po-grid-item">
                                    <span class="om-po-grid-label">Order Date</span>
                                    <span class="om-po-grid-value">@SelectedPurchaseOrder.OrderDate.ToIst("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                                <div class="om-po-grid-item">
                                    <span class="om-po-grid-label">Ordered Quantity</span>
                                    <span class="om-po-grid-value">@orderedQty.ToString("0.##") @prodUnit</span>
                                </div>
                                <div class="om-po-grid-item">
                                    <span class="om-po-grid-label">Ordered By</span>
                                    <span class="om-po-grid-value">@(string.IsNullOrWhiteSpace(OrganizationNameDisplay) ? "Organization Manager" : OrganizationNameDisplay)</span>
                                </div>
                                <div class="om-po-grid-item">
                                    <span class="om-po-grid-label">Expected Delivery</span>
                                    <span class="om-po-grid-value">@(SelectedPurchaseOrder.ExpectedDeliveryDate?.ToIst("dd MMM yyyy") ?? SelectedPurchaseOrder.OrderDate.AddDays(2).ToIst("dd MMM yyyy"))</span>
                                </div>
                                @if (SelectedPurchaseOrder.Status == "Dispatched" || SelectedPurchaseOrder.Status == "In Transit" || SelectedPurchaseOrder.Status == "Delivered" || SelectedPurchaseOrder.Status == "Completed")
                                {
                                    <div class="om-po-grid-item">
                                        <span class="om-po-grid-label">Dispatched On</span>
                                        <span class="om-po-grid-value">@(SelectedPurchaseOrder.DispatchDateTime.HasValue ? SelectedPurchaseOrder.DispatchDateTime.Value.ToIst("dd MMM yyyy, hh:mm tt") : "Dispatched")</span>
                                    </div>
                                }
                                @if (SelectedPurchaseOrder.Status == "Delivered" || SelectedPurchaseOrder.Status == "Completed")
                                {
                                    <div class="om-po-grid-item">
                                        <span class="om-po-grid-label">Delivered On</span>
                                        <span class="om-po-grid-value text-success fw-bold">@((SelectedPurchaseOrder.ActualDeliveryDate ?? primaryDeliveryRecord?.DeliveryDate ?? SelectedPurchaseOrder.OrderDate).ToIst("dd MMM yyyy, hh:mm tt"))</span>
                                    </div>
                                    <div class="om-po-grid-item">
                                        <span class="om-po-grid-label">Delivery Performance</span>
                                        <span class="badge @(GetDeliveryPerformanceBadge(SelectedPurchaseOrder, primaryDeliveryRecord)) fw-semibold">
                                            @GetDeliveryPerformanceText(SelectedPurchaseOrder, primaryDeliveryRecord)
                                        </span>
                                    </div>
                                }
                            </div>

                            <hr class="om-po-divider" />

                            <!-- CURRENT STATUS INFO -->
                            <div class="mb-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="om-po-grid-label" style="text-transform: uppercase; letter-spacing: 0.03em;">Current Status</span>
                                    <span class="om-po-pill-@(SelectedPurchaseOrder.Status?.ToLower() ?? "pending")">@SelectedPurchaseOrder.Status</span>
                                </div>
                            </div>

                            <!-- 4-STEP HORIZONTAL STATUS PROGRESSION STEPPER -->
                            <div class="om-po-stepper-container mb-4">
                                @{
                                    string s = SelectedPurchaseOrder.Status ?? "Pending";
                                    bool isPending = true;
                                    bool isAccepted = s == "Accepted" || s == "Dispatched" || s == "In Transit" || s == "Delivered" || s == "Completed";
                                    bool isDispatched = s == "Dispatched" || s == "In Transit" || s == "Delivered" || s == "Completed";
                                    bool isDelivered = s == "Delivered" || s == "Completed";
                                }

                                <div class="om-po-stepper">
                                    <!-- STEP 1: PENDING -->
                                    <div class="om-po-step @(isPending ? "completed" : "")">
                                        <div class="om-po-step-circle">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                        <span class="om-po-step-title">Pending</span>
                                        <span class="om-po-step-date">@SelectedPurchaseOrder.OrderDate.ToIst("dd MMM yyyy")</span>
                                        <span class="om-po-step-time">@SelectedPurchaseOrder.OrderDate.ToIst("hh:mm tt")</span>
                                    </div>

                                    <div class="om-po-step-line @(isAccepted ? "active" : "")"></div>

                                    <!-- STEP 2: ACCEPTED -->
                                    <div class="om-po-step @(isAccepted ? "completed" : "")">
                                        <div class="om-po-step-circle">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                        <span class="om-po-step-title">Accepted</span>
                                        <span class="om-po-step-date">@(isAccepted ? SelectedPurchaseOrder.OrderDate.ToIst("dd MMM yyyy") : "--")</span>
                                        <span class="om-po-step-time">@(isAccepted ? SelectedPurchaseOrder.OrderDate.ToIst("hh:mm tt") : "")</span>
                                    </div>

                                    <div class="om-po-step-line @(isDispatched ? "active" : "")"></div>

                                    <!-- STEP 3: DISPATCHED -->
                                    <div class="om-po-step @(isDispatched ? (isDelivered ? "completed" : "active-step") : "")">
                                        <div class="om-po-step-circle">
                                            @if (isDelivered)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="1" y="3" width="15" height="13"></rect>
                                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                                </svg>
                                            }
                                        </div>
                                        <span class="om-po-step-title">Dispatched</span>
                                        <span class="om-po-step-date">@(isDispatched ? (SelectedPurchaseOrder.DispatchDateTime.HasValue ? SelectedPurchaseOrder.DispatchDateTime.Value.ToIst("dd MMM yyyy") : "--") : "--")</span>
                                        <span class="om-po-step-time">@(isDispatched ? (SelectedPurchaseOrder.DispatchDateTime.HasValue ? SelectedPurchaseOrder.DispatchDateTime.Value.ToIst("hh:mm tt") : "") : "")</span>
                                    </div>

                                    <div class="om-po-step-line @(isDelivered ? "active" : "")"></div>

                                    <!-- STEP 4: DELIVERED -->
                                    <div class="om-po-step @(isDelivered ? "completed" : "")">
                                        <div class="om-po-step-circle">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                        <span class="om-po-step-title">Delivered</span>
                                        <span class="om-po-step-date">@(isDelivered ? (SelectedPurchaseOrder.ActualDeliveryDate ?? primaryDeliveryRecord?.DeliveryDate ?? SelectedPurchaseOrder.OrderDate).ToIst("dd MMM yyyy") : "--")</span>
                                        <span class="om-po-step-time">@(isDelivered ? (SelectedPurchaseOrder.ActualDeliveryDate ?? primaryDeliveryRecord?.DeliveryDate ?? SelectedPurchaseOrder.OrderDate).ToIst("hh:mm tt") : "")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- INFO CALLOUT -->
                            <div class="om-po-info-callout mb-4">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <span>
                                    @if (SelectedPurchaseOrder.Status == "Dispatched" || SelectedPurchaseOrder.Status == "In Transit")
                                    {
                                        <span>Your order has been dispatched by the vendor and is on the way to your outlet.</span>
                                    }
                                    else if (SelectedPurchaseOrder.Status == "Delivered" || SelectedPurchaseOrder.Status == "Completed")
                                    {
                                        <span>Your order has been successfully delivered and received at your outlet.</span>
                                    }
                                    else if (SelectedPurchaseOrder.Status == "Accepted")
                                    {
                                        <span>The vendor has accepted your order and is currently preparing it for dispatch.</span>
                                    }
                                    else
                                    {
                                        <span>Your order has been issued and is awaiting confirmation from the vendor.</span>
                                    }
                                </span>
                            </div>

                            @if (SelectedPurchaseOrder.Status == "Dispatched" || SelectedPurchaseOrder.Status == "In Transit")
                            {
                                <div class="om-record-delivery-box mb-4">
                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">Delivery in progress</h6>
                                    <p class="text-muted small mb-0" style="margin-top: 0.15rem;">The Purchase Manager records and confirms delivery. You can view status here.</p>
                                </div>
                            }
                            else if (SelectedPurchaseOrder.Status == "Delivered" || SelectedPurchaseOrder.Status == "Completed")
                            {
                                <!-- VERIFIED DELIVERY SUMMARY CARD -->
                                <div class="om-record-delivery-box bg-light border-success border-opacity-25 mb-4">
                                    <h6 class="fw-bold text-success mb-2 d-flex align-items-center gap-1">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span>Delivery Confirmed &amp; Logged</span>
                                    </h6>
                                    <div class="row g-2 small mt-1">
                                        <div class="col-sm-6">
                                            <span class="text-muted">Received Quantity:</span>
                                            <strong class="d-block text-dark">@((primaryDeliveryRecord?.ReceivedQuantity ?? orderedQty).ToString("0.##")) @prodUnit</strong>
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="text-muted">Spoiled / Damaged:</span>
                                            <strong class="d-block @(primaryDeliveryRecord?.SpoiledQuantity > 0 ? "text-danger" : "text-dark")">
                                                @((primaryDeliveryRecord?.SpoiledQuantity ?? 0).ToString("0.##")) @prodUnit
                                                @if ((primaryDeliveryRecord?.SpoiledQuantity ?? 0) > 0)
                                                {
                                                    <span class="badge bg-danger text-white ms-1" style="font-size: 0.7rem;">@((primaryDeliveryRecord?.SpoilagePercentage ?? 0).ToString("0.##"))% Spoilage</span>
                                                }
                                            </strong>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <!-- =======================================================
                             STEP 1: RECORD DELIVERY INPUT FORM
                             ======================================================= -->
                        @if (false && IsRecordingDelivery && !IsReviewingDelivery)
                        {
                            <div class="om-delivery-form-container">
                                <div class="om-delivery-form-header mb-3">
                                    <h5 class="fw-bold text-dark mb-1">Record Goods Delivery</h5>
                                    <p class="text-muted small mb-0">Verify quantities received for <strong>PO-@SelectedPurchaseOrder.PurchaseOrderID</strong> (@prodName).</p>
                                </div>

                                <div class="mb-3 p-3 bg-light rounded-3">
                                    <div class="row g-2 small">
                                        <div class="col-6">
                                            <span class="text-muted">Ordered Quantity:</span>
                                            <div class="fw-bold text-dark">@orderedQty.ToString("0.##") @prodUnit</div>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">Vendor:</span>
                                            <div class="fw-bold text-dark">@SelectedPurchaseOrder.VendorName</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">Received Quantity (@prodUnit) <span class="text-danger">*</span></label>
                                    <input type="number" step="0.01" min="0" class="form-control" @bind="DeliveryReceivedQuantity" placeholder="e.g. 10.00" />
                                    <span class="text-muted" style="font-size: 0.75rem;">Enter the actual acceptable quantity received in good condition.</span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">Spoiled / Damaged Quantity (@prodUnit)</label>
                                    <input type="number" step="0.01" min="0" class="form-control" @bind="DeliverySpoiledQuantity" placeholder="e.g. 0.00" />
                                    <span class="text-muted" style="font-size: 0.75rem;">Enter quantity rejected due to damage or spoilage, if any.</span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">Actual Delivery Date <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" @bind="DeliveryActualDate" />
                                </div>

                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-dark">Delivery Notes / Remarks (Optional)</label>
                                    <textarea class="form-control" rows="2" @bind="DeliveryNotes" placeholder="e.g. Goods received in good condition. Inspected by outlet manager."></textarea>
                                </div>

                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                    <button type="button" class="btn btn-outline-secondary px-3" @onclick="CancelRecordDelivery">
                                        Cancel
                                    </button>
                                    <button type="button" class="btn btn-success fw-bold px-4" @onclick="ProceedToReviewDelivery">
                                        <span>Review Delivery</span>
                                        <span class="ms-1">&rarr;</span>
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- =======================================================
                             STEP 2: REVIEW & CONFIRM DELIVERY
                             ======================================================= -->
                        @if (false && IsReviewingDelivery)
                        {
                            <div class="om-delivery-review-container">
                                <div class="om-delivery-form-header mb-3">
                                    <h5 class="fw-bold text-dark mb-1">Review &amp; Confirm Delivery</h5>
                                    <p class="text-muted small mb-0">Please verify the delivery summary before final submission.</p>
                                </div>

                                <div class="card border rounded-3 p-3 mb-4 shadow-sm bg-white">
                                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                        <span class="text-muted small">Purchase Order</span>
                                        <strong class="text-dark">PO-@SelectedPurchaseOrder.PurchaseOrderID</strong>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                        <span class="text-muted small">Product</span>
                                        <strong class="text-dark">@prodName</strong>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                        <span class="text-muted small">Ordered Quantity</span>
                                        <span class="text-dark">@orderedQty.ToString("0.##") @prodUnit</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                        <span class="text-muted small">Received Quantity</span>
                                        <strong class="text-success fs-6">@DeliveryReceivedQuantity.ToString("0.##") @prodUnit</strong>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                        <span class="text-muted small">Spoiled / Damaged</span>
                                        <strong class="@(DeliverySpoiledQuantity > 0 ? "text-danger" : "text-dark")">
                                            @DeliverySpoiledQuantity.ToString("0.##") @prodUnit
                                            @if (DeliverySpoiledQuantity > 0 && DeliveryReceivedQuantity > 0)
                                            {
                                                decimal revPct = Math.Round((DeliverySpoiledQuantity / DeliveryReceivedQuantity) * 100m, 2);
                                                <span class="badge bg-danger text-white ms-1" style="font-size: 0.7rem;">@revPct.ToString("0.##")% Spoilage</span>
                                            }
                                        </strong>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                        <span class="text-muted small">Actual Delivery Date</span>
                                        <span class="text-dark fw-semibold">@DeliveryActualDate.ToIst("dd MMM yyyy")</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-muted small">Delivery Performance</span>
                                        @{
                                            DateTime expDate = SelectedPurchaseOrder.ExpectedDeliveryDate ?? SelectedPurchaseOrder.OrderDate.AddDays(2);
                                            bool isOnTime = DeliveryActualDate.Date <= expDate.Date;
                                        }
                                        <span class="badge @(isOnTime ? "bg-success" : "bg-danger")">
                                            @(isOnTime ? "On Time" : $"Delayed by {(DeliveryActualDate.Date - expDate.Date).Days} days")
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                    <button type="button" class="btn btn-outline-secondary px-3" @onclick="BackToEditDelivery" disabled="@IsSubmittingDelivery">
                                        &larr; Edit Details
                                    </button>
                                    <button type="button" class="btn btn-success fw-bold px-4 d-flex align-items-center gap-2" @onclick="ConfirmDeliveryAsync" disabled="@IsSubmittingDelivery">
                                        @if (IsSubmittingDelivery)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                            <span>Confirming...</span>
                                        }
                                        else
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                            <span>Confirm Delivery</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }

                    </div>

                    <!-- FOOTER -->
                    @if (!IsRecordingDelivery && !IsReviewingDelivery)
                    {
                        <div class="om-po-drawer-footer">
                            <button type="button" class="btn btn-light px-4 fw-semibold" @onclick="ClosePoDetailsModal">
                                Close
                            </button>
                            <button type="button" class="btn btn-success px-4 fw-semibold" @onclick="ClosePoDetailsModal">
                                Done
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
}
