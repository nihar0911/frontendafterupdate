                                <div class="om-po-stat-icon-box bg-stat-yellow">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                </div>
                                <div class="om-po-stat-content">
                                    <div class="om-po-stat-num">@PendingOrdersCount</div>
                                    <div class="om-po-stat-label">Pending</div>
                                    <div class="om-po-stat-desc">Awaiting vendor confirmation</div>
                                </div>
                            </div>

                            <!-- 2. DISPATCHED / IN TRANSIT -->
                            <div class="om-po-stat-card">
                                <div class="om-po-stat-icon-box bg-stat-blue">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="1" y="3" width="15" height="13"></rect>
                                        <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                    </svg>
                                </div>
                                <div class="om-po-stat-content">
                                    <div class="om-po-stat-num">@DispatchedOrdersCount</div>
                                    <div class="om-po-stat-label">Dispatched / In Transit</div>
                                    <div class="om-po-stat-desc">On the way to your outlet</div>
                                </div>
                            </div>

                            <!-- 3. DELIVERED -->
                            <div class="om-po-stat-card">
                                <div class="om-po-stat-icon-box bg-stat-green">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                    </svg>
                                </div>
                                <div class="om-po-stat-content">
                                    <div class="om-po-stat-num">@DeliveredOrdersCount</div>
                                    <div class="om-po-stat-label">Delivered</div>
                                    <div class="om-po-stat-desc">Successfully received</div>
                                </div>
                            </div>
                        </div>

