                                            </p>
                                        </div>
                                    </div>
                                    
                                    <!-- SUBTLE WATERMARK EMBLEM (SHIELD + STORE) -->
                                    <div class="om-perm-watermark">
                                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.6">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                            <path d="m9 12 2 2 4-4"></path>
                                        </svg>
                                    </div>
                                </div>

                            </div>
                        }

                    </div>
                }

                <!-- ===============================================================
                     TAB: PURCHASE ORDERS & DELIVERIES (CLEAN REDESIGN)
                     =============================================================== -->
                else if (ActiveTab == "PurchaseOrders")
