                            <div class="d-flex align-items-center gap-3">
                                <div class="om-outlet-icon-circle">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#174F45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                        <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                                        <path d="M2 7h20"></path>
                                        <path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="om-outlet-main-title">Outlet Information</h2>
                                    <p class="om-outlet-main-subtitle">View details about your assigned outlet</p>
                                </div>
                            </div>

                            @if (!IsEditingOutlet)
                            {
                                <button type="button" class="om-btn-edit-outlet" @onclick="StartEditOutlet">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                                    </svg>
                                    <span>Edit Outlet Details</span>
                                </button>
                            }
                        </div>

                        <!-- ALERTS -->
                        @if (!string.IsNullOrEmpty(OutletMessage))
                        {
                            <div class="om-alert-success mb-3">
                                <span>@OutletMessage</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(OutletError))
                        {
                            <div class="om-alert-danger mb-3">
                                <span>@OutletError</span>
                            </div>
                        }

                        @if (IsEditingOutlet)
                        {
                            <!-- EDIT FORM -->
                            <div class="om-outlet-edit-form">
                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label class="om-block-label">OUTLET NAME</label>
                                        <input type="text" class="form-control om-edit-input" @bind="EditOutletName" placeholder="Enter outlet name" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="om-block-label">ORGANIZATION</label>
                                        <input type="text" class="form-control om-edit-input" value="@OrganizationNameDisplay" disabled readonly />
                                    </div>
                                    <div class="col-12">
                                        <label class="om-block-label">ADDRESS</label>
                                        <input type="text" class="form-control om-edit-input" @bind="EditOutletAddress" placeholder="Enter outlet address" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" @onclick="CancelEditOutlet" disabled="@IsSavingOutlet">
                                        Cancel
                                    </button>
                                    <button type="button" class="btn om-btn-primary px-4 fw-bold" @onclick="SaveOutletDetails" disabled="@IsSavingOutlet">
                                        @if (IsSavingOutlet)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            <span>Saving...</span>
                                        }
                                        else
                                        {
                                            <span>Save Details</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- DISPLAY INFORMATION BLOCKS -->
                            <div class="om-outlet-blocks-container">
                                
                                <!-- ROW 1: OUTLET NAME & ORGANIZATION -->
                                <div class="om-outlet-two-col">
                                    
                                    <!-- OUTLET NAME -->
                                    <div class="om-outlet-field-group">
                                        <span class="om-block-label">OUTLET NAME</span>
                                        <div class="om-info-large-box">
                                            <div class="om-info-box-icon">
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#174F45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                                                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                                    <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                                                    <path d="M2 7h20"></path>
                                                    <path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"></path>
                                                </svg>
                                            </div>
                                            <span class="om-info-box-text">@OutletNameDisplay</span>
                                        </div>
                                    </div>

                                    <!-- ORGANIZATION -->
                                    <div class="om-outlet-field-group">
                                        <span class="om-block-label">ORGANIZATION</span>
                                        <div class="om-info-large-box">
                                            <div class="om-info-box-icon">
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#174F45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                                    <path d="M9 22v-4h6v4"></path>
                                                    <path d="M8 6h.01"></path>
                                                    <path d="M16 6h.01"></path>
                                                    <path d="M8 10h.01"></path>
                                                    <path d="M16 10h.01"></path>
                                                    <path d="M8 14h.01"></path>
                                                    <path d="M16 14h.01"></path>
                                                </svg>
                                            </div>
                                            <span class="om-info-box-text">@OrganizationNameDisplay</span>
                                        </div>
                                    </div>

                                </div>

                                <!-- ROW 2: ADDRESS -->
                                <div class="om-outlet-field-group">
                                    <span class="om-block-label">ADDRESS</span>
                                    <div class="om-info-large-box om-info-full-width">
                                        <div class="om-info-box-icon">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#174F45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                                                <circle cx="12" cy="10" r="3"></circle>
                                            </svg>
                                        </div>
                                        <span class="om-info-box-text">@(string.IsNullOrWhiteSpace(AssignedOutletAddress) ? "Address Not Specified" : AssignedOutletAddress)</span>
                                    </div>
                                </div>

                                <!-- ROW 3: PERMISSIONS & OWNERSHIP PANEL -->
                                <div class="om-permissions-panel">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="om-perm-icon">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                            </svg>
                                        </div>
                                        <div>
                                            <h4 class="om-perm-title">Assigned outlet permissions and ownership</h4>
                                            <p class="om-perm-desc">
