@page "/outlet-manager"
@rendermode InteractiveServer 
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Outlet Manager Dashboard - Smart Vendor Management</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="om-auth-warning-wrap">
        <div class="om-auth-warning-card">
            <h4 class="fw-bold mb-2 text-dark">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as an Outlet Manager to access this dashboard.</p>
            <button class="btn om-btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsOutletManager && !Auth.IsAdmin)
{
    <div class="om-auth-warning-wrap">
        <div class="om-auth-warning-card">
            <h4 class="fw-bold mb-2 text-danger">Access Denied</h4>
            <p class="text-muted mb-3">You do not have privileges to access the Outlet Manager Dashboard.</p>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="om-layout">
        
        <!-- ===================================================================
             1. DARK GREEN SIDEBAR (#174F45)
             =================================================================== -->
        <aside class="om-sidebar">
            
            <div class="om-sidebar-top">
                <!-- SIDEBAR BRAND -->
                <div class="om-sidebar-brand">
                    <div class="om-brand-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                    </div>
                    <span class="om-brand-text">OUTLET WORKSPACE</span>
                </div>

                <!-- NAVIGATION ITEMS -->
                <nav class="om-nav-list">
                    <button type="button" 
                            class="om-nav-item @(ActiveTab == "Dashboard" ? "active" : "")"
                            @onclick='() => SetActiveTab("Dashboard")'>
                        <svg class="om-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Dashboard</span>
                    </button>

                    <button type="button" 
                            class="om-nav-item @(ActiveTab == "MyRequests" ? "active" : "")"
                            @onclick='() => SetActiveTab("MyRequests")'>
                        <svg class="om-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <line x1="10" y1="9" x2="8" y2="9"></line>
                        </svg>
                        <span>My Purchase Requests</span>
                    </button>

                    <button type="button" 
                            class="om-nav-item @(ActiveTab == "PurchaseOrders" ? "active" : "")"
                            @onclick='() => SetActiveTab("PurchaseOrders")'>
                        <svg class="om-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                        <span>Purchase Orders</span>
                        @if (ActiveOrdersCount > 0)
                        {
                            <span class="badge bg-danger ms-auto om-nav-badge">@ActiveOrdersCount</span>
                        }
                    </button>

                    <button type="button" 
                            class="om-nav-item @(ActiveTab == "MyOutlet" ? "active" : "")"
                            @onclick='() => SetActiveTab("MyOutlet")'>
                        <svg class="om-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                            <path d="M2 7h20"></path>
                            <path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"></path>
                        </svg>
                        <span>My Outlet</span>
                    </button>

                    <button type="button" 
                            class="om-nav-item @(ActiveTab == "MyProfile" ? "active" : "")"
                            @onclick='() => SetActiveTab("MyProfile")'>
                        <svg class="om-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>My Profile</span>
                    </button>
                </nav>
            </div>

            <!-- SIDEBAR FOOTER (USER & LOGOUT) -->
            <div class="om-sidebar-bottom">
                <div class="om-user-profile-row">
                    <div class="om-avatar-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div class="om-user-info-text">
                        <div class="om-user-name">@OutletManagerName</div>
                        <div class="om-user-role">Outlet Manager</div>
                    </div>
                </div>

                <button type="button" class="om-logout-btn" @onclick="HandleLogout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </div>

        </aside>

        <!-- ===================================================================
             2. MAIN CONTENT AREA
             =================================================================== -->
        <main class="om-main-canvas">
            
            <!-- TOP HEADER -->
            <header class="om-top-header">
                <div class="om-header-left">
                    <h1 class="om-welcome-title">@GetGreeting(), @OutletManagerName</h1>
                    <p class="om-welcome-subtitle">
                        Outlet: <span class="om-accent-text">@OutletNameDisplay</span> &bull; Organization: @OrganizationNameDisplay
                    </p>
                </div>

                <div class="om-header-right">
                    
                    <!-- NOTIFICATIONS POPUP -->
                    <div class="om-notif-container">
                        <button type="button" class="om-header-pill om-notif-pill" @onclick="ToggleNotifications">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                            </svg>
                            <span>Notifications</span>
                            @if (UnreadNotificationCount > 0)
                            {
                                <span class="om-notif-badge">@UnreadNotificationCount</span>
                            }
                            else if (Notifications.Count > 0)
                            {
                                <span class="om-notif-badge">@Notifications.Count</span>
                            }
                        </button>

                        @if (ShowNotificationDropdown)
                        {
                            <div class="om-notif-dropdown">
                                <div class="om-notif-dropdown-head">
                                    <h6 class="mb-0 fw-bold">Outlet Notifications</h6>
                                    @if (UnreadNotificationCount > 0)
                                    {
                                        <span class="badge bg-success">@UnreadNotificationCount new</span>
                                    }
                                </div>
                                @if (Notifications == null || Notifications.Count == 0)
                                {
                                    <div class="p-3 text-center text-muted small">No notifications found.</div>
                                }
                                else
                                {
                                    <div class="om-notif-dropdown-body">
                                        @foreach (var notif in Notifications.Take(8))
                                        {
                                            bool isClickable = IsClickableNotification(notif);
                                            <div class="om-notif-item @(notif.IsRead ? "read" : "unread") @(isClickable ? "clickable" : "")"
                                                 @onclick="() => HandleNotificationClick(notif)">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="om-notif-title @(notif.NotificationType == "OpportunityRejected" || notif.NotificationType == "PurchaseOrderRejected" ? "text-danger" : "text-dark")">
                                                        @(notif.NotificationType == "OpportunityRejected" ? "Opportunity Declined" : notif.Title)
                                                    </span>
                                                    <span class="om-notif-time">@notif.CreatedDate.ToIst("dd MMM, hh:mm tt")</span>
                                                </div>
                                                <p class="om-notif-msg mb-1">@notif.Message</p>
                                                <div class="d-flex justify-content-between align-items-center mt-1">
                                                    @if (!notif.IsRead)
                                                    {
                                                        <button type="button" class="om-notif-mark" @onclick='() => MarkAsRead(notif.NotificationID)' @onclick:stopPropagation="true">
                                                            Mark as read
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span></span>
                                                    }

                                                    @if (isClickable)
                                                    {
                                                        <span class="om-notif-view-link">
                                                            <span>View Details</span>
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <polyline points="9 18 15 12 9 6"></polyline>
                                                            </svg>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- OUTLET CONTEXT PILL -->
                    <div class="om-header-pill om-outlet-pill">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#174F45" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span class="om-outlet-pill-text">@OutletNameDisplay</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>

                    <!-- TOP HEADER LOGOUT BUTTON -->
                    <button type="button" class="om-header-pill om-logout-header-pill" @onclick="HandleLogout" title="Logout">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Logout</span>
                    </button>

                </div>
            </header>

            @if (IsLoading)
            {
                <div class="om-loading-state">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted fw-semibold">Loading outlet dashboard...</p>
                </div>
            }
            else
            {
                <!-- ===============================================================
                     TAB 1: MAIN DASHBOARD VIEW
                     =============================================================== -->
                @if (ActiveTab == "Dashboard")
                {
                    <div class="om-dashboard-body">
                        
                        <!-- 5 SUMMARY METRIC CARDS -->
                        <div class="om-metric-grid">
                            
                            <!-- 1. TOTAL PURCHASE REQUESTS -->
                            <div class="om-metric-card">
                                <div class="om-metric-header">
                                    <span class="om-metric-label">Total Purchase Requests</span>
                                    <div class="om-metric-icon-box bg-soft-green">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#174F45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                        </svg>
                                    </div>
                                </div>
                                <div class="om-metric-value text-dark">@PurchaseRequestsCount</div>
                                <div class="om-metric-desc">All requests for this outlet</div>
                            </div>

                            <!-- 2. PENDING REQUESTS -->
                            <div class="om-metric-card">
                                <div class="om-metric-header">
                                    <span class="om-metric-label">Pending Requests</span>
                                    <div class="om-metric-icon-box bg-soft-amber">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                    </div>
                                </div>
                                <div class="om-metric-value text-amber">@PendingQuotationsCount</div>
                                <div class="om-metric-desc">Awaiting approval</div>
                            </div>

                            <!-- 3. APPROVED REQUESTS -->
                            <div class="om-metric-card">
                                <div class="om-metric-header">
                                    <span class="om-metric-label">Approved Requests</span>
                                    <div class="om-metric-icon-box bg-soft-green-check">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </div>
                                </div>
                                <div class="om-metric-value text-green">@ApprovedRequestsCount</div>
                                <div class="om-metric-desc">Approved / completed</div>
                            </div>

                            <!-- 4. REJECTED REQUESTS -->
                            <div class="om-metric-card">
                                <div class="om-metric-header">
                                    <span class="om-metric-label">Rejected Requests</span>
                                    <div class="om-metric-icon-box bg-soft-red">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                                            <line x1="9" y1="9" x2="15" y2="15"></line>
                                            <line x1="15" y1="9" x2="9" y2="15"></line>
                                        </svg>
                                    </div>
                                </div>
                                <div class="om-metric-value text-red">@RejectedRequestsCount</div>
                                <div class="om-metric-desc">Returned / not approved</div>
                            </div>

                            <!-- 5. ACTIVE CONTRACTS -->
                            <div class="om-metric-card">
                                <div class="om-metric-header">
                                    <span class="om-metric-label">Active Contracts</span>
                                    <div class="om-metric-icon-box bg-soft-blue">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                                        </svg>
                                    </div>
                                </div>
                                <div class="om-metric-value text-blue">@ActiveContractsCount</div>
                                <div class="om-metric-desc">Active agreements</div>
                            </div>

                        </div>

                        <!-- MIDDLE SECTION: RECENT ACTIVITY + REQUEST STATUS OVERVIEW -->
                        <div class="om-mid-grid">
                            
                            <!-- LEFT: RECENT ACTIVITY -->
                            <div class="om-card om-activity-card">
                                <div class="om-card-header">
                                    <h3 class="om-card-title">Recent Activity</h3>
                                </div>
                                <div class="om-card-body p-0">
                                    @if (RecentActivities == null || RecentActivities.Count == 0)
                                    {
                                        <div class="p-4 text-center text-muted small">
                                            No recent activity records available for this outlet.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="om-activity-list">
                                            @foreach (var act in RecentActivities)
                                            {
                                                <div class="om-activity-row">
                                                    <div class="om-activity-icon @act.Type">
                                                        @if (act.Type == "approved")
                                                        {
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                                <polyline points="20 6 9 17 4 12"></polyline>
                                                            </svg>
                                                        }
                                                        else if (act.Type == "pending")
                                                        {
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <circle cx="12" cy="12" r="10"></circle>
                                                                <polyline points="12 6 12 12 16 14"></polyline>
                                                            </svg>
                                                        }
                                                        else if (act.Type == "contract")
                                                        {
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                                <polyline points="14 2 14 8 20 8"></polyline>
                                                            </svg>
                                                        }
                                                        else
                                                        {
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                                            </svg>
                                                        }
                                                    </div>

                                                    <div class="om-activity-content">
                                                        <div class="om-activity-title">
                                                            @if (!string.IsNullOrEmpty(act.HighlightRef))
                                                            {
                                                                <span>@act.Prefix</span>
                                                                <span class="om-ref-highlight">@act.HighlightRef</span>
                                                                <span>@act.Suffix</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@act.Text</span>
                                                            }
                                                        </div>
                                                        <div class="om-activity-time">@act.TimeAgo</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- RIGHT: REQUEST STATUS OVERVIEW -->
                            <div class="om-card om-overview-card">
                                <div class="om-card-header">
                                    <h3 class="om-card-title">Request Status Overview</h3>
                                    <button type="button" class="om-link-btn" @onclick='() => SetActiveTab("MyRequests")'>
                                        View All &rarr;
                                    </button>
                                </div>
                                <div class="om-card-body d-flex align-items-center justify-content-between p-4">
                                    
                                    <!-- DONUT CHART (SVG) -->
                                    <div class="om-donut-wrap">
                                        <svg width="140" height="140" viewBox="0 0 140 140" class="om-donut-svg">
                                            <!-- Base track -->
                                            <circle cx="70" cy="70" r="50" fill="transparent" stroke="#E5E7EB" stroke-width="18"></circle>

                                            @{
                                                // Circumference of radius 50 = 2 * PI * 50 = 314.159
                                                double circumference = 314.159;
                                                double approvedDash = (ApprovedPercentage / 100.0) * circumference;
                                                double pendingDash = (PendingPercentage / 100.0) * circumference;
                                                double rejectedDash = (RejectedPercentage / 100.0) * circumference;

                                                double pendingOffset = -approvedDash;
                                                double rejectedOffset = -(approvedDash + pendingDash);
                                            }

                                            @if (TotalRequests > 0)
                                            {
                                                <!-- Approved segment (Green) -->
                                                <circle cx="70" cy="70" r="50" fill="transparent"
                                                        stroke="#2E7D61" stroke-width="18"
                                                        stroke-dasharray="@approvedDash.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) @circumference"
                                                        stroke-dashoffset="0"
                                                        transform="rotate(-90 70 70)">
                                                </circle>

                                                <!-- Pending segment (Amber) -->
                                                <circle cx="70" cy="70" r="50" fill="transparent"
                                                        stroke="#F59E0B" stroke-width="18"
                                                        stroke-dasharray="@pendingDash.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) @circumference"
                                                        stroke-dashoffset="@pendingOffset.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                        transform="rotate(-90 70 70)">
                                                </circle>

                                                <!-- Rejected segment (Red) -->
                                                <circle cx="70" cy="70" r="50" fill="transparent"
                                                        stroke="#EF4444" stroke-width="18"
                                                        stroke-dasharray="@rejectedDash.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) @circumference"
                                                        stroke-dashoffset="@rejectedOffset.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                        transform="rotate(-90 70 70)">
                                                </circle>
                                            }
                                        </svg>

                                        <!-- Centered Text -->
                                        <div class="om-donut-center">
                                            <div class="om-donut-num">@TotalRequests</div>
                                            <div class="om-donut-label">Total</div>
                                        </div>
                                    </div>

                                    <!-- LEGEND -->
                                    <div class="om-donut-legend">
                                        <div class="om-legend-row">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="om-legend-dot dot-approved"></span>
                                                <span class="om-legend-name">Approved</span>
                                            </div>
                                            <span class="om-legend-val">@ApprovedRequestsCount (@ApprovedPercentage%)</span>
                                        </div>

                                        <div class="om-legend-row">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="om-legend-dot dot-pending"></span>
                                                <span class="om-legend-name">Pending</span>
                                            </div>
                                            <span class="om-legend-val">@PendingQuotationsCount (@PendingPercentage%)</span>
                                        </div>

                                        <div class="om-legend-row">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="om-legend-dot dot-rejected"></span>
                                                <span class="om-legend-name">Rejected</span>
                                            </div>
                                            <span class="om-legend-val">@RejectedRequestsCount (@RejectedPercentage%)</span>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>

                        <!-- FULL-WIDTH SECTION: MY PURCHASE REQUESTS -->
                        <div class="om-card om-table-card">
                            <div class="om-card-header">
                                <h3 class="om-card-title">My Purchase Requests</h3>
                                <button type="button" class="om-link-btn" @onclick='() => SetActiveTab("MyRequests")'>
                                    View All Requests &rarr;
                                </button>
                            </div>
                            <div class="om-card-body p-0">
                                @if (PRsForMyOutlet == null || PRsForMyOutlet.Count == 0)
                                {
                                    <div class="p-5 text-center text-muted">
                                        <h6 class="fw-bold mb-1">No Purchase Requests Registered</h6>
                                        <p class="mb-0 small">There are no purchase requests for your outlet currently.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="om-table">
                                            <thead>
                                                <tr>
                                                    <th>REQUEST REF</th>
                                                    <th>PRODUCT</th>
                                                    <th>QUANTITY</th>
                                                    <th>STATUS</th>
                                                    <th>REQUEST DATE</th>
                                                    <th class="text-end">ACTION</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var pr in PRsForMyOutlet.Take(6))
                                                {
                                                    var firstItem = pr.Items?.FirstOrDefault();
                                                    string productName = firstItem?.ProductName ?? "N/A";
                                                    string qtyStr = firstItem != null ? $"{firstItem.Quantity:0.##} {firstItem.Unit}" : "N/A";
                                                    string badgeClass = pr.Status switch
                                                    {
                                                        "Approved" or "Accepted" or "Completed" => "status-approved",
                                                        "Pending" or "Submitted" => "status-pending",
                                                        "Rejected" or "Declined" => "status-rejected",
                                                        _ => "status-neutral"
                                                    };

                                                    <tr class="om-table-row" @onclick='() => NavigateToRequest(pr.RequestID)'>
                                                        <td class="om-col-ref">PR-@pr.RequestID</td>
                                                        <td class="om-col-product">@productName</td>
                                                        <td class="om-col-qty">@qtyStr</td>
                                                        <td class="om-col-status">
                                                            <span class="om-status-badge @badgeClass">@pr.Status</span>
                                                        </td>
                                                        <td class="om-col-date">@pr.RequestDate.ToIst("dd MMM yyyy")</td>
                                                        <td class="om-col-action text-end">
                                                            <button type="button" class="om-arrow-btn" @onclick='() => NavigateToRequest(pr.RequestID)' @onclick:stopPropagation="true">
                                                                &rarr;
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                }

                <!-- ===============================================================
                     TAB 2: MY PURCHASE REQUESTS VIEW (EXACT MATCH TO REFERENCE)
                     =============================================================== -->
                else if (ActiveTab == "MyRequests")
                {
                    <div class="om-prs-page-container">
                        
                        <!-- PAGE HEADER WITH DECORATIVE CLIPBOARD ICON -->
                        <div class="om-prs-header-card">
                            <div class="om-prs-header-text">
                                <h2 class="om-prs-title">My Purchase Requests</h2>
                                <p class="om-prs-subtitle">View and track all purchase requests created for your outlet by the Organization Manager.</p>
                            </div>
                            <div class="om-prs-header-icon">
                                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#2E7D61" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                                    <line x1="9" y1="12" x2="15" y2="12"></line>
                                    <line x1="9" y1="16" x2="15" y2="16"></line>
                                </svg>
                            </div>
                        </div>

                        <!-- SEARCH & FILTER TOOLBAR -->
                        <div class="om-prs-toolbar-card">
                            
                            <!-- Search Bar -->
                            <div class="om-prs-search-box">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                <input type="text" 
                                       class="om-prs-search-input" 
                                       placeholder="Search by request ref or product..." 
                                       @bind="SearchQuery" 
                                       @bind:event="oninput" />
                            </div>

                            <!-- Status Dropdown -->
                            <div class="om-prs-filter-group">
                                <span class="om-prs-filter-label">Status</span>
                                <select class="om-prs-filter-select" @bind="StatusFilter">
                                    <option value="All">All Statuses</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                            </div>

                            <!-- From Date -->
                            <div class="om-prs-date-group">
                                <input type="date" class="om-prs-date-input" @bind="FromDateFilter" placeholder="From Date" />
                            </div>

                            <!-- To Date -->
                            <div class="om-prs-date-group">
                                <input type="date" class="om-prs-date-input" @bind="ToDateFilter" placeholder="To Date" />
                            </div>

                            <!-- Clear Filters -->
                            <button type="button" class="om-prs-clear-btn" @onclick="ClearFilters">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                                    <path d="M3 3v5h5"></path>
                                </svg>
                                <span>Clear Filters</span>
                            </button>

                        </div>

                        <!-- PURCHASE REQUESTS TABLE CARD -->
                        <div class="om-card om-table-card">
                            <div class="om-card-body p-0">
                                @if (FilteredPRs == null || FilteredPRs.Count == 0)
                                {
                                    <div class="p-5 text-center text-muted">
                                        <div class="mb-3">
                                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                            </svg>
                                        </div>
                                        <h6 class="fw-bold mb-1 text-dark">No Purchase Requests</h6>
                                        <p class="mb-0 small">There are currently no purchase requests matching your filter criteria for this outlet.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="om-table">
                                            <thead>
                                                <tr>
                                                    <th>REQUEST REF</th>
                                                    <th>PRODUCT</th>
                                                    <th>QUANTITY</th>
                                                    <th>STATUS</th>
                                                    <th>REQUEST DATE</th>
                                                    <th class="text-end">ACTION</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var pr in FilteredPRs)
                                                {
                                                    var firstItem = pr.Items?.FirstOrDefault();
                                                    string productName = firstItem?.ProductName ?? "N/A";
                                                    string qtyStr = firstItem != null ? $"{firstItem.Quantity:0.##} {firstItem.Unit}" : "N/A";
                                                    string badgeClass = pr.Status switch
                                                    {
                                                        "Approved" or "Accepted" or "Completed" => "status-approved",
                                                        "Pending" or "Submitted" => "status-pending",
                                                        "Rejected" or "Declined" => "status-rejected",
                                                        _ => "status-neutral"
                                                    };

                                                    <tr class="om-table-row" @onclick='() => NavigateToRequest(pr.RequestID)'>
                                                        <td class="om-col-ref">PR-@pr.RequestID</td>
                                                        <td class="om-col-product">@productName</td>
                                                        <td class="om-col-qty">@qtyStr</td>
                                                        <td class="om-col-status">
                                                            <span class="om-status-badge @badgeClass">@pr.Status</span>
                                                        </td>
                                                        <td class="om-col-date">@pr.RequestDate.ToIst("dd MMM yyyy")</td>
                                                        <td class="om-col-action text-end">
                                                            <button type="button" class="om-btn-view-details" @onclick='() => NavigateToRequest(pr.RequestID)' @onclick:stopPropagation="true">
                                                                <span>View Details</span>
                                                                <span>&rarr;</span>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                }

                <!-- ===============================================================
                     TAB 3: MY OUTLET VIEW (EXACT MATCH TO REFERENCE DESIGN)
                     =============================================================== -->
                else if (ActiveTab == "MyOutlet")
                {
