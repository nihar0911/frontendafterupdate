                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    <span class="small fw-semibold">@PoErrorMessage</span>
                                </div>
                                <button type="button" class="btn-close btn-close-sm" @onclick="() => PoErrorMessage = string.Empty"></button>
                            </div>
                        }

