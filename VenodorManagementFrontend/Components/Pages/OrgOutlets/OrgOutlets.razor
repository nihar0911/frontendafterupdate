@page "/org/outlets"
@page "/organization/outlets"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Organization Outlets - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="container py-5">
        <div class="alert alert-warning text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as an Organization Manager to view this page.</p>
            <button class="btn btn-primary fw-bold px-4" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsOrgManager && !Auth.IsAdmin)
{
    <div class="container py-5">
        <div class="alert alert-danger text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-3">You do not have Organization Manager privileges to view this page.</p>
            <button class="btn btn-outline-secondary fw-bold px-4" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="org-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">

        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION
             ======================================================================= -->
        <aside class="org-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                    <div class="brand-emblem">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">Smart Vendor</span>
                        <span class="brand-sub">Management</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link active" @onclick='() => Nav.NavigateTo("/organization/outlets")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <path d="M9 22V12h6v10"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Outlets</span>
                        </button>
                    </li>

                    @if (Auth.IsPurchaseManager || Auth.IsAdmin)
                    {
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>
                    }

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Quotations</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/contracts")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Contracts</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/invoices")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Invoices</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/organization/payments")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                    <line x1="1" y1="10" x2="23" y2="10"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Payments</span>
                        </button>
                    </li>
                </ul>

                <ul class="nav-list">
                    <li class="sidebar-divider"></li>
                    <li class="nav-item">
                        <button class="nav-link" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">My Profile</span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" @onclick="HandleLogout">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Logout</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- =======================================================================
             MAIN BODY WRAPPER
             ======================================================================= -->
        <div class="org-main-wrapper">

            <!-- TOP HEADER (No notification bell) -->
            <header class="org-top-header">
                <button class="menu-toggle-btn" @onclick="ToggleSidebar" title="Toggle Menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <div class="header-right">
                    <div class="profile-capsule-wrapper">
                        <div class="profile-capsule" @onclick="ToggleProfileDropdown">
                            <div class="profile-avatar">@GetUserInitial()</div>
                            <div class="profile-meta">
                                <span class="profile-name">@(string.IsNullOrWhiteSpace(Auth.UserName) ? "Organization Manager" : Auth.UserName)</span>
                                <span class="profile-role">Organization Manager</span>
                            </div>
                            <svg class="dropdown-arrow @(IsProfileDropdownOpen ? "open" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>

                    <button class="header-logout-btn" @onclick="HandleLogout" title="Sign out">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Logout</span>
                    </button>
                </div>
            </header>

            <!-- MAIN CONTENT CANVAS -->
            <main class="org-main-content">
                <div class="content-container">

                    <!-- TOP ACTION ROW (Back Button & Org Manager Badge) -->
                    <div class="top-action-row">
                        <button type="button" class="btn-back-link" @onclick='() => Nav.NavigateTo("/org-dashboard")'>
                            Back to Dashboard
                        </button>
                        <span class="org-manager-badge">
                            Org Manager: @(string.IsNullOrWhiteSpace(Auth.UserName) ? (Auth.CurrentUser?.Name ?? "Organization Manager") : Auth.UserName)
                        </span>
                    </div>

                    <!-- PAGE TITLE SECTION -->
                    <div class="page-title-section">
                        <h1 class="page-heading">Organization Outlets</h1>
                        <p class="page-subheading">Registered branches and facilities for @(string.IsNullOrWhiteSpace(OrganizationName) ? "your organization" : OrganizationName)</p>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-success mb-3" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading outlets...</span>
                            </div>
                            <h5 class="text-muted fw-bold">Loading organization outlets...</h5>
                        </div>
                    }
                    else if (HasError)
                    {
                        <div class="alert alert-danger p-4 text-center my-4 shadow-sm rounded-3">
                            <h5 class="fw-bold text-danger mb-2">Unable to load outlets.</h5>
                            <p class="text-muted small mb-3">An error occurred while connecting to the server. Please try again.</p>
                            <button class="btn btn-danger fw-bold px-4" @onclick="LoadData">Try Again</button>
                        </div>
                    }
                    else
                    {
                        <!-- SEARCH / FILTER TOOLBAR -->
                        <div class="toolbar-card">
                            <div class="search-input-wrapper">
                                <svg class="search-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                <input type="text" 
                                       class="search-input" 
                                       placeholder="Search by outlet name, address, or location..." 
                                       @bind="SearchQuery" 
                                       @bind:event="oninput" />
                            </div>

                            <div class="toolbar-right">
                                <select class="status-select" @bind="SelectedStatusFilter">
                                    <option value="All">All Status</option>
                                    <option value="Active">Active</option>
                                </select>
                                <span class="badge-total-outlets">
                                    Total Outlets: @FilteredOutlets.Count()
                                </span>
                            </div>
                        </div>

                        <!-- OUTLET CARDS RESPONSIVE GRID -->
                        @if (!FilteredOutlets.Any())
                        {
                            <div class="empty-results-card">
                                <h5 class="fw-bold mb-1 text-dark">No Outlets Found</h5>
                                <p class="text-muted mb-0">No registered outlets match your search criteria.</p>
                            </div>
                        }
                        else
                        {
                            <div class="outlet-grid">
                                @foreach (var o in FilteredOutlets)
                                {
                                    int prCount = GetPrCount(o.OutletID);
                                    int activeContracts = GetActiveContractCount(o.OutletID);

                                    <div class="outlet-card">
                                        <div>
                                            <!-- Top Icon & Status Badge -->
                                            <div class="outlet-card-top">
                                                <div class="outlet-icon-box">
                                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                        <path d="M9 22V12h6v10"></path>
                                                    </svg>
                                                </div>
                                                <span class="status-badge-pill">Active</span>
                                            </div>

                                            <!-- Outlet Info -->
                                            <div class="outlet-card-body">
                                                <h3 class="card-outlet-name">@o.OutletName</h3>
                                                
                                                <div class="card-outlet-location">
                                                    <svg class="loc-pin-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                        <circle cx="12" cy="10" r="3"></circle>
                                                    </svg>
                                                    <span>@(string.IsNullOrWhiteSpace(o.Address) ? "No address specified" : o.Address)</span>
                                                </div>
                                                <div class="card-outlet-location mt-1">
                                                    <span>PO approval: @(string.Equals(o.PurchaseOrderApproverRole, "Outlet Manager", StringComparison.OrdinalIgnoreCase) ? "Outlet Manager" : "Organization Manager")</span>
                                                </div>

                                                @if (o.Latitude.HasValue && o.Longitude.HasValue)
                                                {
                                                    <div class="card-outlet-coords">
                                                        <svg class="coords-globe-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="12" cy="12" r="10"></circle>
                                                            <line x1="2" y1="12" x2="22" y2="12"></line>
                                                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                                        </svg>
                                                        <span>Coordinates: @o.Latitude.Value.ToString("F4"), @o.Longitude.Value.ToString("F4")</span>
                                                    </div>
                                                }

                                                <!-- Two-column Summary Block -->
                                                <div class="outlet-metrics-block">
                                                    <div class="metric-column">
                                                        <span class="metric-col-label">PR Requests</span>
                                                        <span class="metric-col-val">@prCount</span>
                                                    </div>
                                                    <div class="metric-divider"></div>
                                                    <div class="metric-column">
                                                        <span class="metric-col-label">Active Contracts</span>
                                                        <span class="metric-col-val">@activeContracts</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Full-width View Details Action -->
                                        <button type="button" class="btn-card-details" @onclick="() => ViewOutletDetails(o)">
                                            <span>View Details</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }

                </div>
            </main>

        </div>

    </div>

    <!-- OUTLET DETAILS MODAL -->
    @if (SelectedOutlet != null)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-card-header">
                    <h5 class="modal-title">Outlet Details &mdash; @SelectedOutlet.OutletName</h5>
                    <button type="button" class="modal-close-btn" @onclick="CloseModal" title="Close">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="modal-card-body">
                    @if (!string.IsNullOrWhiteSpace(ActionMessage))
                    {
                        <div class="alert alert-success py-2 small mb-3">@ActionMessage</div>
                    }
                    <!-- Row 1: Outlet Name & Organization -->
                    <div class="modal-grid-2">
                        <div class="modal-info-box">
                            <div class="modal-info-icon-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <path d="M9 22V12h6v10"></path>
                                </svg>
                            </div>
                            <div class="modal-info-content">
                                <span class="modal-info-label">Outlet Name</span>
                                <span class="modal-info-val">@SelectedOutlet.OutletName</span>
                            </div>
                        </div>

                        <div class="modal-info-box">
                            <div class="modal-info-icon-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                    <path d="M9 22v-4h6v4"></path>
                                    <line x1="8" y1="6" x2="8.01" y2="6"></line>
                                    <line x1="16" y1="6" x2="16.01" y2="6"></line>
                                    <line x1="8" y1="10" x2="8.01" y2="10"></line>
                                    <line x1="16" y1="10" x2="16.01" y2="10"></line>
                                </svg>
                            </div>
                            <div class="modal-info-content">
                                <span class="modal-info-label">Organization</span>
                                <span class="modal-info-val">@OrganizationName</span>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Physical Address -->
                    <div class="modal-info-box">
                        <div class="modal-info-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <div class="modal-info-content">
                            <span class="modal-info-label">Physical Address</span>
                            <span class="modal-info-val">@(string.IsNullOrWhiteSpace(SelectedOutlet.Address) ? "No address specified" : SelectedOutlet.Address)</span>
                        </div>
                    </div>

                    <div class="modal-info-box">
                        <div class="modal-info-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <div class="modal-info-content">
                            <span class="modal-info-label">Purchase order approval</span>
                            @if (Auth.IsOrgManager)
                            {
                                <select class="form-select form-select-sm mt-1" value="@SelectedOutlet.PurchaseOrderApproverRole" @onchange="HandleApproverRoleChanged">
                                    <option value="Organization Manager">Organization Manager</option>
                                    <option value="Outlet Manager">Outlet Manager</option>
                                </select>
                            }
                            else
                            {
                                <span class="modal-info-val">@(string.Equals(SelectedOutlet.PurchaseOrderApproverRole, "Outlet Manager", StringComparison.OrdinalIgnoreCase) ? "Outlet Manager" : "Organization Manager")</span>
                            }
                        </div>
                    </div>

                    <!-- Row 3: Coordinates & Active Contracts -->
                    <div class="modal-grid-2">
                        <div class="modal-info-box">
                            <div class="modal-info-icon-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="2" y1="12" x2="22" y2="12"></line>
                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                </svg>
                            </div>
                            <div class="modal-info-content">
                                <span class="modal-info-label">Coordinates (Latitude / Longitude)</span>
                                <span class="modal-info-val">
                                    @(SelectedOutlet.Latitude.HasValue && SelectedOutlet.Longitude.HasValue 
                                        ? $"{SelectedOutlet.Latitude.Value:F4}, {SelectedOutlet.Longitude.Value:F4}" 
                                        : "Not mapped")
                                </span>
                            </div>
                        </div>

                        <div class="modal-info-box">
                            <div class="modal-info-icon-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            </div>
                            <div class="modal-info-content">
                                <span class="modal-info-label">Active Contracts</span>
                                <span class="modal-info-val">@GetActiveContractCount(SelectedOutlet.OutletID) Contracts</span>
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: Purchase Requests -->
                    <div class="modal-info-box">
                        <div class="modal-info-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                            </svg>
                        </div>
                        <div class="modal-info-content">
                            <span class="modal-info-label">Purchase Requests</span>
                            <span class="modal-info-val">@GetPrCount(SelectedOutlet.OutletID) Requests</span>
                        </div>
                    </div>
                </div>

                <div class="modal-card-footer">
                    <button type="button" class="btn-modal-cancel" @onclick="CloseModal">Close</button>
                    @if (Auth.IsPurchaseManager || Auth.IsAdmin)
                    {
                        <button type="button" class="btn-modal-primary" @onclick='() => { CloseModal(); Nav.NavigateTo("/procurement"); }'>
                            Create Purchase Request
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}

