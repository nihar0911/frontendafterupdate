@page "/vendor/spoilage-advice-settings"
@page "/spoilage-advice-settings"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Spoilage Advice Settings - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="vd-auth-warning-wrap">
        <div class="vd-auth-warning-card">
            <h4 class="fw-bold mb-2 text-dark">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as a Vendor Manager to view this portal.</p>
            <button class="btn vd-btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsVendorManager && !Auth.IsAdmin)
{
    <div class="vd-auth-warning-wrap">
        <div class="vd-auth-warning-card">
            <h4 class="fw-bold mb-2 text-danger">Access Denied</h4>
            <p class="text-muted mb-3">You do not have Vendor Manager privileges to access this portal.</p>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="vd-layout">

        <!-- ===================================================================
             1. FIXED FULL-HEIGHT DARK GREEN SIDEBAR (#174F45)
             =================================================================== -->
        <aside class="vd-sidebar">
            <div class="vd-sidebar-top">
                <!-- SIDEBAR BRAND -->
                <div class="vd-sidebar-brand" @onclick='() => Nav.NavigateTo("/vendor-dashboard")' style="cursor: pointer;">
                    <div class="vd-brand-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                    </div>
                    <span class="vd-brand-text">VENDOR WORKSPACE</span>
                </div>

                <!-- NAVIGATION ITEMS -->
                <nav class="vd-nav-list">
                    <button type="button" 
                            class="vd-nav-item"
                            @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Dashboard</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item"
                            @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>My Quotations</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item"
                            @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            <line x1="12" y1="11" x2="12" y2="17"></line>
                            <line x1="9" y1="14" x2="15" y2="14"></line>
                        </svg>
                        <span>My Contracts</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item"
                            @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                        <span>Purchase Orders</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item"
                            @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>Invoices</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item"
                            @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>Performance &amp; Reviews</span>
                    </button>

                    <button type="button" 
                            class="vd-nav-item"
                            @onclick='() => Nav.NavigateTo("/vendor-dashboard")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>My Profile</span>
                    </button>

                    <div style="height: 1px; background: rgba(255, 255, 255, 0.12); margin: 0.5rem 0.7rem;"></div>
                    <div style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(255, 255, 255, 0.45); padding: 0.25rem 0.7rem;">Configuration</div>

                    <button type="button" 
                            class="vd-nav-item active"
                            @onclick='() => Nav.NavigateTo("/vendor/spoilage-advice-settings")'>
                        <svg class="vd-nav-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span>Spoilage Advice Settings</span>
                    </button>
                </nav>
            </div>

            <!-- SIDEBAR FOOTER (USER & LOGOUT) -->
            <div class="vd-sidebar-bottom">
                <div class="vd-user-profile-row">
                    <div class="vd-avatar-circle">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                        </svg>
                    </div>
                    <div class="vd-user-info-text">
                        <div class="vd-user-name">@DisplayName</div>
                        <div class="vd-user-role">@(Auth.IsAdmin ? "Administrator" : "Vendor Manager")</div>
                    </div>
                </div>

                <button type="button" class="vd-logout-btn" @onclick="HandleLogout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </div>
        </aside>

        <!-- ===================================================================
             2. MAIN CONTENT AREA
             =================================================================== -->
        <main class="vd-main-canvas">

            <!-- TOP HEADER -->
            <header class="vd-top-header">
                <div class="vd-header-left">
                    <div>
                        <h1 class="vd-welcome-title">Spoilage Advice Settings</h1>
                        <p class="vd-welcome-subtitle">Configure the business rules used to evaluate historical spoilage, trends, and risk levels.</p>
                    </div>
                </div>

                <div class="vd-header-right">
                    <!-- TOP HEADER LOGOUT BUTTON -->
                    <button type="button" class="vd-header-pill vd-logout-header-pill" @onclick="HandleLogout" title="Logout">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Logout</span>
                    </button>
                </div>
            </header>

            <div class="vd-dashboard-body">

                <!-- SPOILAGE ADVICE SETTINGS VIEW ONLY -->
                <div class="vd-card p-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-3">
                        <div>
                            <h3 class="fw-bold mb-1 text-dark">Spoilage Advice Settings</h3>
                            <p class="text-muted small mb-0">Configure the business rules used to evaluate historical spoilage, trends, and risk levels.</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SettingsSuccessMessage))
                    {
                        <div class="alert alert-success py-2 px-3 mb-4 d-flex align-items-center" role="alert">
                            <span>@SettingsSuccessMessage</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(SettingsErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 mb-4 d-flex align-items-center" role="alert">
                            <span>@SettingsErrorMessage</span>
                        </div>
                    }

                    @if (IsLoadingSettings)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading settings...</span>
                            </div>
                            <p class="text-muted mt-2 small">Loading current configuration...</p>
                        </div>
                    }
                    else if (SpoilageSettings != null)
                    {
                        <div class="row g-4">
                            <!-- Delivery Sampling & Trend Calculation -->
                            <div class="col-12">
                                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">Sampling and Trend Parameters</h5>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Recent Deliveries Considered</label>
                                <input type="number" class="form-control" min="1" step="1" @bind="SpoilageSettings.RecentDeliveriesCount" />
                                <div class="form-text text-muted small">Number of recent deliveries used when calculating recent spoilage.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Trend Tolerance (%)</label>
                                <input type="number" class="form-control" min="0" step="0.1" @bind="SpoilageSettings.TrendTolerancePercentage" />
                                <div class="form-text text-muted small">Tolerance used to determine whether recent spoilage is meaningfully higher or lower than historical spoilage.</div>
                            </div>

                            <!-- Spoilage Risk Thresholds -->
                            <div class="col-12 mt-4">
                                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">Risk Classification Thresholds</h5>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">High Weighted Spoilage Threshold (%)</label>
                                <input type="number" class="form-control" min="0" step="0.1" @bind="SpoilageSettings.HighWeightedSpoilageThreshold" />
                                <div class="form-text text-muted small">Weighted spoilage percentage at which the product is considered high risk.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">High Recent Spoilage Threshold (%)</label>
                                <input type="number" class="form-control" min="0" step="0.1" @bind="SpoilageSettings.HighRecentSpoilageThreshold" />
                                <div class="form-text text-muted small">Recent spoilage percentage at which the product is considered high risk regardless of historical average.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">High Maximum Spoilage Threshold (%)</label>
                                <input type="number" class="form-control" min="0" step="0.1" @bind="SpoilageSettings.HighMaximumSpoilageThreshold" />
                                <div class="form-text text-muted small">Maximum single-delivery historical spoilage percentage that triggers high risk.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Medium Weighted Spoilage Threshold (%)</label>
                                <input type="number" class="form-control" min="0" step="0.1" @bind="SpoilageSettings.MediumWeightedSpoilageThreshold" />
                                <div class="form-text text-muted small">Weighted spoilage percentage threshold for medium risk classification.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Low Weighted Spoilage Threshold (%)</label>
                                <input type="number" class="form-control" min="0" step="0.1" @bind="SpoilageSettings.LowWeightedSpoilageThreshold" />
                                <div class="form-text text-muted small">Weighted spoilage percentage threshold below which products with stable or decreasing trends are classified as low risk.</div>
                            </div>

                            @if (SpoilageSettings.UpdatedAt.HasValue)
                            {
                                <div class="col-12 mt-2">
                                    <div class="text-muted small">Last updated: @SpoilageSettings.UpdatedAt.Value.ToLocalTime().ToString("g")</div>
                                </div>
                            }

                            <!-- Action Buttons -->
                            <div class="col-12 mt-4 pt-3 border-top d-flex gap-3 align-items-center">
                                <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="SaveSpoilageSettingsAsync" disabled="@IsSavingSettings">
                                    @if (IsSavingSettings)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>Save Settings</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-outline-secondary px-3" @onclick="ResetSpoilageSettingsToDefaults" disabled="@IsSavingSettings">
                                    Reset to Defaults
                                </button>
                            </div>
                        </div>
                    }
                </div>

            </div>

        </main>
    </div>
}
