@page "/purchase-request/{requestId:int}"
@page "/purchase-request"
@rendermode InteractiveServer
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Purchase Request Details - Smart Vendor Management System</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="container py-5">
        <div class="alert alert-warning text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Authentication Required</h4>
            <p class="text-muted mb-3">Please log in as a Purchase Manager to view this purchase request.</p>
            <button class="btn btn-primary fw-bold px-4" @onclick='() => Nav.NavigateTo("/login")'>Go to Login</button>
        </div>
    </div>
}
else if (!Auth.IsPurchaseManager && !Auth.IsAdmin)
{
    <div class="container py-5">
        <div class="alert alert-danger text-center py-4 my-5 shadow-sm rounded-3">
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-3">You do not have Purchase Manager privileges to access this page.</p>
            <button class="btn btn-outline-secondary fw-bold px-4" @onclick='() => Nav.NavigateTo("/")'>Return to Home</button>
        </div>
    </div>
}
else
{
    <div class="pm-app-layout @(IsSidebarCollapsed ? "sidebar-collapsed" : "")">

        <!-- =======================================================================
             LEFT SIDEBAR NAVIGATION (DARK GREEN #174F45)
             ======================================================================= -->
        <aside class="pm-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-branding" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                    <div class="brand-emblem">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">PROCUREMENT</span>
                        <span class="brand-sub">MANAGEMENT</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (IsSidebarCollapsed)
                        {
                            <polyline points="13 17 18 12 13 7"></polyline>
                            <polyline points="6 17 11 12 6 7"></polyline>
                        }
                        else
                        {
                            <polyline points="11 17 6 12 11 7"></polyline>
                            <polyline points="18 17 13 12 18 7"></polyline>
                        }
                    </svg>
                </button>
            </div>

            <nav class="sidebar-nav">
                <!-- MAIN -->
                <div class="nav-section-title">MAIN</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/purchase-manager")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </button>
                    </li>
                </ul>

                <!-- PROCUREMENT -->
                <div class="nav-section-title">PROCUREMENT</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link active" @onclick='() => Nav.NavigateTo("/procurement")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Requests</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/quotations")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Vendor Quotations</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </span>
                            <span class="nav-label">Purchase Orders</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/purchase-orders")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                </svg>
                            </span>
                            <span class="nav-label">Deliveries</span>
                        </button>
                    </li>
                </ul>

                <!-- FINANCE -->
                <div class="nav-section-title">FINANCE</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/invoices")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            <span class="nav-label">Invoices &amp; Billing</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="sidebar-nav-link" @onclick='() => Nav.NavigateTo("/organization/payments")'>
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                    <line x1="1" y1="10" x2="23" y2="10"></line>
                                </svg>
                            </span>
                            <span class="nav-label">Payments &amp; Settlements</span>
                        </button>
                    </li>
                </ul>


                <!-- ACCOUNT -->
                <div class="nav-section-account">
                    <div class="nav-section-title">ACCOUNT</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <button class="sidebar-nav-link" @onclick="OpenProfileModal">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </span>
                                <span class="nav-label">My Profile</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="sidebar-nav-link" @onclick="HandleLogout">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                </span>
                                <span class="nav-label">Logout</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- =======================================================================
             MAIN WRAPPER & TOPBAR
             ======================================================================= -->
        <div class="pm-main-wrapper">
            <!-- Topbar -->
            <header class="pm-topbar">
                <div class="topbar-left">
                    <button class="topbar-menu-toggle" @onclick="ToggleSidebar" title="Toggle Sidebar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <h1 class="topbar-title">Purchase Manager Portal</h1>
                </div>

                <div class="topbar-right">
                    <!-- Notifications -->
                    <div class="notification-wrapper">
                        <button class="notification-btn" @onclick="ToggleNotifications" title="Notifications">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            @if (UnreadNotificationCount > 0)
                            {
                                <span class="notification-badge">@UnreadNotificationCount</span>
                            }
                        </button>

                        @if (ShowNotificationDropdown)
                        {
                            <div class="notification-dropdown">
                                <div class="dropdown-header">
                                    <span>Notifications</span>
                                    <span class="badge bg-light text-dark">@UnreadNotificationCount unread</span>
                                </div>
                                <div class="dropdown-list">
                                    @if (Notifications.Count == 0)
                                    {
                                        <div class="p-3 text-center text-muted small">No notifications</div>
                                    }
                                    else
                                    {
                                        @foreach (var n in Notifications)
                                        {
                                            <div class="dropdown-item-notif @(!n.IsRead ? "unread" : "")" @onclick="() => MarkAsRead(n.NotificationID)">
                                                <div class="notif-text">@n.Message</div>
                                                <div class="notif-time">@n.CreatedDate.ToIst("dd MMM yyyy, hh:mm tt")</div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="profile-wrapper">
                        <button class="profile-pill-btn" @onclick="ToggleProfileDropdown">
                            <div class="profile-avatar">@UserInitial</div>
                            <div class="profile-info">
                                <span class="profile-name">@Auth.UserName</span>
                                <span class="profile-role">Purchase Manager</span>
                            </div>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>

                        @if (IsProfileDropdownOpen)
                        {
                            <div class="profile-dropdown-menu">
                                <button class="profile-menu-item" @onclick="OpenProfileModal">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <span>My Profile</span>
                                </button>
                                <button class="profile-menu-item logout" @onclick="HandleLogout">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    <span>Logout</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <main class="pm-page-container">

                <div class="mb-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold px-3 py-1.5" @onclick='() => Nav.NavigateTo("/procurement")'>
                        Back to Purchase Requests
                    </button>
                </div>

                @if (IsLoading)
                {
                    <div class="pm-panel p-5 text-center text-muted">
                        <div class="spinner-border text-success mb-2" role="status" style="width: 2.5rem; height: 2.5rem; color: #174F45 !important;"></div>
                        <p class="small fw-semibold">Loading purchase request details...</p>
                    </div>
                }
                else if (HasError || PurchaseRequest == null)
                {
                    <div class="pm-panel p-5 text-center my-4">
                        <h5 class="fw-bold text-danger mb-2">Purchase Request Not Found or Access Denied</h5>
                        <p class="text-muted small mb-3">@ErrorMessage</p>
                        <button class="btn-primary-action px-4 py-2" @onclick='() => Nav.NavigateTo("/procurement")'>
                            Return to Purchase Requests
                        </button>
                    </div>
                }
                else
                {
                    <!-- HEADER BANNER -->
                    <div class="pm-header-banner mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-3">
                                <h2 class="greeting-title">Purchase Request PR-@PurchaseRequest.RequestID</h2>
                                <span class="@GetStatusBadgeClass(PurchaseRequest.Status)">@PurchaseRequest.Status</span>
                            </div>
                            <p class="greeting-subtitle">View request status, item specifications, and vendor quotation tracking.</p>
                        </div>

                        <div class="outlet-badge-card">
                            <div class="outlet-badge-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </div>
                            <div class="outlet-badge-text">
                                <span class="outlet-name-label">@OutletName</span>
                                <span class="org-name-sub">@OrganizationName</span>
                            </div>
                        </div>
                    </div>

                    <!-- SUMMARY STATS CARD -->
                    <div class="pm-panel p-3 px-4 mb-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Request Reference</div>
                                <div class="ref-pill fs-6 mt-1">PR-@PurchaseRequest.RequestID</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Created On</div>
                                <div class="fw-bold text-dark fs-6 mt-1">@PurchaseRequest.RequestDate.ToIst("MMM dd, yyyy")</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Requested By</div>
                                <div class="fw-bold text-dark fs-6 mt-1">@CreatedByUserName</div>
                            </div>
                        </div>
                    </div>

                    <!-- TWO-COLUMN DETAILS GRID (Natural Height, No Stretched Blank Space) -->
                    <div class="row g-3 mb-3 align-items-start">
                        <!-- Left Column: Request Information -->
                        <div class="col-lg-6">
                            <div class="pm-panel p-3 px-4">
                                <h4 class="panel-title mb-2.5 pb-2 border-bottom">Request Information</h4>
                                
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex justify-content-between py-1.5 border-bottom">
                                        <span class="text-muted small fw-semibold">Destination Outlet</span>
                                        <span class="fw-bold text-dark small">@OutletName</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1.5 border-bottom">
                                        <span class="text-muted small fw-semibold">Organization</span>
                                        <span class="fw-bold text-dark small">@OrganizationName</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1.5 border-bottom">
                                        <span class="text-muted small fw-semibold">Location Address</span>
                                        <span class="text-dark small">@(string.IsNullOrWhiteSpace(OutletAddress) ? "Outlet Branch" : OutletAddress)</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1.5">
                                        <span class="text-muted small fw-semibold">Request Date</span>
                                        <span class="fw-bold text-dark small">@PurchaseRequest.RequestDate.ToIst("dd MMM yyyy, hh:mm tt")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Vendor & Quotation Status -->
                        <div class="col-lg-6">
                            <div class="pm-panel p-3 px-4">
                                <h4 class="panel-title mb-2.5 pb-2 border-bottom">Vendor &amp; Quotation Status</h4>

                                @if (AssociatedQuotation == null)
                                {
                                    <div class="p-3 rounded-2 mb-2 bg-light border">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="fw-bold text-dark small">Awaiting Vendor Quotation</span>
                                            <span class="status-badge-neutral">Pending Quotation</span>
                                        </div>
                                        <p class="small text-muted mb-0" style="font-size: 0.82rem; line-height: 1.45;">The request has been dispatched to candidate suppliers. Once a quotation is submitted, it will appear here for review.</p>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(VendorName))
                                    {
                                        <div class="d-flex justify-content-between py-1.5 border-top">
                                            <span class="text-muted small fw-semibold">Target Vendor</span>
                                            <span class="fw-bold text-dark small">@VendorName</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="review-summary-card p-3 mb-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="fw-bold text-dark small">Quotation Ref: QO-@AssociatedQuotation.QuotationID</span>
                                            <span class="@GetStatusBadgeClass(AssociatedQuotation.Status)">@AssociatedQuotation.Status</span>
                                        </div>
                                        <div class="small text-muted mb-2">
                                            Supplier: <strong class="text-dark">@VendorName</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                            <span class="small text-muted">Total Quoted Amount</span>
                                            <span class="fw-bold text-success fs-5">Rs. @GetQuotationTotal(AssociatedQuotation).ToString("N2")</span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end">
                                        <button type="button" class="btn-primary-action" @onclick='() => Nav.NavigateTo($"/quotation-review/{AssociatedQuotation.QuotationID}")'>
                                            Review Quotation
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- REQUESTED ITEMS BREAKDOWN -->
                    <div class="pm-panel mb-4">
                        <div class="panel-header py-2.5 px-4">
                            <div class="panel-title-wrap">
                                <h3 class="panel-title" style="font-size: 0.95rem;">Requested Items Breakdown</h3>
                                <p class="panel-subtitle">Items and quantities configured in this procurement request</p>
                            </div>
                        </div>

                        @if (PurchaseRequest.Items == null || PurchaseRequest.Items.Count == 0)
                        {
                            <div class="p-4 text-center text-muted small">No item breakdown available for this purchase request.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="pm-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 50%;">PRODUCT</th>
                                            <th class="text-center" style="width: 25%;">QUANTITY</th>
                                            <th class="text-end" style="width: 25%;">UNIT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in PurchaseRequest.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark">@GetProductName(item)</div>
                                                </td>
                                                <td class="text-center fw-bold text-dark">@item.Quantity.ToString("0.00")</td>
                                                <td class="text-end text-muted fw-semibold">@item.Unit</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }

            </main>
        </div>
    </div>

    <!-- =======================================================================
         MY PROFILE MODAL DIALOG
         ======================================================================= -->
    @if (ShowProfileModal)
    {
        <div class="pm-modal-backdrop" @onclick="CloseProfileModal">
            <div class="pm-modal-card" @onclick:stopPropagation="true">
                <div class="pm-modal-header">
                    <h5 class="pm-modal-title">My Profile &mdash; Purchase Manager</h5>
                    <button class="pm-modal-close-btn" @onclick="CloseProfileModal" title="Close">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="pm-modal-body">
                    <div class="profile-meta-row">
                        <span class="meta-label">Full Name</span>
                        <span class="meta-val">@Auth.UserName</span>
                    </div>
                    <div class="profile-meta-row">
                        <span class="meta-label">Email Address</span>
                        <span class="meta-val">@Auth.Email</span>
                    </div>
                    <div class="profile-meta-row">
                        <span class="meta-label">Assigned Role</span>
                        <span class="meta-val text-success">Purchase Manager</span>
                    </div>
                    <div class="profile-meta-row">
                        <span class="meta-label">Assigned Outlet</span>
                        <span class="meta-val">@OutletName</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(OutletAddress))
                    {
                        <div class="profile-meta-row">
                            <span class="meta-label">Outlet Address</span>
                            <span class="meta-val">@OutletAddress</span>
                        </div>
                    }
                    <div class="profile-meta-row">
                        <span class="meta-label">Organization</span>
                        <span class="meta-val">@OrganizationName</span>
                    </div>
                </div>
                <div class="pm-modal-footer">
                    <button class="btn-modal-close" @onclick="CloseProfileModal">Close</button>
                </div>
            </div>
        </div>
    }
}
